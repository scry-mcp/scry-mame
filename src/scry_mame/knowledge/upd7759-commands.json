    {
      "key": "0x00",
      "name": "end of sample",
      "access": "write",
      "aliases": [
        "silence 0"
      ],
      "description": "Header 0x00: ends the sample, or is a short silence before any data.",
      "behaviour": "In the block-header state, if a non-zero header was already seen since the address bytes, the chip goes idle. Otherwise it is a 1024-clock silence and another header follows. Either way the sample value and ADPCM step state reset to zero; no bytes follow.",
      "sources": [
        {
          "role": "emulator",
          "ref": "mame:src/devices/sound/upd7759.cpp upd775x_device::advance_state header 0x00",
          "cites": "\t\t\t\t\tm_state = (m_block_header == 0 && m_first_valid_header) ? STATE_IDLE : STATE_BLOCK_HEADER;"
        }
      ],
      "checked": {
        "by": "phase K4bc1",
        "writer": "phase K4b",
        "against": [
          {
            "ref": "mame:src/devices/sound/upd7759.cpp upd775x_device::advance_state header 0x00",
            "line": "\t\t\t\t\tm_state = (m_block_header == 0 && m_first_valid_header) ? STATE_IDLE : STATE_BLOCK_HEADER;"
          }
        ],
        "digest": "616660adf3d24efa45602a54d4a3714b19d46268ff0b6f375f4961177a3ce51f"
      }
    },
    {
      "key": "0x01..0x3F",
      "name": "silence",
      "access": "write",
      "aliases": [
        "pause"
      ],
      "description": "Header 00dddddd: a silence, then the next header.",
      "behaviour": "Lasts (value + 1) x 1024 chip clocks and resets the sample value and ADPCM step state to zero. No bytes follow.",
      "sources": [
