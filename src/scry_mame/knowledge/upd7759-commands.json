    {
      "key": "0x80..0xBF",
      "name": "play n nibbles",
      "access": "write",
      "aliases": [
        "counted block"
      ],
      "description": "Header 10ffffff: a count byte follows, then that many ADPCM nibbles.",
      "behaviour": "Bits 0 to 5 plus one are the rate, as for 0x40. The next byte N gives N+1 nibbles, so N/2+1 data bytes follow, high nibble first; an odd count ignores the last byte's low nibble. Then the next byte is a header.",
