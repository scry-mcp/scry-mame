    {
      "key": "0xC0..0xFF",
      "name": "repeat marker",
      "access": "write",
      "aliases": [
        "loop",
        "0xFF"
      ],
      "description": "Header 11---rrr: sets a repeat count; the next byte is a normal header.",
      "behaviour": "Count is (value & 7) + 1 and bits 3 to 5 are unused; 0xFF is this marker with count 8. Each later header while the count is non-zero decrements it and rewinds the ROM offset, which only matters in stand-alone mode, so a slave host resends the repeated bytes itself.",
      "sources": [
