          "role": "emulator",
          "ref": "mame:src/devices/sound/upd7759.cpp upd775x_device::advance_state silence length",
          "cites": "\t\t\t\t\tm_clocks_left = 1024 * ((m_block_header & 0x3f) + 1);"
        }
      ],
