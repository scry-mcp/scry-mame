  {
   "key": "0x05",
   "name": "key on/off + mode",
   "access": "write",
   "regions": [
    {
     "ref": "mame:src/devices/sound/c140.cpp",
     "lines": "503-516"
    },
    {
     "ref": "mame:src/devices/sound/c140.cpp",
