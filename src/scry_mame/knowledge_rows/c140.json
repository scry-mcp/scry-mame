    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "Register 5 of a voice is its mode byte, and a write keys the voice: bit 7 set, or bit 6 set while the voice is keyed, starts it.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/c140.cpp",
       "lines": "503-508",
       "sha": "99f71c13e6bc237578463be8a3c999a5418b723b92119e332e07cc5f79619c44"
      },
      {
       "ref": "mame:src/devices/sound/c140.cpp",
       "lines": "515",
       "sha": "4d6f6e51e39e6e4e94d4ce895ffa7e16db2e96072c2bede33e33553604742d49"
      }
     ]
    },
    {
     "n": "2",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "A key on zeroes the position, the interpolation history and the delta, and copies the bank and the mode from the registers.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/c140.cpp",
       "lines": "506-516",
       "sha": "f3cdbe4febfa1f3d10107a062eb69f85b76809eebfe764391e9cf38eb7a27648"
      }
     ]
    },
    {
     "n": "3",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "A write that does not key the voice on clears its key, and the mixer skips a voice whose key is clear.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/c140.cpp",
       "lines": "521-525",
       "sha": "e856ef0a9a0478e7cc4b9a825767ddf44fc75bbac32c1d3a0590923603544d55"
      },
      {
       "ref": "mame:src/devices/sound/c140.cpp",
       "lines": "237",
       "sha": "1bccb0a2d6351623950e2fc67076ef63a3570ed917d32f11159b06f2b81c4895"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "Mode bit 4 makes the voice loop when the sample reaches its end, and bit 3 selects the mu-law table the mixer reads.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/c140.h",
       "lines": "76",
       "sha": "050d65409ec012ae032c5f2749d8b3ac69d56ca20cb90c98ca0dc84c63d1bd9d"
      },
      {
       "ref": "mame:src/devices/sound/c140.cpp",
       "lines": "278-283",
       "sha": "c9cb6a5bb2b40d1376a701b2d0bec6ee2adb254a8c755cf3b718952ca123a19e"
      },
      {
       "ref": "mame:src/devices/sound/c140.h",
       "lines": "78",
       "sha": "f868096c4a5af827d6be0cd4aeb0af3dd7e7776969ac9fe743461f4eda37ce0c"
      },
      {
       "ref": "mame:src/devices/sound/c140.cpp",
       "lines": "296",
       "sha": "f08aae7cf73eb0f24e01e751d47a5713c2740ecb6c646873e707daf890cbcbf7"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The header names bit 6 of the mode byte as used, with its purpose unknown.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/c140.h",
       "lines": "79",
       "sha": "9ec6e627b46d91ea9eaa3961697389e417c58c6a9f531ccfab784f59c43f16c7"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write to register 5 stores the byte in the register file and then keys the voice on or off.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/c140.cpp",
       "lines": "495-498",
       "sha": "a85c4ec0794505071fc09c4bba8492bd6f2e4e2b59b1edf11ccf199c63663316"
      },
      {
       "ref": "mame:src/devices/sound/c140.cpp",
       "lines": "503",
       "sha": "cef22149511882c20b098f746cb57bc9bd043d5c726f6f0e2efe4513e5917238"
      }
     ]
    }
   ]
  },
