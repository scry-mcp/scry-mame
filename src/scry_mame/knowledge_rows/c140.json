       "lines": "121",
       "sha": "dbb85187a41e20f5b888ce2166cb40f3f03876ad147c7a3a6ac76a6791b7d0f9"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write to 0x1FA stores the byte, clears the interrupt line and, with 0x1FE's bit 0 set, schedules the timer.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/c140.cpp",
       "lines": "497",
       "sha": "fd433bba01d6065c984d5b0556d8300d7637a40e219fe760365ec659114322f8"
