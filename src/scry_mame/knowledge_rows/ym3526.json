   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The register map comments registers 20 to 35 as AM/VIB/EG-TYPE/KSR/MULTIPLE.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "210",
       "sha": "614ad675d1ed905d19ef35420c4b7e35d26a9d06818ca511b8961c2a80ab2092"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "MULTI controls the relationship between fundamental waves and harmonics.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "116",
       "sha": "be6c9b62a3db9142e56cf28b4fbb4334b1c9a5314186bd23598ac735ac9ae4c2"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "KSR is key scale of RATE.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "132",
       "sha": "3c498dbb7659c4f73dbfd2b6b42ca988f91a13122d22911302eedc7effa5c887"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "EG-TYPE switches between Non Percussive and Percussive Tone; 0 is for Percussive Tone, and the other value, whose digit the capture lost, for Non Percussive Tone.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "137",
       "sha": "2d6ff1bb9f17d8e4eb76e406129124ffdd286d20c6bd0310bbe7ac1e889e6757"
      },
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "117",
       "sha": "01cbd4f742f113e7d2a2507b525b2ce4fafd4ff9fbb2b94378f41fdd4cab54b2"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "VIB indicates the ON/OFF of vibrato.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "118",
       "sha": "f434d53763f042a991906d2a403b9cb965dadd7fa69fc6670e3265a72a01e0ee"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "AM indicates the ON/OFF of modulation.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "119",
       "sha": "9650e7bee8f97c6f00a09dc57ecf65e8c1015ca307d9956cda085e23870a9be8"
      }
     ]
    },
    {
     "n": "101",
     "on": "bits 0-3",
     "of": "mame",
     "vs": "extra",
     "text": "MAME maps the stored multiple 11 to 10, 13 to 12 and 14 to 15, and treats 0 as one half.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "307-312",
       "sha": "60029eaee4cd586eece4a158017d1d4adb0b78370644bdeaad3f4166ad079475"
      }
     ]
    }
   ],
