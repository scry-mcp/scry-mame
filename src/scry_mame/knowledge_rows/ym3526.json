   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The register map comments register 08 as CSM speech synthesis mode/Note Select.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "209",
       "sha": "f56567a152a14ae32dd2c205c12095cb76f4ea5fd75d1d8bd1d4aa2788a955ab"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Register 08 holds CSM, which is for the CSM speech synthesis mode.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "114",
       "sha": "c1e275368f342dcbdbd12970092631e7e1f644a7779b93cb6bf1a0368e848f6e"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "Register 08 holds NOTE SEL, which is for switching the keyboard split by using the F-Number.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "115",
       "sha": "ae642b8f9e9b1fec6440e30658e91e5401942004b41df0258a3f013493bd9b19"
      }
     ]
    },
    {
     "n": "101",
     "on": "bit 7",
     "of": "mame",
     "vs": "extra",
     "text": "When timer 1 expires with the CSM bit set, MAME keys on the channels selected by CSM_TRIGGER_MASK with the CSM key-on type.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_fm.ipp",
       "lines": "1515-1522",
       "sha": "208bfaf39cafa93ac22e86ec7ca692c50a6775bf6787abca54431e5ad5f90540"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.h",
       "lines": "132",
       "sha": "7d3afdd9979ee6e2ebe00477ae8455ff81ced52d0bd4f3f47f347cf330f8ca86"
      }
     ]
    },
    {
     "n": "102",
     "on": "bit 6",
     "of": "mame",
     "vs": "extra",
     "text": "MAME takes the key code's low bit from F-number bit 9 with NOTE SEL 0 and bit 8 with 1; a comment says this is reversed from the manual.",
     "quotes": [
