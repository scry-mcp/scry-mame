   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The register map shows registers A0 to A8 as a field labelled F Number (L).",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "196",
       "sha": "236a028198138eb63db792153ec6a5d8df05e4d096261c98e5deb8e30310c97e"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "F-Number provides chords within one octave (the document's wording).",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "123",
       "sha": "0d94535f95c350514bfebbf3a7d4d21ede115719c4127bcf53c2e93001226224"
      }
