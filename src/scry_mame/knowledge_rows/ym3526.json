    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "MAME's block_freq joins 5 bits of registers B0 to B8 to the 8 bits of this register; its comment lays it out as 3 block bits and 10 F-number bits.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.h",
       "lines": "225",
       "sha": "b4dd6ff34c4b2475aecf093f7d2da0e0533682c2c8ef9a1684ba42a4586dc5f0"
