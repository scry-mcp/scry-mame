   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The register map comments register BD as DEPTH (AM/VIB) and RHYTHM (BD, SD, TOM, TC, HH); the capture garbles the separators.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "215",
       "sha": "4ef81afbad706e166b6c55e9d4fbc44e1d1e3bf518b1e072594f4b6a06a1376d"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Register BD controls rhythmic sounds and has the corresponding bits for setting the ON/OFF of each rhythm.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "126",
       "sha": "1071f0c27101ab9e23164592be068a4194149c105a77e25595ebc23fb7e7500e"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "When the R bit is 1, the system is in the rhythm mode; the capture has a stray T before the sentence.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "127",
       "sha": "0d8dc1d28c0575b19e7df1f4a494306ee3935f92097df8b172432555bd6569ce"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "VIB DEP indicates the depth of vibrato.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "128",
       "sha": "e9beaaa5bdaddee97f16da787dc1815a9f125f90e433aaff300d752016114dcf"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "The capture reads the two vibrato depths as `0 = 74, 1 = 146`; the last glyph of each value is doubtful.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "128",
       "sha": "e9beaaa5bdaddee97f16da787dc1815a9f125f90e433aaff300d752016114dcf"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "AM DEP indicates the depth of amplitude modulation.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "129",
       "sha": "b4afe9092f8643d4893ed5cd063737c1a6b70c26e147cfd4705caf0734e1bb60"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "The two amplitude modulation depths are 0 = 1 dB and 1 = 4.8 dB.",
     "quotes": [
      {
       "ref": "datasheet:YM3526.raw.txt",
       "lines": "129",
       "sha": "b4afe9092f8643d4893ed5cd063737c1a6b70c26e147cfd4705caf0734e1bb60"
      }
     ]
    }
   ],
