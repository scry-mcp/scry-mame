   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The OPN is controlled by the data written into its register; a microprocessor need only send data to the register.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "153-154",
       "sha": "fbfc8081afa3a3fefaee0bf3a6b5c914868a2a4aba0ae91c5dcf8b2bdad1a263"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "CS, RD, WR and A0 control the bi-directional bus D0 through D7.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "114",
       "sha": "d79319331c05b3d32ad3855698320f1561e1e48f7db54e0ed66d9f668c7ea432"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "3",
     "on": "when",
     "of": "doc",
     "text": "With CS 0, RD 1, WR 0 and A0 0 the bus writes an address into the register of the OPN.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "115-116",
       "sha": "48e75591bb99f1f0fed72acca4f12ed37f644e6878d0917dd64e62c4bf5244d7"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "4",
     "on": "when",
     "of": "doc",
     "text": "With CS 0, RD 1, WR 0 and A0 1 the bus writes the register content into the OPN.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "115",
       "sha": "a0954360aa67ede5a2baf5ca9c5f39374d0595a1e147e2aa4f2e9a693e3f86fa"
      },
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "117",
       "sha": "08c7b39a69f88fb5317002a451aba51a89e8f161f18a6d36ba1186539bbb2f14"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "5",
     "on": "when",
     "of": "doc",
     "text": "With CS 0, RD 0, WR 1 and A0 0 the bus reads the OPN status.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "115",
       "sha": "a0954360aa67ede5a2baf5ca9c5f39374d0595a1e147e2aa4f2e9a693e3f86fa"
      },
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "118",
       "sha": "0d5613fd5727d4124d58ef1e322ce646b9f13b16f0b2d398ee8b323508214249"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "6",
     "on": "when",
     "of": "doc",
     "text": "With CS 0, RD 0, WR 1 and A0 1 the bus reads the content of the OPN register.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "115",
       "sha": "a0954360aa67ede5a2baf5ca9c5f39374d0595a1e147e2aa4f2e9a693e3f86fa"
      },
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "119",
       "sha": "22d7dab2fccc036d6b8e843ed27f26ee0af8d4ded465a780494e08c860e37fa3"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "7",
     "on": "when",
     "of": "doc",
     "text": "With CS 1, whatever the other signals, the D0 through D7 bus lines become high impedance.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "115",
       "sha": "a0954360aa67ede5a2baf5ca9c5f39374d0595a1e147e2aa4f2e9a693e3f86fa"
      },
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "120",
       "sha": "e9d00bf2d502f76df47221285fba416741f48163d7b8dbbcbd382477804a2025"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "8",
     "on": "when",
     "of": "doc",
     "text": "The readable register addresses are 00 through 0F, the capture reading OF and adding (16 bits).",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "121",
       "sha": "338d90ae18349cad18508dc7ef4d7980deaa56a8c001e71e4042353f1721bcc2"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "9",
     "on": "when",
     "of": "doc",
     "text": "The IRQ signal is an interrupt signal sent from the two timers.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "123",
       "sha": "f1134ebc1b7783b275e70232bc4474e2f6da00e7748037d9d44abf8143743014"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "10",
     "on": "when",
     "of": "doc",
     "text": "The interrupt signal can be masked by the program.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "123",
       "sha": "f1134ebc1b7783b275e70232bc4474e2f6da00e7748037d9d44abf8143743014"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "11",
     "on": "reset",
     "of": "doc",
     "text": "The IC signal resets the system at low level.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "125",
       "sha": "5ef8ae6997bc3e525789d342109f6bf9b85b490b31f85caf2272b84b6022a078"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "12",
     "on": "reset",
     "of": "doc",
     "text": "All the content of the register array becomes 0, the capture reading the 0 as O.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "125",
       "sha": "5ef8ae6997bc3e525789d342109f6bf9b85b490b31f85caf2272b84b6022a078"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "13",
     "on": "is",
     "of": "doc",
     "text": "The document lists a table headed READ DATA with address xx and the comment Status.",
     "quotes": [
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "357-359",
       "sha": "97cd53eda623ee325fbf0635eeb895c3dcd0690a0e85e1d216e0b04d410a9a87"
      },
      {
       "ref": "datasheet:YM2203.raw.txt",
       "lines": "393-394",
       "sha": "bee07f466716e7d59e128648c861a0bd41014612318d282dedd3c418d5e5cc44"
      }
     ],
     "variant": "ym2203"
    },
    {
     "n": "14",
     "on": "place",
     "of": "mame",
     "text": "MAME decodes offset bit 0 alone in read and in write: 0 is the status read and the address write, 1 the data port.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "769-780",
       "sha": "08e608d9a7dd31b8817683337703c01101a934a86778708ac86aec8c730d475e"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "838-847",
       "sha": "b1d0e5685bf81c028817f109de59e624d689cc0cfe38ff0abd9def43a2a7da9b"
      }
     ],
     "vs": "place"
    },
    {
     "n": "15",
     "on": "place",
     "of": "mame",
     "text": "MAME's device exposes the data port read as data_r and the two I/O ports as read and write callbacks.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/ymopn.h",
       "lines": "27-30",
       "sha": "64e217e8b990bc0e5e33fce83dd82fb0c220d1c131fa693694eec9681c875178"
      },
      {
       "ref": "mame:src/devices/sound/ymopn.h",
       "lines": "33",
       "sha": "de2578e2bedb1afb98d98ad835c0ccd681031952c40436b4779c4765a59285d4"
      }
     ],
     "vs": "place"
    },
    {
     "n": "16",
     "on": "when",
     "of": "mame",
     "text": "MAME's write has no chip select: its body dispatches on offset bit 0 alone.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "838-847",
       "sha": "b1d0e5685bf81c028817f109de59e624d689cc0cfe38ff0abd9def43a2a7da9b"
      }
     ],
     "vs": "absent",
     "row": "7"
    },
    {
     "n": "17",
     "on": "when",
     "of": "mame",
     "text": "MAME's read has no chip select: its body dispatches on offset bit 0 alone.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "769-780",
       "sha": "08e608d9a7dd31b8817683337703c01101a934a86778708ac86aec8c730d475e"
      }
     ],
     "vs": "absent",
     "row": "7"
    },
    {
     "n": "18",
     "on": "when",
     "of": "mame",
     "text": "MAME's status read sets bit 7 while the chip is busy, and a data write marks it busy for 32 times the prescale, in clocks.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "740-743",
       "sha": "90e21f5d4fda94b94111fa71ba2fb44b08945f3ab0f212d5cde9c9b328b17213"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "827",
       "sha": "3476cef96f992b7fd0cbdec52d89f3b388ce35d932edb8ddca8c9f0866112aa6"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.h",
       "lines": "129",
       "sha": "4ba19ce24d19ebe1bef6ff76fff72e0061a3eb57439093e025f4900ef42cb596"
      },
      {
       "ref": "mame:src/devices/sound/ymfm_mame.h",
       "lines": "108-109",
       "sha": "e277d03b5d7767f2730c79ed48dcd589c866bd0d2f2ef0ef0ea2d1bf3c7de562"
      },
      {
       "ref": "mame:src/devices/sound/ymfm_mame.h",
       "lines": "117",
       "sha": "15ed57e23d83c93464d6dd043c6b606208495506cb4abdb4bc7652cb1b50c1d7"
      }
     ],
     "vs": "extra"
    },
    {
     "n": "19",
     "on": "when",
     "of": "mame",
     "text": "MAME's data read returns the SSG register for an address below 0x10 and returns 0 for 0x10 and above.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "753-759",
       "sha": "1500f8257aaf713ed8ca1325c928a11d80a9aed1c421dfd879a1571aec79bca2"
      }
     ],
     "vs": "differs",
     "row": "8"
    },
    {
     "n": "20",
     "on": "reset",
     "of": "mame",
     "text": "A reset also clears the status bits, rewrites the mode register 0x27 with 0, resets each channel and operator, and resets the SSG counters and noise state.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_fm.ipp",
       "lines": "1222",
       "sha": "1dd3f2c2b00f43a3df713b30d0676c5e0f98418ce54b59c376c25ab19a707c55"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_fm.ipp",
       "lines": "1229",
       "sha": "be2cd6b1b3ffa50205b58a6d0d482df7a588c322b185b5ff1f5f1a87574431f6"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.h",
       "lines": "121",
       "sha": "c46a245e93c9f996970ef74b3703b66cdb577982b90facd2a4e1134b0dfbb51c"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_fm.ipp",
       "lines": "1232-1237",
       "sha": "d9bc7bef6745dd6c46e4fda90298878f98b54ba932da81dbde8e4b033d610633"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_ssg.cpp",
       "lines": "96-104",
       "sha": "cbf4d25cef4c1c067639979794ed19ce225fce850bfa756cafc99e3c873a5c98"
      }
     ],
     "vs": "extra"
    },
    {
     "n": "21",
     "on": "reset",
     "of": "mame",
     "text": "MAME resets the chip when its device is reset: device_reset only calls the chip's reset and reads no IC signal or level.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/ymfm_mame.h",
       "lines": "207-210",
       "sha": "3884813636ed903cd5fb1ddc0adc1ed8dd1bfdb6cdbae75681a938290849ce36"
      }
     ],
     "vs": "differs",
     "row": "11"
    }
   ],
