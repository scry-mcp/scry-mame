   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "!CS, !RD, !WR, A1 and A0 control the data passing on D0 to D7.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "98",
       "sha": "17b430a443dea64217ab9529c49ea61d1d88f9a4d244e96995647409cf64b1c9"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "2",
     "on": "when",
     "of": "doc",
     "text": "The !IRQ terminal outputs the interrupt signal.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "99",
       "sha": "48b75c69587fb8c0b6c85dabb613f5ac7f4344ea346bc9f7ec72138155e0f993"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The interrupt output is an open drain output.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "99",
       "sha": "48b75c69587fb8c0b6c85dabb613f5ac7f4344ea346bc9f7ec72138155e0f993"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "4",
     "on": "reset",
     "of": "doc",
     "text": "The !IC terminal initializes the operation of the OPNA.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "129",
       "sha": "04a7dc6c6b266dfcaa617601ca481369455cf31adc39f5b60bd0c1d7da4db7ca"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "5",
     "on": "when",
     "of": "doc",
     "text": "In addressing mode the data on the data bus specifies the address of the register.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "315-316",
       "sha": "d8bd9d275a535e85d67e0e7ccf2814d239c62d0ab84142410f97442ac0063783"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The specified address is maintained until addressing is done next.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "316",
       "sha": "9bc928d335df88e330fadbc04de7a3480f482e422619ccf1f05074d31daecc2b"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Addressing is needed only the first time, and not afterwards, when data of the same address is accessed continuously.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "316-318",
       "sha": "33e7994d4d677e6333e67916cde5d5e00844d1ee00e51f0e8a2a46c4a4a3d44f"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "8",
     "on": "when",
     "of": "doc",
     "text": "In data write mode, after addressing, the data on the data bus is written in the register.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "320-321",
       "sha": "de967c2729000d7fc034863589679ed8b2cafde96ed8e208039aa66406d6874b"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "9",
     "on": "is",
     "of": "doc",
     "text": "After addressing and after a data write, the waiting time prescribed for each sound source part must be set before moving to the next mode.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "322-326",
       "sha": "d10ea81f9b978c606616a21eee2bc8e6ce9aaff81704efc544eb2ef7297d73d6"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "10",
     "on": "when",
     "of": "doc",
     "text": "In status read mode the status information generated in the status register is output on the data bus.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "328-329",
       "sha": "5d86a1ef409458d0ce92841b50e1b3f06a566b5f15edc0fd0a1bd8d93d946da3"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "11",
     "on": "when",
     "of": "doc",
     "text": "In data read mode the data of the registers readable in the SSG and ADPCM sound source parts is output on the data bus.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "331-332",
       "sha": "6e5f3d2eb415c3fe1d56e93ec2c78839e07117ee4c3cef6833bc9c446c8f3779"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "12",
     "on": "when",
     "of": "doc",
     "text": "With CS 1 the data passing on D0 to D7 becomes high impedance.",
     "quotes": [
      {
       "ref": "datasheet:YM2608.raw.txt",
       "lines": "334",
       "sha": "13172eef75b44adb73cb5e3f85dc44d980290fd491c9a2e6e281b4d20c07eece"
      }
     ],
     "variant": "ym2608"
    },
    {
     "n": "13",
     "on": "place",
     "of": "mame",
     "text": "MAME decodes the low 2 bits of a read offset: 0 is status, 1 data, 2 extended status and 3 ADPCM-B data.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1125",
       "sha": "dfaced791378d18cced80e4393aea8621f31cf22e8a2e9964752f718def9356e"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1127-1128",
       "sha": "9fb3745d095b73b18914d7a35ff61f3ca11767a2ee46a5a8b38216bb52923a4b"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1131-1132",
       "sha": "62fdf06940aacad196b0c883ef16d99172fea1ddee7c351ec563cfb9a1553a59"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1135-1136",
       "sha": "6ce78292565ab89acd1ef0a62bb53c69fbb430721a4d1e1aa3c9a11313157c96"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1139-1140",
       "sha": "55df21c18eaa71953f12a1cfcac12166e611bba862f561fde64d7a6c5a155a3b"
      }
     ],
     "vs": "place"
    },
    {
     "n": "14",
     "on": "place",
     "of": "mame",
     "text": "MAME decodes the low 2 bits of a write offset: 0 is the address, 1 the data, 2 the upper address and 3 the upper data.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1268",
       "sha": "dfaced791378d18cced80e4393aea8621f31cf22e8a2e9964752f718def9356e"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1270-1271",
       "sha": "db2855c392fb7f1ca98b7363c49afb5bef5a4948507104be827609fd915baea6"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1274-1275",
       "sha": "701635475ecdcc83b6fc80ef09e88732d7802acd5a56673c0e814db0233a346c"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1278-1279",
       "sha": "89b95f9459eb1b83e295ae6dfeaa92d873ab998c90bf39e6302af4a36c2d5f85"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1282-1283",
       "sha": "3da86e536060740adbe57e171be620613732c14501979b2deeb32a7bb3059caf"
      }
     ],
     "vs": "place"
    },
    {
     "n": "15",
     "on": "when",
     "of": "mame",
     "text": "MAME's read has no chip select: its body dispatches on the low 2 bits of the offset alone.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1124-1135",
       "sha": "18e98efce5590cf06fc936cfa084fa95f5c4100ab69a7beac26dcc4eb4f54007"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1136-1143",
       "sha": "c9161ad9c4b6dd87d03e079ce2d844f8e8d27e3bab28ec0bdeae56fb3e6cceda"
      }
     ],
     "vs": "absent",
     "row": "12"
    },
    {
     "n": "16",
     "on": "when",
     "of": "mame",
     "text": "MAME's write has no chip select: its body dispatches on the low 2 bits of the offset alone.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1268-1279",
       "sha": "7cd8a5ebc5cf1c4fdd109b0658240cc15337049a23208e9b7480faeff1fd60b9"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1280-1285",
       "sha": "49b2e124062ed5a97498a0c01484a5e377ef5c5d782ed5ffb7fc03585a83306d"
      }
     ],
     "vs": "absent",
     "row": "12"
    },
    {
     "n": "17",
     "on": "when",
     "of": "mame",
     "text": "MAME ignores a data write made after an address written at the other bank's port.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1178-1179",
       "sha": "8f06a23ba4e126ea0b546678cdad7cdca7225599b1370839d08229aa31ac2c61"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1228-1229",
       "sha": "1cbd314098c9c71fd37be916556f1a63cc9f5591a0fed2815cde585306f107f9"
      }
     ],
     "vs": "differs",
     "row": "8"
    },
    {
     "n": "18",
     "on": "when",
     "of": "mame",
     "text": "A data read at address 0xFF returns 1; at any other address of 0x10 or above it returns 0.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1055-1066",
       "sha": "0575aecba5de4626e6442ddd41e9a2f97f0824069faf6b21348c74fdf84a3db7"
      }
     ],
     "vs": "extra"
    },
    {
     "n": "19",
     "on": "reset",
     "of": "mame",
     "text": "A reset also sets the six ADPCM-A start and end addresses for the embedded ROM sounds.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1001-1007",
       "sha": "a8d16efcab478255215195886783518130c45ec121dc1f88393be75fcb4b4658"
      }
     ],
     "vs": "extra"
    },
    {
     "n": "20",
     "on": "when",
     "of": "mame",
     "text": "MAME's status read returns only the timer A and timer B flags of the FM status, with bit 7 set while the chip is busy.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.cpp",
       "lines": "1042-1045",
       "sha": "1b449c41770ea57e4d0b05b0e4d4a3357e9a6f2c7a680a2994d30f6846468716"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opn.h",
       "lines": "129",
       "sha": "4ba19ce24d19ebe1bef6ff76fff72e0061a3eb57439093e025f4900ef42cb596"
