 "entries": [
  {
   "key": "0x00..0x7F",
   "name": "channel registers",
   "aliases": [
    "channel"
   ],
   "regions": [
    {
     "ref": "mame:src/devices/sound/x1_010.cpp",
     "function": "x1_010_device::write"
    },
    {
     "ref": "mame:src/devices/sound/x1_010.cpp",
     "function": "x1_010_device::read"
    },
    {
     "ref": "mame:src/devices/sound/x1_010.cpp",
     "function": "x1_010_device::sound_stream_update"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "A channel is 8 registers: R0 status, R1 volume or waveform number, R2 and R3 frequency or pitch, R4 start or envelope time, R5 end or envelope number.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "24-28",
       "sha": "5e20e13c0542bc28f695b8cc7344384b7ada0a4a0a6dc0ee7f5d611c1473b797"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "30-32",
       "sha": "a4eb3ffaeec1f1e338eda630c4edcbf6e31bf569603221291ebb576900898a70"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "34-37",
       "sha": "b11c41ad2198a22080aa337a4811076805bbbd82a62cf8901c604d81fa149135"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "39-43",
       "sha": "98cdd635dcd85624d8bc4c25e05e0538324aaed5ce12e4d34aca78da3417c949"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "44-45",
       "sha": "8f1bebc8d78e6ee7140d4ed5b5f24680b38d013290edd681474c7ed8464caea1"
      }
     ]
    },
    {
     "n": "2",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "The channel is the offset divided by 8 and the register is the offset modulo 8.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "172-173",
       "sha": "7ae4ce7e0b109d800585af7c4c06af75fa2b0e8c99934c21eaebe70100dc5b34"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write stores the byte at its offset in the register area.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "182",
       "sha": "0bb707478db606b88c6bb0bdc9d64eb7a750270096d84038c3bddd1460a78220"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write that sets bit 0 of R0 on a channel below 16 restarts that channel's sample and envelope offsets at 0.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "175-179",
       "sha": "306193eee859bf3bc4083f99af771a5bcf1bb9e14fd30d7686e38706de8e2a28"
      }
     ]
    },
    {
     "n": "5",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A read returns the byte stored at the offset.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "167",
       "sha": "1a19eb9aad5e2d824d38b4424663d655bc7da03b1689ce53e8d632906d76ee25"
      }
     ]
    },
    {
     "n": "6",
     "on": "bit 0",
     "of": "mame",
     "vs": "extra",
     "text": "R0 bit 0 is key on: a channel produces sound only while it is set.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "28",
       "sha": "188bd9424e2b31dec5a47a3a7c1b8036de7799e888bf0af783f4bbd9260f72d7"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "216",
       "sha": "5d06ad9e4436c16a40255968be49a9e24d4867eb6166a89bf8a69ac899ed0ec2"
      }
     ]
    },
    {
     "n": "7",
     "on": "bit 1",
     "of": "mame",
     "vs": "extra",
     "text": "R0 bit 1 selects the sound source: 0 plays PCM from ROM and 1 plays a waveform from RAM.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "27",
       "sha": "69ed93d83f5c9cadd59cfd84f85af40bfb19b775f49fa4c55f4e155d7e94d0ba"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "219",
       "sha": "90bf7e75e3982884d07423c63818f878d9a8db9e8de075aa4b3a28f9c3f3bfce"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "252-253",
       "sha": "6ef1249b77ce10ba24c041bd81f467aefa23170aaf1995ec68284854b095389a"
      }
     ]
    },
    {
     "n": "8",
     "on": "bit 2",
     "of": "mame",
     "vs": "extra",
     "text": "R0 bit 2 is the waveform repeat flag, 0 repeating and 1 playing once; with 1 the channel keys off when the envelope position passes 128.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "26",
       "sha": "6ae345986af06996fd03887ebd5b8fe785201c9f824d511f163977b1188f6a36"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "270",
       "sha": "c6ad83d0e43de4f59bb4a35750a8e19a667312819705e273c55e6d52a03fa2eb"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "272-275",
       "sha": "1fef60dd1b8fd78597433d4b6ea660fbfc44ea1ff438586b15eb15265089f204"
      }
     ]
    },
    {
     "n": "9",
     "on": "bit 7",
     "of": "mame",
     "vs": "extra",
     "text": "R0 bit 7 is the frequency divider flag: when set the frequency value is shifted right by one.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "24",
       "sha": "d3ff1c7622e5b1ddf2450988e017d3142459e8c669d33961f5c9b9304b3a17e0"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "218",
       "sha": "eb65f86eb689155e78658d88e348ed54ab8a4375b664fb2d0c101fe34ad08128"
      }
     ]
    },
    {
     "n": "10",
     "on": "bits 4-7",
     "of": "mame",
     "vs": "extra",
     "text": "In PCM mode the high nibble of R1 is the left volume and its low nibble the right volume, each scaled by a volume base.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "30-31",
       "sha": "a4d6bbd89d15186f2a71fc7b96a627bf46e0a613a398b9aed31a5382f262ef79"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "223-224",
       "sha": "28cd546baede9a7508865767dd3c8859b159c0a4f01568729bf31f4d09df49ae"
      }
     ]
    },
    {
     "n": "11",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "In PCM mode a frequency of 0 is played as 4, a workaround for Meta Fox.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "227-229",
       "sha": "54f16f203e21296a7614abc950217c5f11268d18db912aa55f5b46acc23b1e47"
      }
     ]
    },
    {
     "n": "12",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "In PCM mode the sample starts at R4 times 0x1000 and ends at 0x100 minus R5, times 0x1000, in the ROM.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "39",
       "sha": "38996fb97d402a52a186064f419b349e4dc1c19c243989cbd90ff1da74fbf84e"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "42",
       "sha": "f7c7a9d89595c710c0df91ff2cd8366e63d8d92ab17beb49e2090a1503faa9de"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "221-222",
       "sha": "194976977c0e14e6aeb58a97eab085df6b843da994b05d784581d825abb046b4"
      }
     ]
    },
    {
     "n": "13",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "PCM playback keys the channel off, clearing bit 0 of R0, when the read position reaches the end address.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "239-244",
       "sha": "a6de8f7c4866576d62303917566b71da758a9a2d11565874a3cd615c65da28a9"
      }
     ]
    },
    {
     "n": "14",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "PCM data are signed bytes read from the ROM and added to the left and right outputs, scaled by their volumes.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "245-247",
       "sha": "03d4ab591fce4c74fa3f3e224a35e0d26bfc6274e4961e5b572810012f515060"
      }
     ]
    },
    {
     "n": "15",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "In waveform mode R1 is the waveform number: the waveform starts at 0x1000 plus 128 times R1 in the register area.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "32",
       "sha": "3a9cc59404cc34b2ec2153324afba70c85bda4ad78720d2827706eca56df0c2f"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "254",
       "sha": "f413243b0ec90bb3144bd2bcec740d7b740b0ec03d77ce55f2e67af8a1ad119a"
      }
     ]
    },
    {
     "n": "16",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "In waveform mode R3 and R2 form a 16-bit pitch, shifted right by the divider, added to the position each sample.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "37",
       "sha": "2a9766a9152530fe25093ad9e289e346155939e94c4faf9467868871746a99ab"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "256-257",
       "sha": "25d843bf6a6b347b319862f05d9ad98584e0ad21bde1f404a164ab66c7cbc391"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "283",
       "sha": "5f7089c8f365c92d2a8b92c329496883165e2f64a19bf850cb9e7439dd3bce88"
      }
     ]
    },
    {
     "n": "17",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "In waveform mode R4 is the envelope time, added to the envelope position each sample, and R5 the envelope number, 128 bytes each.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "40",
       "sha": "0af6613c939ba927d61480156f653a2690228d5cd1231f2e73e5b43a717534ba"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "43",
       "sha": "5c76c1dc4b5821a621f3e825a6fa24e6e407ce42e83576dedc6f306768e607db"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "259-261",
       "sha": "7535895938819b36a0cb6734f2ee5068ed46f6bb01897ea517ff9c477c3f04ae"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "284",
       "sha": "9d72e14e2efcb28a129eee826f1f5e57ad4d19c4d316931ccf7f2a76cfee624d"
      }
     ]
    }
   ],
