      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write stores the byte at the register's offset in the register area.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "182",
       "sha": "0bb707478db606b88c6bb0bdc9d64eb7a750270096d84038c3bddd1460a78220"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write to register 0 that turns bit 0 from 0 to 1 restarts the channel's sample and envelope positions at 0.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "174-179",
       "sha": "306193eee859bf3bc4083f99af771a5bcf1bb9e14fd30d7686e38706de8e2a28"
      }
     ]
    },
    {
     "n": "4",
     "on": "bit 0",
     "of": "mame",
     "vs": "extra",
     "text": "Bit 0 is the key: the stream's playback for a channel runs under a test of bit 0 of its status.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "216-217",
       "sha": "23ec8d5997f552c8dffc0abe037ab4c98d9702789fbbe1cd2bfb91a621f1b7a6"
      }
     ]
    },
    {
     "n": "5",
     "on": "bit 1",
     "of": "mame",
     "vs": "extra",
     "text": "Bit 1 selects the source: cleared, the channel plays PCM from the sample ROM; set, it plays a waveform.",
