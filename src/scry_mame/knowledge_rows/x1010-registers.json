{
 "format": "scry-knowledge/2",
 "dictionary": "x1010-registers",
 "kind": "register",
 "scope": "x1010",
 "covers": "the registers and memory areas of the Seta X1-010 as MAME's source defines them; no official document was found",
 "source": "emulator",
 "searched": [
  {
   "where": "mame-header",
