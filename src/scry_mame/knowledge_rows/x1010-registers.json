    {
     "n": "1",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "Offsets 0x80 to 0xFFF hold envelope data: 128-byte envelopes, each byte a left volume in its high nibble and a right volume in its low nibble.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "48",
       "sha": "8cf4482d936af93a7e2631a75f23582f95198b4c015b42fd23e14975b9c5a48d"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "277-279",
       "sha": "81aac4b02bf5a40dbd6470440a72b469b4e888e78141699ae7c32738725ac456"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A waveform voice reads its volume from the envelope byte at 128 times R5 plus the envelope position's bits 10 to 16.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "259",
       "sha": "1a7e41bc077a2e438b565b367035896b944555471ab0b6791e2c1a5b56a2c09b"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "270",
       "sha": "c6ad83d0e43de4f59bb4a35750a8e19a667312819705e273c55e6d52a03fa2eb"
      },
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
       "lines": "277",
       "sha": "1cf89e8534b09c1d6777b49e8e3fa8099e4195838893b19f88e617a2d73ee570"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "Envelope bytes are written like any other register byte, by a write at their offset.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/x1_010.cpp",
