      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "During an interrupt acknowledge cycle, /RD gates the interrupt vector onto the bus if the Z85X30 is the highest priority device requesting one.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "981-983",
