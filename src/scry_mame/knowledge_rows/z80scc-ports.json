    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "1504-1507"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "function": "z80scc_device::db_r"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "A//B selects the channel in which the read or write operation occurs.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "988-989",
       "sha": "6bbec305556bf5ead4a8f8252ccff35c7d85afbd34358b646d0cbac4ff98d34b"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "A read is performed in the channel that A//B selects.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "988-989",
       "sha": "6bbec305556bf5ead4a8f8252ccff35c7d85afbd34358b646d0cbac4ff98d34b"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "mame",
     "text": "db_r ignores the offset and always reads channel B's data register.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80scc.cpp",
       "lines": "2450",
       "sha": "a87256e0887b1202739891715b3ea7275e070e82dcd3b463fd4a215d7f15033b"
      }
     ],
     "vs": "differs",
     "row": "2"
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "If the state of the pointer bits is unknown, a read cycle with the D//C pin held Low resets them to 0.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1504-1507",
       "sha": "5017b1511f412b6899925e83f7c1a89e00d1d4d3a86a965cd045be70ebf05f49"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "2450",
     "as": "structure"
    }
   ]
  },
  {
   "key": "0x103",
