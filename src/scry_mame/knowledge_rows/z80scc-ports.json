   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "AD7-AD0 are multiplexed lines that carry register addresses as well as data or control information.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "996-999",
       "sha": "5fdea35f278ae40bebbc85870de9fd1e2b4017b074b8e8551b17523e222b71b7"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A write cycle on the multiplexed bus sends a register address and the data or control byte to the Z80X30.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "996-999",
       "sha": "5fdea35f278ae40bebbc85870de9fd1e2b4017b074b8e8551b17523e222b71b7"
      }
     ]
    },
    {
     "n": "3",
     "on": "place",
     "of": "mame",
     "text": "zbus_w sends registers 2 and 9 to both channels and any other register to the channel the offset selects.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80scc.cpp",
       "lines": "882-888",
       "sha": "8c627d1482316f7962a2a8141529fddacc5b277647f8789f80c2ed4d02d9f658"
      },
      {
