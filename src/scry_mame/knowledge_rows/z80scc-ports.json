   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "/CE is the chip enable input, active Low: it selects the Z85X30 for a read or write operation.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "977-978",
       "sha": "788a7ba6f78f00b440a13aa71631239f64efab9a74d298420dec79ed1aea1729"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "Registers are accessed in two steps: the pointer bits are set by writing WR0, then the next read or write with D//C low reaches the desired register.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1476-1482",
       "sha": "00a824a113416ae51a68c784214336d7ea4e1e6d2cf5631047661471b7185a88"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "A read cycle with the pointer bits set returns the register the pointer selects.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1478-1482",
       "sha": "7a06a8f271ebd9271fea737c4b464b61090de0f079b506bba269c75ec8bd042f"
      }
     ]
    }
