   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "A//B low selects channel B.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "990",
       "sha": "fcdd4da0dd0838b4d02f6345a74bf7c2d138763083309124652ead925195a0f9"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A low on A//B sends the write operation to channel B.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "990",
       "sha": "fcdd4da0dd0838b4d02f6345a74bf7c2d138763083309124652ead925195a0f9"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "mame",
     "text": "db_w ignores the offset and always writes channel B's data register.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80scc.cpp",
       "lines": "2451",
       "sha": "06b3b1dc951ae095da2401ddb04d9a6ef64093bd01c3ced1522bee4ad66810ac"
      }
     ],
     "vs": "differs",
     "row": "2"
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "During the actual read or write of the register, A//B selects the desired channel.",
     "quotes": [
