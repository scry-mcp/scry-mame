   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "/INTACK is the interrupt acknowledge input, active Low; it strobes an interrupt acknowledge cycle.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "965-966",
       "sha": "f94d115af035bdbb267d93fee90b31b4b5427c7852386c6482b5f66586cc47a7"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "During the acknowledge cycle the interrupt daisy chain is resolved, and the SCC can return an interrupt vector encoded with the type of interrupt pending.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "967-970",
       "sha": "f92d991852311ff8740b76ec515b2b32e6b9ada68e89e8e040d037b7fda81049"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "During the acknowledge cycle, if IEI is high, the SCC places the interrupt vector on the data bus when /RD goes active.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "970-973",
       "sha": "8dfa4de8be4cf2f7e364cadea49bbede990d1cee3b90e2d54804c779bd15e4b5"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "mame",
     "text": "m1_r returns z80daisy_irq_ack(): channel B's RR2 vector for a pending interrupt unless WR9 D1 selects autovector, and the CPU's default vector otherwise.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80scc.cpp",
       "lines": "825",
       "sha": "15fac39ed452015c78f82c6c03279592729add9bd2e0df1c08484b6b9581d239"
      },
