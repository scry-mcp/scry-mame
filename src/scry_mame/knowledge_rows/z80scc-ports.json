   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "At the conclusion of the read or write cycle the pointer bits are reset to 0s, so the next control write is to the pointers in WR0.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1483-1485",
       "sha": "b0b39292d22a5d79b2b3b0e2fab503b17d799d5ea722bf1123be77ad2ee8dadf"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "Because the pointer bits reset to 0, WR0 and RR0 may also be accessed in a single cycle.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1493-1496",
       "sha": "db566de4ce56ffa521056c74dc4d5bd3019649e9a3f5578df64a651e45e6ab58"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "A control write may reach WR0 in a single cycle, because the pointer bits are reset to 0 unless explicitly set otherwise.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1493-1496",
       "sha": "db566de4ce56ffa521056c74dc4d5bd3019649e9a3f5578df64a651e45e6ab58"
