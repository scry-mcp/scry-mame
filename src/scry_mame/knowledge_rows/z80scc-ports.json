  {
   "key": "0x102",
   "access": "read",
   "name": "data A read",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "975-976"
    },
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "1486-1488"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "function": "z80scc_device::da_r"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "D7-D0 is the bidirectional data bus: it carries data and commands to and from the Z85X30.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "975-976",
       "sha": "2bb7cdbf8a586601cdfc6ed2142c0ff8316342d2df6a7266c4eb75d4fff9237e"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "A read brings data or commands from the Z85X30 on the data bus D7-D0.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "975-976",
       "sha": "2bb7cdbf8a586601cdfc6ed2142c0ff8316342d2df6a7266c4eb75d4fff9237e"
      }
     ]
    },
    {
     "n": "3",
     "on": "place",
     "of": "mame",
     "text": "da_r ignores the offset and always reads channel A's data register.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80scc.cpp",
       "lines": "2448",
       "sha": "68579b714030d904826fb84ecdb64f8c02e9856416daf094b12cc34226a7140c"
      }
     ],
     "vs": "place"
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "RR8, the receive data FIFO, is read through the pointer or directly with D//C high.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1486-1488",
       "sha": "6417fa7893275fcf80a2a31f771c08b76d01fe12a184e49aa68463d61862aa25"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "2448",
     "as": "unfollowed",
     "row": "2"
    }
   ]
  },
  {
   "key": "0x102",
   "access": "write",
   "name": "data A write",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "991-994"
    },
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "1489-1492"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "function": "z80scc_device::da_w"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "D//C defines the type of information transferred: High means data.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "991-993",
       "sha": "d0accac6004f7448001afeb8d123857df24e3c97b767a1bd8f8f8471ba755db8"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "With D//C high during a write, data is transferred to the Z85X30 with command bytes at Low.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "991-994",
       "sha": "9c7d2c9054ddd28cea5971574d79144b64a28a720ec9e52b1eb8b919d06e06e3"
      }
     ]
    },
    {
     "n": "3",
     "on": "place",
     "of": "mame",
     "text": "da_w ignores the offset and always writes channel A's data register.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80scc.cpp",
       "lines": "2449",
       "sha": "0bdba18b31f01600c10fed7ceaebb6f71fd6ac55a8efd9d10516780b08ae85fe"
      }
     ],
     "vs": "place"
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "A write with D//C high reaches the data registers directly, independently of the pointer bits, allowing single-cycle access without disturbing them.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1489-1492",
       "sha": "9e98dc0752eff8e5835937eacd17f0db3f66ba12e960b656f2dcc88768e004e9"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "2449",
     "as": "unfollowed",
     "row": "2"
    }
   ]
  },
  {
