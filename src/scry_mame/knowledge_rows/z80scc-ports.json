   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "A command may be written to WR0 at the same time as the pointer bits.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1499-1500",
       "sha": "a1a9d73c08ec615d09a26841d91b7846471af355a62167cce37ddfdc181648ed"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "To access registers 15 through 8 the Point High command must accompany the pointer bits, which precludes issuing a command at the same time.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1500-1503",
       "sha": "63a0ebad1c8fbe16fa6d65e5e66e08bec36cd9ef875694f9a026f031152f8e98"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "A command may be written together with the pointer bits, except when Point High addresses registers 15 through 8.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "1499-1503",
       "sha": "5c02f003387cde84146b57663506bb8e0cb78776179e22ffe700cbaf748091ce"
