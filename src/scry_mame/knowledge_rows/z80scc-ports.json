    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The CPU wants to write command bytes or data to the Z85X30 write registers.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "986-987",
       "sha": "3909c2542c66724df8dfcd6558c284e5dacc4ffae4e60750d3287dcae185c96f"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The write cycle carries the command bytes or data to the Z85X30 write registers.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "986-987",
       "sha": "3909c2542c66724df8dfcd6558c284e5dacc4ffae4e60750d3287dcae185c96f"
      }
     ]
    },
    {
     "n": "3",
     "on": "place",
