    },
    {
     "ref": "mame:src/devices/machine/i8251.cpp",
     "function": "i8251_device::update_syndet"
    },
    {
     "ref": "mame:src/devices/machine/i8251.cpp",
     "function": "i8251_device::receive_character"
    },
    {
     "ref": "mame:src/devices/machine/i8251.cpp",
     "function": "i8251_device::txrdy_r"
    },
    {
     "ref": "mame:src/devices/machine/i8251.cpp",
     "function": "i8251_device::write_dsr"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The programmer can read the status of the device at any time, to learn of errors or conditions that need the processor.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "919-925",
       "sha": "0771f9997e73c83c5c987c7f735a99a40d929a7636bbeee745284fee8258b574"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "With C/D 1, RD low, WR high and CS low, a read puts the status on the data bus.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "217",
       "sha": "94226892a187e39af4d13a63e8d4bbcd0acaaaaffc64a091ebd60aeab3190c06"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "Status update is inhibited during a status read.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "926-927",
       "sha": "881e5a9e90d5895d99bcc848438ec74f99944ce62b89c89da94b2f913f9989cd"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "doc",
     "text": "A normal read command with C/D = 1 does the status read.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "930-931",
       "sha": "8786aeeac0ec9c9be0f333dfdffbb37e3a00b5cf0ce94c63169261d959bcd80a"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "Some status bits have the same meaning as external output pins, so the 8251A can be used completely polled or interrupt driven; TxRDY is an exception.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "932-936",
       "sha": "af687ce740d0fae2fb6ad4239553995a066fc3bdff6e44245752a63a11894edc"
      }
     ]
    },
    {
     "n": "6",
     "on": "bit 4",
     "of": "doc",
     "text": "The OE flag is set when the CPU does not read a character before the next one becomes available.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "953-956",
       "sha": "5c95ef5670b3ae351a0dbfbb5312b869cc24bab146c69d7d70aeaed5be98c847"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "The ER bit of the command instruction resets the OE flag.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "957-958",
       "sha": "debefa30bd8cdc799ddc21edddfeaa01308f97761b5aa0a12a9b0024a171a002"
      }
     ]
    },
    {
     "n": "8",
     "on": "bit 4",
     "of": "doc",
     "text": "OE does not inhibit operation of the 8251A, but the previously overrun character is lost.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "958-961",
       "sha": "f0a59a0389d40f7a07168735f50c545fcafdaba63e44458a7802da9b8c1f9ac4"
      }
     ]
    },
    {
     "n": "9",
     "on": "bit 7",
     "of": "doc",
     "text": "The DSR status bit indicates that the DSR input is at a zero level.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "969-970",
       "sha": "34ad5dae95843a833e8f878876d285e69daa5b6baa31331ead6540cd0cb8b53e"
      }
     ]
    },
    {
     "n": "10",
     "on": "bit 0",
     "of": "doc",
     "text": "The TxRDY status bit is not conditioned by CTS and TxEN, unlike the TxRDY pin: the status bit is DB buffer empty.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "973-977",
       "sha": "3d236afabec547f796f0d4639ba60860dc3a14a35242c13047d4742d1d3cd55b"
      }
     ]
    },
    {
     "n": "111",
     "on": "read",
     "of": "mame",
     "vs": "differs",
     "row": "3",
     "text": "The status read does not hold off updates: it clears SYNDET through update_syndet(false) at src/devices/machine/i8251.cpp:774 and logs the status at 771.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "768-777",
       "sha": "361fc78b0ce13645c0ddf2deb6345601fd150ff5914595ab519b4510a33bc371"
      }
     ]
    },
    {
     "n": "112",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "Updating SYNDET sets bit 6 (0x40) of the status when true and clears it when false; a status read clears it after capturing the status.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "487-490",
       "sha": "939871c9d263972b68e5e9c7706fe2f19b76e0f9614afe2e501d6da6d80492be"
      },
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "774",
       "sha": "a78446f46f4fe9b9ea11ba9ac6d5d97d687852c01c408a3ff805da8263767511"
      }
     ]
    },
    {
     "n": "113",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "With the receiver enabled in asynchronous mode, a completed character with a parity error sets PE (0x08), and one with a framing error FE (0x20), in the status.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "174",
       "sha": "6de27c6cb005417b537a8de7e867444629fc42aa5c78495b3241fc1e76e79558"
      },
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "191-197",
       "sha": "dfec84f97eec8a9d2d649c8e5fb4f3913da1f2334125f73cb86e0edcbc3dccc4"
      },
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "900-905",
       "sha": "ade7883e29779bbbdde64ab98215d8e83bb9200775110e8ccf9bd626e4845226"
      }
     ]
    },
    {
     "n": "114",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "In synchronous receive with parity enabled, the parity bit sets PE when the data ones, that bit and mode-byte bit 5 total an even count.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "217-222",
       "sha": "505bbf514c72e5e65ec348e0e242abd11ab0640d9f5ff3dc0940fa626d4a5be5"
      },
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "290-295",
       "sha": "505bbf514c72e5e65ec348e0e242abd11ab0640d9f5ff3dc0940fa626d4a5be5"
      },
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "900-903",
       "sha": "063659420ce23182a5c2f8e9474bd89c43ce31455f5d61099de887f9dd70c268"
      }
     ]
    },
    {
     "n": "115",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "When the transmit register is found empty and no transmission is started, the TxEMPTY bit (0x04) of the status is set.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "395-402",
       "sha": "194ce16e55eb60e39be0d01119701936bfdcb712f6a38163acd3774a8686a7c5"
      }
     ]
    }
   ],
