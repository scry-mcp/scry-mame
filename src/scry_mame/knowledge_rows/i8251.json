  {
   "key": "0x00",
   "name": "transmit data",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:8251A.raw.txt",
     "lines": "216"
    },
    {
     "ref": "datasheet:8251A.raw.txt",
     "lines": "505-510"
    },
    {
     "ref": "mame:src/devices/machine/i8251.cpp",
