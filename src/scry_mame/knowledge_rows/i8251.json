     "value": "offset=0"
    },
    {
     "ref": "mame:src/devices/machine/i8251.cpp",
     "function": "i8251_device::data_w"
    },
    {
     "ref": "mame:src/devices/machine/i8251.cpp",
     "function": "i8251_device::check_for_tx_start"
    },
    {
     "ref": "mame:src/devices/machine/i8251.cpp",
     "function": "i8251_device::start_tx"
    },
    {
     "ref": "mame:src/devices/machine/i8251.cpp",
     "function": "i8251_device::is_tx_enabled"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Once programmed, the 8251A is ready to work; its TxRDY output is raised high to tell the CPU it can take a data character.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "505-508",
       "sha": "7ea6118e2409ee54564bbc60784a61ec092e16e3d4b1706b7b17b2af4aaf347c"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "With C/D 0, RD high, WR low and CS low, a write puts the data bus into the 8251A data register.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "216",
       "sha": "f0eaf883fb950cc8f2c930c438289b7c0c9aadf1d51233b05813d72dd519fd73"
      }
     ]
    },
    {
     "n": "3",
     "on": "when",
     "of": "doc",
     "text": "TxRDY is reset automatically when the CPU writes a character into the 8251A.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "508-510",
       "sha": "62bd4e1cd85aab42b4b1b519e12785690b6973e34e5f0a15d73b1c6f48845610"
      }
     ]
    },
    {
     "n": "104",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write records the transmit enable state; when enabled, empty and not TX_READY, it loads the transmit register, clears the empty flag and sets TX_READY.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "797-798",
       "sha": "19d553b713568711fe79f595ffca1364b82ce6f74a62a4758bc31c2d41183aa3"
      },
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "357",
       "sha": "0877d5fc6c365ab6c72461dc539b4d07068dd029c262e81f986c0d4bcbf488be"
      },
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "367-368",
       "sha": "3d23fb1ba34e6279b186e75d10c2edc3dd778c407e1234c38ee8041e21f2b776"
      },
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "379-381",
       "sha": "deddfb65b6ef3fda179e886a1dda460068f39d77040511dc6cff42330c7f2ff7"
      }
     ]
    },
    {
     "n": "105",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "A change of the CTS input stores its level; once the device has started it then rechecks the transmit start and updates the TxRDY and TxEMPTY outputs.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/i8251.cpp",
       "lines": "877-887",
       "sha": "f4d61e929e816e1033917d01bf62e2facdee899df4f66bac65a1fe3aadfff500"
      }
     ]
    }
   ],
   "closed": [
