   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The command, status, data-in and data-out registers are separate 8-bit registers that reach the system bus through the data bus buffer.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "152-154",
       "sha": "a88a6d7fa3a53e876fc42842dfdd3648e1392d53a95ae9f95917f7b4bec3fe9d"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The data bus buffer carries control words, command words and status information, and transmits or receives data on the CPU input and output instructions.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "145-151",
       "sha": "3bc0f26976389c0ea06a065a51ed7acc33c6bf81aec2a9a92f4f3c762af7666a"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The C/D input tells the 8251A whether the word on the data bus is a data character, a control word or status: 1 is control/status, 0 is data.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "221-226",
       "sha": "8c4209acf02f114d039637b225f05e6b0072b11044240e34d02e08f982e30a81"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "doc",
     "text": "With C/D 0, RD low, WR high and CS low, a read puts the 8251A data on the data bus.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "215",
       "sha": "4f161342f7d1c88b06e426d85e617f0ea6861dab14bc3e8aabb58086ef5cfd5f"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "On receiving a whole character the 8251A raises RxRDY to tell the CPU a complete character is ready to fetch.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "511-515",
       "sha": "bff7e40cc6f56bc48b54cdb95e73967ca47564d938875c29ee0b0eaa8d0ef203"
      }
     ]
    },
    {
     "n": "6",
     "on": "when",
     "of": "doc",
     "text": "RxRDY is reset automatically upon the CPU data read operation.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "515-516",
       "sha": "c06f24d4b0fe8eb4bedf64c2b6663b4d7feee2aed4225bb781be0f71c3b643c4"
      }
     ]
    }
   ],
   "closed": [
