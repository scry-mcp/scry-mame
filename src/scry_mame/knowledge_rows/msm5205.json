  {
   "key": "0x02",
   "name": "vck_legacy_callback",
   "source": "emulator",
   "searched": [
    {
     "where": "mame-header",
     "gave": "The comments of msm5205.cpp and msm5205.h cite no document and say nothing of this callback beyond its declaration."
    },
    {
     "where": "maker",
     "gave": "OKI's MSM5205 data sheet describes the VCK pin and has no software callback, which is MAME's driver interface."
    },
    {
     "where": "bitsavers",
     "gave": "Hosts OKI's 1994 voice synthesis data book, the document used here; it names no such callback."
    },
    {
     "where": "archive-org",
     "gave": "Holds an archived copy of the same data book; nothing else was looked for there."
    },
    {
     "where": "index",
     "gave": "A web search for the MSM5205 data sheet gave the same OKI data books and a standalone copy; none has a callback."
    }
   ],
   "regions": [
    {
     "ref": "mame:src/devices/sound/msm5205.h",
     "function": "msm5205_device::vck_legacy_callback"
    },
    {
     "ref": "mame:src/devices/sound/msm5205.cpp",
     "lines": "180-181"
    }
   ],
   "rows": [
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "MAME gives the driver vck_legacy_callback, a binder for a callback that update_adpcm calls with 1.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.h",
       "lines": "32",
       "sha": "536346cd22dc4e6ca59af1847331a56381f2623bdb95dff24580eb7e501fddbe"
      },
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "175",
       "sha": "e8b2f210f746cca56ec92c33408cb9743eaef0491944cdc84bd6dce108e99ce4"
      },
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "181",
       "sha": "66147b72b7a2e8c897fd5a9aa84d0f4d41178268ef88e7142a06e3b77b7ce0f2"
      }
     ]
    },
    {
     "n": "102",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The legacy callback is a write-line callback member of MAME's device, exposed through a bind() binder.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.h",
       "lines": "32",
       "sha": "536346cd22dc4e6ca59af1847331a56381f2623bdb95dff24580eb7e501fddbe"
      },
      {
       "ref": "mame:src/devices/sound/msm5205.h",
       "lines": "84",
       "sha": "d97aec9608ac4d6499c8ece4d675e4af87d9036fde4e93f5dba4ed5e89548633"
      }
     ]
    },
    {
     "n": "103",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "update_adpcm calls the legacy callback first and reads the latched data m_data after it, past the reset check.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "181",
       "sha": "66147b72b7a2e8c897fd5a9aa84d0f4d41178268ef88e7142a06e3b77b7ce0f2"
      },
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "184",
       "sha": "21ead3f0d45a04d9a1f304d7d0d2f67aaaade18511b481075e76f88a338a45c5"
      },
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "193",
       "sha": "c26043735c01fed5b4b2ab09ee5d6c30fecd5e68d6b5074101ce51889fdb04e4"
      }
     ]
    },
    {
     "n": "104",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "update_adpcm calls the legacy callback with 1 when it is not unset.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "180-181",
       "sha": "bfe263112933f93721d197d5473cf8610f1bc3f2b3d310871a62ae71fba04b1f"
      }
     ]
    }
   ],
   "closed": []
