 "entries": [
  {
   "key": "0x00",
   "name": "set_prescaler_selector",
   "regions": [
    {
     "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
     "lines": "1198-1201"
    },
    {
     "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
     "lines": "1213-1215"
    },
    {
     "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
     "lines": "1245-1261"
    },
    {
     "ref": "mame:src/devices/sound/msm5205.h",
     "function": "msm5205_device::set_prescaler_selector"
    },
    {
     "ref": "mame:src/devices/sound/msm5205.cpp",
     "function": "msm5205_device::get_prescaler"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "S1 and S2 are inputs that select the sampling data according to Figure 1.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1200",
       "sha": "d7a2aede62489b7cefec64a7ee83defa88e5a0329910d3cc9e5656ca29395150"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "With S1 low, S2 low gives a sampling frequency of 4 kHz (fosc/96) and S2 high gives 6 kHz (fosc/64), at fosc = 384 kHz.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1245-1252",
       "sha": "dbe38d70aff18f26ce26b6ad7557570f8986b3e80f95f9387c560fd5ca13120b"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "With S1 high and S2 low the sampling frequency is 8 kHz (fosc/48), at fosc = 384 kHz.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1245-1250",
       "sha": "cb3ae8f47d1f3d5322548d7c37d6a69295bd32795fc4228548fa8e65e6f2aca0"
      },
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1253",
       "sha": "2d93f8f9896674062410ea599945346e5e78f8c058bccc8f88b710ed95ac9f10"
      }
     ]
    },
    {
     "n": "4",
     "on": "when",
     "of": "doc",
     "text": "S1 and S2 both high is prohibited.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1245-1250",
       "sha": "cb3ae8f47d1f3d5322548d7c37d6a69295bd32795fc4228548fa8e65e6f2aca0"
      },
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1254",
       "sha": "559db6004f62516f9150712e8c0181cf0c6b3a5354aae3b47e223e717b56f078"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "A 384 kHz oscillator can select 4, 6 or 8 kHz, and a 768 kHz oscillator can select 8, 12 or 16 kHz.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1257-1258",
       "sha": "3da9c06d36e1eaa3209a914676994c527beab6a4b2bce77dfe1817b0b997d4d8"
      },
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1260-1261",
       "sha": "03d1aa5d13cebc23fdd899931ff2ac27f8d078c509db9e9a2bb1db8676ada461"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "The input that specifies the data width takes 4-bit ADPCM data at H level and 3-bit ADPCM data at L level.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1214-1215",
       "sha": "bdc5205296c2f1da97df951e8cc7d6c4849f03f43f987bafcf34ad7f445b5cd5"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "MAME sets S1 from bit 0, S2 from bit 1 and the data width from bit 2 of the select argument of set_prescaler_selector, which only stores them.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.h",
       "lines": "25-30",
       "sha": "1883d3817c3c3e6d5d0f3d14a69dd6c9fca593565909ee2a32550951a071fda0"
      }
     ]
    },
    {
     "n": "102",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "A MAME chip starts with S1 low, S2 low and 4-bit data.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "65-67",
       "sha": "aabb92c12554b5cf3cc006a6f45d550616bf15ef5dc913cd83d573f16093abb6"
      }
     ]
    },
    {
     "n": "103",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "4",
     "text": "With S1 and S2 both high MAME's get_prescaler returns 0, where every other combination returns 96, 64 or 48.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "260-263",
       "sha": "1d45b650c1238d42d333eaf4c09a3077c45fd65ea3ac48533f29cc46cf6990a2"
      }
     ]
    },
    {
     "n": "104",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "MAME also stores S2 from bit 1 of the data of playmode_w and from the state argument of s2_w, notifying a clock change when S2 changes.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "279-290",
       "sha": "b85826263068df08ee376122f22170f87eddc63b105e9b4f68e145d8c26020e6"
      },
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "310-316",
       "sha": "36268cb29d1b982779341a2004a4ad12136f4a619ef255bca6dde16b0bf0526d"
      }
     ]
    }
   ],
   "closed": [
