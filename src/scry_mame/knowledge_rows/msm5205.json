  {
   "key": "0x04",
   "name": "data_w",
   "regions": [
    {
     "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
     "lines": "1216-1220"
    },
    {
     "ref": "mame:src/devices/sound/msm5205.cpp",
     "function": "msm5205_device::data_w"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The ADPCM data inputs are the terminals the capture lists as `4 5 6 7`.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1216-1220",
       "sha": "84a6e0e17b2f93238cc644265da208bf2c7d65a705d47931b01fd16b8f12b6f2"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "For 3-bit ADPCM data the D0 input is not used (the capture reads `Do`).",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1220",
       "sha": "6643bae23b4ed1069fd333720891dcdbd48b083c405a48a3662da86190db2f6c"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "For 3-bit ADPCM data, the D0 input should be connected to ground (the capture reads `Do`).",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "1220",
       "sha": "6643bae23b4ed1069fd333720891dcdbd48b083c405a48a3662da86190db2f6c"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "MAME reaches the data inputs through data_w, which stores the nibble in m_data; the header comment says the data is latched after the vclk callback.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.h",
       "lines": "37",
       "sha": "4c8426ad0afb0adc229f03265a737d09aed23ff34ee2207cdfbd66f0541dfdb3"
      },
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "253",
       "sha": "ce9c41905e80d4545e3b7b891c3ed35206ae70ba1451800d4d8c879f3cc88e43"
      },
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "255",
       "sha": "a817f166ecb5a7c7f3ac886ca72bf6bf581da5b85340a70057c6cd806b0eed85"
      }
     ]
    },
    {
     "n": "102",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "In 4-bit mode data_w keeps bits 0 to 3 of its argument as the nibble.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "252-253",
       "sha": "2ff1fcc30654055bf120a521eee14f913df551b622a9f2f12ebdc7d3e8e6e060"
      }
     ]
    },
    {
     "n": "103",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "In 3-bit mode data_w shifts bits 0 to 2 of its argument up by one place; the code's comment on that line says unknown.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "254-255",
       "sha": "c0bc9d2db731c69198bf467e121dca799f2f971ef26d91e44b5d2c043df7108f"
      }
     ]
    },
    {
     "n": "104",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "2",
     "text": "In 3-bit mode data_w keeps bits 0 to 2 of its argument as data and drops bit 3; the shift leaves the stored nibble's bit 0 at 0.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/msm5205.cpp",
       "lines": "254-255",
       "sha": "c0bc9d2db731c69198bf467e121dca799f2f971ef26d91e44b5d2c043df7108f"
      }
     ]
    }
