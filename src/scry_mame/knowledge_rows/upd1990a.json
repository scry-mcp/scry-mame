    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "When serial data commands are used, the C0, C1 and C2 pins should be connected to the VDD pin.",
     "quotes": [
      {
       "ref": "datasheet:uPD4990A.raw.txt",
       "lines": "363",
       "sha": "f7cb9d7be61c4bdbfc0dfa5aef4a55534fcc59b83e7637767b2067fda2c3882d"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Commands input from the C0, C1 and C2 pins are 1 for a high level (H) and 0 for a low level (L).",
     "quotes": [
      {
       "ref": "datasheet:uPD4990A.raw.txt",
       "lines": "330",
       "sha": "aa28da66a0fa0c07c3c603a7e3ed80b3c674e670d845909b4273911eb0afb58a"
      }
     ],
     "links": [
