 "entries": [
  {
   "key": "0x00",
   "name": "oe_w",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:uPD4990A.raw.txt",
     "lines": "277-278"
    },
    {
     "ref": "datasheet:uPD4990A.raw.txt",
     "lines": "318"
    },
    {
     "ref": "mame:src/devices/machine/upd1990a.cpp",
     "function": "upd1990a_device::oe_w"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "OUT ENBL is the output control input.",
     "quotes": [
      {
       "ref": "datasheet:uPD4990A.raw.txt",
       "lines": "318",
       "sha": "c5ceeadd0a5aa359a00d05ff773a5d2d0d48a9bf39b4caeea25be3280294a094"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Connecting the OUT ENBL pin to ground sets the DATA OUT pin at high impedance.",
     "quotes": [
      {
       "ref": "datasheet:uPD4990A.raw.txt",
       "lines": "278",
       "sha": "cd9a85ee07aeea7187a987566a78909e97a07c6beccfc2742cea749df7d56f86"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "text": "MAME drives a level of 1 instead of high impedance: with OUT ENBL low and test mode off, DATA OUT reads 1.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/upd1990a.cpp",
       "lines": "433",
       "sha": "a83b58701b4608ae08824ef79e52b564266c3475aeacd28e92742c498f26f4fd"
      },
      {
       "ref": "mame:src/devices/machine/upd1990a.cpp",
       "lines": "472",
       "sha": "f8a1c61abe0603433fecc27be333fec89d2fa3ae7d053ffcba3730841ddadb4a"
      }
     ],
     "row": "2"
    },
    {
     "n": "4",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A change of OUT ENBL makes MAME send the DATA OUT level to the data callback, unless the latched command is the test command.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/upd1990a.cpp",
       "lines": "435-436",
       "sha": "8c2f1a8b92a7dc2dfe966008a2b01fbc15f34675cfb7a2ae28d5351b0d2dc33b"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "datasheet:uPD4990A.raw.txt",
     "lines": "277",
     "as": "key"
    }
   ]
  },
  {
   "key": "0x01",
   "name": "cs_w",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:uPD4990A.raw.txt",
     "lines": "275-276"
    },
    {
     "ref": "datasheet:uPD4990A.raw.txt",
     "lines": "317"
    },
    {
     "ref": "mame:src/devices/machine/upd1990a.cpp",
     "function": "upd1990a_device::cs_w"
    },
    {
     "ref": "mame:src/devices/machine/upd1990a.cpp",
     "lines": "189-190"
    },
    {
     "ref": "mame:src/devices/machine/upd1990a.cpp",
     "lines": "375-376"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "CS is the chip select input, which prohibits the CLK and STB inputs.",
     "quotes": [
      {
       "ref": "datasheet:uPD4990A.raw.txt",
       "lines": "317",
       "sha": "1b92b731f118366fb93a8d979371930181d13fcf10ecb33685f09abe40b20dac"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Connecting the CS pin to ground inhibits the STB input.",
     "quotes": [
      {
       "ref": "datasheet:uPD4990A.raw.txt",
       "lines": "276",
       "sha": "1e2285828398fbe3f059ef0b151568de57009adef4f11df3a82ec929a10e8f61"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "Connecting the CS pin to ground inhibits the CLK input.",
     "quotes": [
      {
       "ref": "datasheet:uPD4990A.raw.txt",
       "lines": "276",
       "sha": "1e2285828398fbe3f059ef0b151568de57009adef4f11df3a82ec929a10e8f61"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "CS is the chip select input.",
     "quotes": [
      {
       "ref": "datasheet:uPD4990A.raw.txt",
       "lines": "317",
       "sha": "1b92b731f118366fb93a8d979371930181d13fcf10ecb33685f09abe40b20dac"
      }
     ]
    }
   ],
