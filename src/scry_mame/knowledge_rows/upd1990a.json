  {
   "key": "0x04",
   "name": "c0_w",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:uPD4990A.raw.txt",
     "lines": "330"
    },
    {
     "ref": "datasheet:uPD4990A.raw.txt",
