   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Data is automatically transferred to the empty Receive Data Register from the receiver deserializer upon receiving a complete character, which sets the RDRF bit.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "509-513",
       "sha": "1a3e3cddfff2c4575d9bfb510282f1289016b23c5d71adbcd3757beef5699535"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "Data may be read through the bus from the Receive Data Register.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "513-516",
       "sha": "70f6843bedcc6ed0ea10c47ca4275d1bde6a0a2eac4fefa2c75a33ff8e3efef4"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "The non-destructive read cycle causes the RDRF bit to be cleared to empty although the data is retained in the RDR.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "516-518",
       "sha": "79f3e9e20e0f3709477a65d6d7910a94add24eb283f4f395a96d672849bcc954"
      }
     ]
    },
    {
     "n": "4",
     "on": "when",
     "of": "doc",
     "text": "The bit can be cleared by reading data.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "437",
       "sha": "278415c916f431ac57e9a7645d5425d26dd7f1644dca680bb1989cb5dbb3bcaf"
      }
     ]
    },
    {
     "n": "5",
     "on": "when",
     "of": "doc",
     "text": "Then reading the Receive Data Register clears the interrupt.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "440",
       "sha": "d42dc78686358d49c0e373ef230a90680ce79171370597f4d4904348aae3ac5a"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The status is maintained by RDRF as to whether or not the data is current.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "518-519",
       "sha": "98aa273d6cc327960e85d350a769c6843a7111b94c917ad55fffc8a928f258c4"
      }
     ]
    },
    {
     "n": "102",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A debugger read, with side effects disabled, changes no status flag and no pending flag.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6850acia.cpp",
