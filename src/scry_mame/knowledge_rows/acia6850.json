   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The Control Register consists of eight bits of write-only buffer, controlling the receiver, transmitter, interrupt enables and the RTS output.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "553-557",
       "sha": "f69bcf2b05007763e576af33d0adb53c34fcb908d1912d410e3c8fc8ad8818f2"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The Control Register is selected for writing when RS and R/W are low.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "553-554",
       "sha": "8d61f7e3a180076f1b2b5e8cfa498d598f3233cdcbae7b194585d8aed696959d"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "CR0 and CR1 determine the divide ratios used in both the transmitter and the receiver.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "558-561",
       "sha": "5d548ab590287e8f38bca196088aba86b04d34aefaeb11db3225e7d74c6daaa2"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "CR0 and CR1 also provide a master reset, which initializes both the receiver and the transmitter.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "561-564",
       "sha": "6ccaba7f32906c026163fb2668c8ffac091b4a0a414943031f3e788a5daf57d1"
      }
     ]
    },
    {
     "n": "17",
     "on": "write",
     "of": "doc",
     "text": "The master reset clears the Status Register, except for external conditions on CTS and DCD.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "561-563",
       "sha": "7abda84d98b23eb933b5d258ec727b8cb9ce586e6269d309c6b185ac46d978a6"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "17",
     "text": "Master reset keeps TDRE set, and sets the DCD bit from the m_dcd input, as it keeps CTS.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6850acia.cpp",
       "lines": "223-227",
       "sha": "c0978f2646ed92e7d0836e0ecc18bed8beae9bee4469afc55d38aca8b403ccb0"
      },
      {
       "ref": "mame:src/devices/machine/6850acia.cpp",
       "lines": "229-232",
       "sha": "b9f93201cf3a262d029d248c66f28680dee8000c6c61d15213c4b981289edc74"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "CR1 CR0 = 00 divides by 1, 01 by 16, 10 by 64, and 11 is master reset.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "568-574",
       "sha": "cc1fe80440c0f14b7aac6f890c6800a3b6ff1b8292883018828c979924ed23ae"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "CR2, CR3 and CR4 select word length, parity and the number of stop bits: 7 bits with parity, or 8 bits with or without parity.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "575-586",
       "sha": "80b2b9eb39db4bc8cad7f47e25b277dfa603eb115448a744f3603364a2b5481e"
      }
     ]
    },
    {
     "n": "7",
     "on": "write",
     "of": "doc",
     "text": "Word length, parity select and stop bit changes are not buffered and become effective immediately.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "587-588",
       "sha": "54282034d4df1bc89f8f44e823c8ced6dae8a86a6158ee5f86bc0be738e4fb93"
      }
     ]
    },
    {
     "n": "8",
     "on": "write",
     "of": "doc",
     "text": "CR6 CR5 = 00: RTS low, transmitting interrupt disabled; 01: RTS low, enabled; 10: RTS high, disabled; 11: RTS low, break level, disabled.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "589-600",
       "sha": "3702f212401996ad2fea2115b927f2f2ce9681186f1b3c6299ab135a0e106701"
      }
     ]
    },
    {
     "n": "9",
     "on": "write",
     "of": "doc",
     "text": "CR7 is stored; the text says high enables the Receive Data Register Full, Overrun and low-to-high DCD interrupts.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "601-605",
       "sha": "a6f2063107536793fad8c0ab7bc8aa596d514ec0106a11010903b540e771dfdc"
      }
     ]
    },
    {
     "n": "10",
     "on": "write",
     "of": "doc",
     "text": "The RTS output corresponds to CR5 and CR6; with CR6 = 0, or CR5 and CR6 both 1, it is low.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "475-479",
       "sha": "06ad4d6175d42c3626d8d93a2fdeb10ebec7ab147f06f7c1fb265041d5d70e17"
      }
     ]
    },
    {
     "n": "16",
     "on": "is",
     "of": "doc",
     "text": "The RTS output can also be used for Data Terminal Ready (DTR).",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "480",
       "sha": "3eb92c710f8f83c9762391512dacd0a69fbbb9602415a109631c89cb8a9a4d66"
      }
     ]
    },
    {
     "n": "11",
     "on": "when",
     "of": "doc",
     "text": "During the first master reset the RTS output is held at level 1.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "308-309",
       "sha": "1a14584daa1261d128867ce0a5337160188f3f6b3fc83ddacbd83355afcbdd0b"
      }
     ]
    },
    {
     "n": "12",
     "on": "when",
     "of": "doc",
     "text": "During the first master reset the IRQ output is held at level 1.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "308-309",
       "sha": "1a14584daa1261d128867ce0a5337160188f3f6b3fc83ddacbd83355afcbdd0b"
      }
     ]
    },
    {
     "n": "13",
     "on": "when",
     "of": "doc",
     "text": "On all other master resets the RTS output can be programmed high or low.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "309-311",
       "sha": "46c8b8facb17acb8d7e7a23b0dd34c617d72464d0effe94cbc95e76daf1843e3"
      }
     ]
    },
    {
     "n": "14",
     "on": "when",
     "of": "doc",
     "text": "On all other master resets the IRQ output is held high.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "309-311",
       "sha": "46c8b8facb17acb8d7e7a23b0dd34c617d72464d0effe94cbc95e76daf1843e3"
      }
     ]
    },
    {
     "n": "15",
     "on": "is",
     "of": "doc",
     "text": "CR5 and CR6 should also be programmed to define the state of RTS whenever master reset is used.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "311-313",
       "sha": "427e99a68e8866eb124f69d263efe70bb89a08d785737341d5fca328702ba2da"
      }
     ]
    }
   ],
