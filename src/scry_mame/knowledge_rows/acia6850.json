   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Information on the status of the ACIA is available to the MPU by reading the ACIA Status Register.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "607-608",
       "sha": "b87e0bb4beff22f7bfc21c20d43e090606abec83ef0c1bf0eb6bef0a7d187211"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "The read-only Status Register is selected when RS is low and R/W is high.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "608-609",
       "sha": "5a4e9f0772733fbe058aac1604fb0214d5ae6eee10b11ff32c90759bb37bb22c"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "The TDRE status bit shows the current state of the Transmit Data Register, except when inhibited by CTS being high or by the reset condition.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "426-428",
       "sha": "b5274c18a9165d84405e4e7ffb15b45d4532ae72ec8a95675dfddb934dee8829"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "RDRF, bit 0, indicates received data has been transferred to the Receive Data Register; an MPU read of that register, or master reset, clears it.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "613-617",
       "sha": "ce07a42897ee62163e4fe0417c751b0f4e0dd2fb19cb262365bcaa2bf5b6520d"
      }
     ]
    },
    {
     "n": "5",
     "on": "read",
     "of": "doc",
     "text": "Data Carrier Detect being high also causes RDRF to indicate empty.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "618-619",
       "sha": "4021e589235531336c09052526a9582b09554be6e7fd84816df0ea5f7832b8f5"
      }
     ]
    },
    {
     "n": "6",
     "on": "read",
     "of": "doc",
     "text": "The Clear-to-Send bit shows the state of the CTS input: a low CTS means clear to send; in the high state TDRE is inhibited and the bit reads high.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "637-641",
       "sha": "a979a07a89a8ebe0592ff24e9034507275449963e1411b21eb1708dd152ad955"
      }
     ]
    },
    {
     "n": "7",
     "on": "when",
     "of": "doc",
     "text": "Reading the status register after the error condition has occurred is part of clearing an Overrun or loss-of-DCD interrupt.",
     "quotes": [
      {
       "ref": "datasheet:MC6850.raw.txt",
       "lines": "438-439",
       "sha": "a78250e360a61bc5d2163220e90363bc7f93cf8ddee35e149684f680204028e3"
      }
     ]
    },
    {
     "n": "101",
     "on": "read",
     "of": "mame",
     "vs": "differs",
     "row": "5",
     "text": "status_r masks only TDRE, when m_divide is 0 or CTS is set; RDRF is returned as stored, whatever the DCD input.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6850acia.cpp",
       "lines": "158-168",
       "sha": "b788c77bec7c3044eaef22585e3b7d5abe510421fba595353eae1a540b89f860"
      },
      {
       "ref": "mame:src/devices/machine/6850acia.cpp",
       "lines": "169-173",
       "sha": "8a9eb968ea1bafdda9a8b1799bd22cf3ef52f0117a74ba57b949a938a70d8653"
      }
     ]
    },
    {
     "n": "102",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "7",
     "text": "A status read moves a pending DCD interrupt to waiting for a data read.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6850acia.cpp",
       "lines": "165-170",
       "sha": "766f52a2aa6ee39abfd9ce6c3b83e12fa4f3629a17c194fb9862df3b20cb225c"
      }
     ]
    }
   ],
