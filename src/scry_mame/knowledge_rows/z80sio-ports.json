    },
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "Table 11: C/D 0 B/A 0 is Channel A Data, 0 1 is Channel B Data, 1 0 is Channel A Commands/Status, 1 1 is Channel B Commands/Status.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10542-10545",
       "sha": "dbf33929b383e9adec6f691fd401264c02a709280cd4b926496247866c038d3b"
