  {
   "key": "0x100..0x103",
   "access": "write",
   "name": "cd_ba port write",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:UM0081.raw.txt",
     "lines": "7823-7826"
    },
    {
     "ref": "datasheet:UM0081.raw.txt",
     "lines": "7844-7846"
    },
    {
     "ref": "mame:src/devices/machine/z80sio.cpp",
     "function": "z80sio_device::cd_ba_w"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "A High at C/D during a CPU write makes the data bus information a command for the channel selected by B/A; a Low at C/D indicates data.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "7823-7826",
       "sha": "f89e30f1d15033d41c032c3638bbda0ac13403ad9d46a92561f12889d5640177"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "Address bit A1 is often used for the C/D function.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "7826",
       "sha": "2e8944e9d2fc83f0647977ae5770a240182273dc8a30e6dc6b539b8245edd8ef"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "When CE and IORQ are active but RD is inactive, the channel selected by B/A is written with data or control information as C/D specifies.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "7844-7846",
       "sha": "ed1156d5ac48737fb6e991f238217cde6175aa782b5b55f24fb5aa57c938fb39"
      }
     ]
    },
    {
     "n": "3",
     "on": "place",
     "of": "mame",
     "text": "In cd_ba_w, offset bit 0 is B/A and offset bit 1 is C/D, and the byte goes to the selected channel's control or data write.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80sio.cpp",
       "lines": "911",
       "sha": "8584cea2848aab9cf34fcd4b200596a838cc42f39dbebff4d03226b4c5c7a5d4"
      },
      {
       "ref": "mame:src/devices/machine/z80sio.cpp",
       "lines": "912",
       "sha": "bd1a3f42a98cd859df66e1fb27287b9083592469d8c9005ae67f1f666322141f"
