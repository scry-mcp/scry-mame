   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Port C is an 8-bit data output latch/buffer and an 8-bit data input buffer with no latch for input; it can be divided into two 4-bit ports.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "65-70",
       "sha": "e920e28c5e4c8187aaf17fad16986b3fdefc8b9c3f8e7bb9ded58e12bc4b5fde"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "PC0-3 are the lower nibble of port C.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "71",
       "sha": "328ed53cdc8a9b60cead51f0c91f0582f4615b05a49f0cfa2a84b23bb8e72f3c"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "With A1 A0 = 1 0, RD low, WR high and CS low, a read puts port C on the data bus.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "55",
       "sha": "07dd2fbf652bfe20bcc624f5a23c3b5556e5a708159b8279fcb664bad4965e8c"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "doc",
     "text": "During a read of port C, the state of all the port C lines, except the ACK and STB lines, is placed on the data bus.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "443-445",
       "sha": "cbf0597dd5643bcacdb12326526488600e89a8af3341a7198881eafcc8268779"
      }
     ]
    },
    {
     "n": "9",
     "on": "read",
     "of": "doc",
     "text": "In place of the ACK and STB line states, flag status appears on the data bus in the PC2, PC4 and PC6 bit positions.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "445-448",
       "sha": "aff5402aa41ce69d4cb8516c6550e402e6d6bbb0e7ca0f58f56e3347725b4bf0"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "Reading port C lets the programmer test the status of each peripheral; no special instruction is needed, a normal read of port C does it.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "474-485",
       "sha": "c0a077af7dae6bfd7a58dd7e3e48587878b77fa9c0a4d75be2bf6bacaef7e517"
      }
     ]
    },
    {
     "n": "6",
     "on": "bits 7-0",
     "of": "doc",
     "text": "In the mode 1 input configuration, D5 is IBFA, D4 INTEA, D3 INTRA, D2 INTEB, D1 IBFB and D0 INTRB; D7 and D6 are I/O.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "486-489",
       "sha": "c208e0021c19178a26c2fd4aa40856ffe9209fe985c1553f2416d36e81317bae"
      }
     ]
    },
    {
     "n": "7",
     "on": "bits 7-0",
     "of": "doc",
     "text": "In the mode 1 output configuration, D7 is OBFA, D6 INTEA, D3 INTRA, D2 INTEB, D1 OBFB and D0 INTRB; D5 and D4 are I/O.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "490-493",
       "sha": "b2c00b9690416d85b02c87cd4469515b8ace992f28743d5d140bff7c2660bdbb"
      }
     ]
    },
    {
     "n": "8",
     "on": "bits 7-0",
     "of": "doc",
     "text": "In mode 2, D7 is OBFA, D6 INTE1, D5 IBFA, D4 INTE2 and D3 INTRA; group B follows its mode 0 or mode 1 selection.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "495-498",
       "sha": "09864a9b54c92a7450cd66e99208d3a287c9034e3800bf291e43294a60c414ab"
      }
     ]
    }
