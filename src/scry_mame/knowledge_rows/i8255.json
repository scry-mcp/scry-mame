   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "With A1 A0 = 1 0, RD high, WR low and CS low, a write puts the data bus into port C.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "60",
       "sha": "7252b43c8da107ceb4fc8bdc85b78576e81276512bd6ea7c0cede5698edae2f0"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A write of port C changes only the port C pins programmed as outputs in a mode 0 group; no other pin and no interrupt enable flag can be affected.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "449-453",
       "sha": "b712d4e4752b09964965471c6a96c56bcb35eda56731824324ddf31d89607d18"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "To write a port C output of a mode 1 group, or to change an interrupt enable flag, the Set/Reset Port C Bit command must be used.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "453-456",
       "sha": "b78bc8dc78007c98819c197bf6dd4c59afa47f72947177275fcfc9197bab4425"
      }
     ]
    },
    {
     "n": "104",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "2",
     "text": "In mode 1, MAME also drives the two port C pins that are not handshake lines from the data written, through the output mask.",
