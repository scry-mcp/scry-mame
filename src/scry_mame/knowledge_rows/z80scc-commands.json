     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The Null command is command code 00, printed OO in the capture.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "7198",
       "sha": "560eb8392d1d3c107217803f6d0666d1655862fa33f87926a43698e4923e0347"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The Null command has no effect on the SCC; it is used when a write to WR9 is needed for a reason other than a reset command.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "7198-7200",
       "sha": "548a7e3d06af4233a214441086642a8af635908afefb102fb755b2245e89445a"
      }
     ]
    }
   ],
