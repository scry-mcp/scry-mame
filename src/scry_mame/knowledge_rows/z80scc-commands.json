{
 "format": "scry-knowledge/2",
 "dictionary": "z80scc-commands",
 "title": "Z80 SCC WR0 and WR9 command codes",
 "kind": "command",
 "scope": "z80scc",
 "covers": "the CRC reset code in bits D7 and D6 of WR0 (keys 0x00 to 0xFF, by the two high bits), the command codes 000 to 111 in bits D5 to D3 of WR0 (keys 0x100 to 0x138) and the reset commands in bits D7 and D6 of WR9 (keys 0x200 to 0x2FF)",
