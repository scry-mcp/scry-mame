  {
   "key": "0x2C0..0x2FF",
   "name": "WR9 hardware reset",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "7205-7209"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "function": "z80scc_channel::do_sccreg_wr9",
     "case": [
      "WR9_CMD_HW_RESET"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Force Hardware Reset is command code 11.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "7205",
       "sha": "ad193c4caf3d69afd8c6de2b0c436fca4aa2f3d1e8d0d84da1bad7479e7207bb"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The command has the same effects as a hardware reset.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "7205-7206",
       "sha": "17773a5ccf29b88a89a516874170612b9baeb95f3612ce433096cb1ad1c73dd2"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "Unlike a hardware reset, it leaves the Shift Right/Shift Left bit unchanged and gives the MIE, Status High/Status Low and DLC bits the command's programmed values.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "7206-7209",
       "sha": "74fe4b00c4118870fede43267e54fc96b60a8976799e4fd200aeea6b07ccfd3b"
      }
     ]
    }
   ],
