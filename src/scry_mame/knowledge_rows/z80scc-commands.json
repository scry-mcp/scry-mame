  "update_extint",
  "reset"
 ],
 "entries": [
  {
   "key": "0x00..0x3F",
   "name": "CRC reset null",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "6266-6269"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "function": "z80scc_channel::do_sccreg_wr0",
     "case": [
      "WR0_CRC_RESET_NULL"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "WR0 bits D7 and D6 are 00, the Null CRC reset code: it has no effect on the SCC and is used when a write to WR0 serves another purpose.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6266-6269",
       "sha": "8021294abb81d2900f87b0a0711424ad6e12d22c726c74817851b5707dda2359"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "WR0 bits D7 and D6 carry the CRC Reset Codes 1 and 0.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6266",
       "sha": "ff4a5435cadc00097bb6ee0366bc65f7dd82321a0f30d122aed5c45d811aad62"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "1844-1846",
     "as": "agrees",
     "row": "1",
     "nothing": true
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "1842",
     "as": "structure"
    }
   ]
  },
  {
   "key": "0x40..0x7F",
   "name": "reset Rx CRC checker",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "6270-6277"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "function": "z80scc_channel::do_sccreg_wr0",
     "case": [
      "WR0_CRC_RESET_RX"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "WR0 bits D7 and D6 are 01, the Reset Receive CRC Checker command: it initializes the receive CRC circuitry.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6270-6272",
       "sha": "5f9db598936ca0ff50e21ca63174d5778622de27bc50299a95c11fc87d62e7b8"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "It is necessary in synchronous modes except SDLC (printed SOLC in the scan), when Enter Hunt Mode is not issued between messages; disabling the receiver initializes the CRC.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6272-6276",
       "sha": "865638c3722797c0a235dd87e0e3782216dcd7bfc2300b3fb5e8affb35e09811"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "In SDLC mode (printed SOLC in the scan) the receive CRC checker is reset automatically.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6276-6277",
       "sha": "1773703e3086e275b860f73101b7fdbb8681af4ba7ca7944cf871dfb2c8fcab5"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "mame",
     "vs": "absent",
     "row": "1",
     "text": "MAME logs the command as not implemented and changes no receive CRC state.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80scc.cpp",
       "lines": "1847-1849",
       "sha": "995d65e4f590c191e968cede86dc25b1a88ae4ad345d2f993395a1987a795fc7"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "1842",
     "as": "structure"
    }
   ]
  },
  {
   "key": "0x80..0xBF",
   "name": "reset Tx CRC generator",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "6278-6285"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "function": "z80scc_channel::do_sccreg_wr0",
     "case": [
      "WR0_CRC_RESET_TX"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "WR0 bits D7 and D6 are 10, the Reset Transmit CRC Generator command: it initializes the CRC generator.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6278-6279",
       "sha": "0e707b9dfd86467fcd133f7448f1a6efcbb83c462f902c234f8dcb15231e968e"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "It is usually issued in the initialization routine and after the CRC has been transmitted.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6279-6281",
       "sha": "8b0e65659f8d44b15fb4dfeed9d204b30c214d9a2d0efa3a12ad9d5bcd1a4d9d"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "A Channel Reset does not initialize the generator, and the command is not issued until after the transmitter has been enabled in the initialization routine.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6281-6283",
       "sha": "7b6cf344e0ff30f8785700131f1d6685dff9ec8840c7d97cbc996e1535fa15eb"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "On the ESCC the command is not needed if Auto EOM Reset mode is enabled (WR7' D1 = 1).",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6284-6285",
       "sha": "a7144adaf094161ffe506145475ee9a51f642261be5c5782e662000dba3226c4"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "mame",
     "vs": "absent",
     "row": "1",
     "text": "MAME logs the command as not implemented and initializes no CRC generator.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80scc.cpp",
       "lines": "1850-1852",
       "sha": "9297e95e8053101973774665296a5358a1f47ee2f568d73147764ea0e8d5af5c"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "1842",
     "as": "structure"
    }
   ]
  },
  {
   "key": "0xC0..0xFF",
   "name": "reset Tx underrun latch",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "6286-6292"
    },
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "6409-6416"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "function": "z80scc_channel::do_sccreg_wr0",
     "case": [
      "WR0_CRC_RESET_TX_UNDERRUN"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "WR0 bits D7 and D6 are 11, the Reset Transmit Underrun/EOM Latch command: it controls the transmission of CRC at the end of a message.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6286-6288",
       "sha": "28721aa4db6aac51bc1dea35b4f85e53d8cd0215e9332caf1dc0fdd37ab445ea"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "With the latch reset, a transmit underrun makes the SCC automatically append CRC to the message.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6288-6290",
       "sha": "e10c3356406093735b28241e7159f9df54b69662369a6cc133f9705279c8aeca"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "In SDLC mode (printed lnSOLC in the scan) with Abort on Underrun selected, the SCC sends an abort and a flag on underrun if the latch has been reset.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6290-6292",
       "sha": "8c0165513056afd999fd91e26a6f019aa4d648a5b49e4f2468bdd5861107b622"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "At the start of the CRC transmission the latch is set, and the Reset command can be issued at any time during a message.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6409-6411",
       "sha": "542f269b2a2898430eab2c891dab8a16b65bb554f3d870bb054a264a1f49e367"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "If the transmitter is disabled, the command does not reset the latch.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6411-6412",
       "sha": "fb8a0eae52f72c9f297536def27f46c6ecc002d361cd23d881a929ea0c38caa3"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "With no pending External/Status interrupt, or with a Reset External Status command while the transmitter is disabled, an interrupt is generated with the bit reset.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6412-6416",
       "sha": "6744c42d7bb1f7a0dd79629a67d0df9aaa5b0c9950e0c921c1051490025ef9c3"
      }
     ]
    },
    {
     "n": "7",
     "on": "write",
     "of": "mame",
     "vs": "absent",
     "row": "1",
     "text": "MAME logs the command as not implemented and resets no underrun/EOM latch.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80scc.cpp",
       "lines": "1853-1855",
       "sha": "9529b51fa0c01ba262251f127f2664fef2a08611412f0c5069e49fb9d54831d0"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "1842",
     "as": "structure"
    }
   ]
  },
  {
   "key": "0x100",
   "name": "null command",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "6417-6419"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "function": "z80scc_channel::do_sccreg_wr0",
     "case": [
      "WR0_NULL"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "WR0 command code 000 is the Null command: it has no effect on the SCC.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6417-6419",
       "sha": "f8dc1ca16284ca14342ed17317b5d6adfea1a0946089740019c468bb30a99f15"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "WR0 bits D5, D4 and D3 carry a command code for the SCC.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6417",
       "sha": "3444e1f945a4a1366c1372475b8e1477d3254bb4db6ae9a568a06553d7014716"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "1816-1818",
     "as": "agrees",
     "row": "1",
     "nothing": true
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "1746",
     "as": "structure"
    }
   ]
  },
  {
   "key": "0x108",
   "name": "point high",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:SCC-UserManual-1992.raw.txt",
     "lines": "6420-6427"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "function": "z80scc_channel::do_sccreg_wr0",
     "case": [
      "WR0_POINT_HIGH"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "WR0 command code 001 is the Point High command: it adds eight to the register pointer, allowing WR8 through WR15 to be accessed, and is used in the Z85X30.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6420-6425",
       "sha": "14d4876ef6ecbd43e10fd9b5f6f61d07ea048c895b526b580c8e51797674df85"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The Point High command and the register pointer bits are written simultaneously; the Z80X30 accesses registers through direct addressing instead.",
     "quotes": [
      {
       "ref": "datasheet:SCC-UserManual-1992.raw.txt",
       "lines": "6423-6427",
       "sha": "48dd5581d62981b8526f1c9a7cd63ee71515f535957f27bb0bca0e6830de29b8"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "1755-1759",
     "as": "agrees",
     "row": "1"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "1746",
     "as": "structure"
    },
    {
     "ref": "mame:src/devices/machine/z80scc.cpp",
     "lines": "1746",
