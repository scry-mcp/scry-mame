     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "3466-3474"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "function": "scsp_device::UpdateReg",
     "case": [
      "0x18"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "TACTL designates the increment cycle for timer A.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3391-3392",
       "sha": "b6dec026e1bd5fdb4676ea1b15c5e6f2366a3e154ffcc2a5599a57def773d61c"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "TIMA is timer A's count; the timer counts up and requests an interrupt when all its bits reach 1.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3472-3474",
       "sha": "9138f258023f9ddfcb4f1b76eb44c9bb133f4dad3fb82eb2e91c1190386ee196"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "Counting begins immediately after TIMA is set, and the interrupt time is 255 minus TIMA times the count cycle.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3466-3471",
       "sha": "254079645de1831df2737db0221e790d1f4cc48fb369a04a551bc596d2f9e762"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "mame",
     "text": "MAME uses 255 minus the count for the period, as the row says, but arms no timer when the count is 255.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/scsp.cpp",
       "lines": "803-812",
       "sha": "679af7ae4218fc92222e70e8bc8884a29d5c4b93586c174cf1a6cf4ba77a41a2"
      },
      {
       "ref": "mame:src/devices/sound/scsp.cpp",
       "lines": "813-817",
       "sha": "3b46a46047f57e47df1d68241dd2ea393f365c5bc27f0dbcaa2ef702774fbb19"
      }
     ],
     "vs": "differs",
     "row": "3"
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "753",
     "as": "decode"
    }
   ]
