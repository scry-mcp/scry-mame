    }
   ]
  },
  {
   "key": "0x420..0x421",
   "name": "SCI pending",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "3525-3536"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "function": "scsp_device::UpdateReg",
     "case": [
      "0x20"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "SCIPD monitors the sound CPU interrupt flags; reading it shows which interrupt occurred, whatever SCIEB holds.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3525-3532",
       "sha": "581d7799d1cc28d6a76344fa4fd514d545433c228103cad74e482cac116e7b83"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Only bit 5 of SCIPD can be written; writing 1B to it applies an interrupt to the sound CPU, and 0B is invalid.",
     "quotes": [
      {
