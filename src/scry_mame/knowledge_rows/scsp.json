    }
   ]
  },
  {
   "key": "0x400",
   "name": "MVOL master volume",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "3231-3237"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "function": "scsp_device::UpdateReg",
     "case": [
      "0x0"
     ]
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "1007"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "MVOL is the master volume to the D/A converter; lowering it for an output that overflowed does not remove the clipping noise.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3231-3237",
       "sha": "06d22ee20440cfc8850f0c1822a09f126488f64bcce50fedce2537bc75287dfe"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "MVOL can be written by the CPU.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3231",
       "sha": "ad57e9e35814247efdea47c64d5e6e37d60cf5e266706eab66a99371b984e873"
      }
     ]
    },
    {
     "n": "3",
     "on": "bits 0-3",
     "of": "mame",
     "text": "A write applies the stored MVOL as the output gain of both channels, one fifteenth per step.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/scsp.cpp",
       "lines": "755-758",
       "sha": "893f980cecb73feda23a751bbf43e26980260720916f6e6b7a3318e82996123a"
      }
     ],
     "vs": "extra"
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "753",
     "as": "decode"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "1007",
     "as": "agrees",
     "row": "2"
    }
   ]
  },
  {
   "key": "0x402..0x403",
   "name": "ring buffer RBL and RBP",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "3767-3786"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "function": "scsp_device::UpdateReg",
     "case": [
      "0x2"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "RBL selects the ring buffer length: 8K, 16K, 32K or 64K words.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3767-3768",
       "sha": "152c150b3d1b5670020b894a7f53bfc25773c991cc172348d6fe86c4e34fa79e"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3782-3786",
       "sha": "65718f8d882487e35af6c456338e0e999af215ab4a51a6420b8857ad9a1cb417"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "RBP designates the first address of the ring buffer, at a 4K-word boundary.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3770-3772",
       "sha": "b0359ee84af516527e76055a0646701a27d84ce6e53239d7e2aaed370732c119"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The ring buffer stores input data and returns it after a delay, for the DSP effects.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3773-3781",
       "sha": "36ff0fc4aaddb6ccf8bc9f967495711f8e83318428fe3ba729df722fe54d626b"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "RBL and RBP are marked write-only in the document.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3767",
       "sha": "d43980186faeb19d64d829f57f747a0f09a708d0f91f906d18f2c74ac954ae4b"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3770",
