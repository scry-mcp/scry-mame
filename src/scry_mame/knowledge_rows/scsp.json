  {
   "key": "0x416..0x417",
   "name": "DMA length dir gate",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "3710-3718"
    },
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "3734-3738"
    },
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "3740-3744"
    },
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "3752-3757"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "function": "scsp_device::UpdateReg",
     "case": [
      "0x16"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "DGATE set to 1B executes a zero clear of the transfer area when DEXE runs; a 0 write does not affect the source data.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3710-3718",
       "sha": "21603787ff6f0901e9fe0f820221f18c706097d2ab76ea5826a3bd388ec1a949"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "DDIR selects the direction: 0B from sound memory to the LSI register, 1B the opposite.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3734-3738",
       "sha": "f4355dc1d0e542588933e71ee881cb871ea9bf4f89505be83bfc0c309302b0e8"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "Writing 1 to DEXE starts the DMA transfer; writing 0 is invalid, and DEXE is reset when the transfer ends.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3740-3744",
       "sha": "afe9e1d6c2ff82680252252f82ca443eb8978756b04c69c8a61a8d6a7029d6dc"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "DTLG designates the word count transferred.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3752-3757",
       "sha": "4cfd8f43d68c32d0faecf2ede7af689942a0baca97e0876fb2a88537c5e9fd5e"
      }
     ]
    }
   ],
   "closed": [
