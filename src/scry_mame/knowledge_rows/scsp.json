  {
   "key": "0x41E..0x41F",
   "name": "SCI enable",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "3537-3542"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "function": "scsp_device::UpdateReg",
     "case": [
      "0x1e"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "SCIEB enables interrupts to the sound CPU.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3537-3538",
       "sha": "c10de14f4a631dc3ab4d3b37d2d02b17b68739b93e1e604628bc5dca530dfb92"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Setting a bit of SCIEB to 1B enables the corresponding hardware interrupt; 0B is invalid.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "3539-3542",
       "sha": "1288b3c4a2800aa5d43d39eddc10e4f7cbd4d5a019d7f990248a210d6928cc1e"
      }
     ]
    }
