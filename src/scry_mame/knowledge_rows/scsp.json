 "entries": [
  {
   "key": "0x00..0x01",
   "name": "KEYON slot key on/off",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "1382-1391"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "function": "scsp_device::UpdateSlotReg",
     "case": [
      "0"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "KYONB is read and written and records KEY_ON or KEY_OFF for its slot.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "1384-1386",
       "sha": "2b053d989325c589f412e35877a1e409934a00cdc0717f5aac2c12e8285426e3"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Writing 1B to KYONEX executes KEY_ON and KEY_OFF for all of the slots.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "1382-1383",
       "sha": "5776dfbd281b7c28c6668e38dabdf85ab8be3f056938df94943d79282a478244"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "KYONEX and KYONB exist in each slot, and a 1B written to KYONEX applies to all slots.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "1388-1389",
       "sha": "f0c8a5764a8bbc1147abb2a7a1091c834d0876e37ff37680821433584947fe67"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "1391",
       "sha": "498496f8bc2bd21780212dfbc92a58b599c4cd739789be6889da2b98de0cec36"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "After a 1B is written to KYONEX, no 0B has to be written to it.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "1390",
       "sha": "d19001ae6639b069997396f34ef447c1653ddfeb0231117b81f9f00a13afd644"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "1387",
     "as": "layout"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "712",
     "as": "decode"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "714-717",
     "as": "structure"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "718-729",
     "as": "agrees",
     "row": "2"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "730-733",
     "as": "agrees",
     "row": "4"
    }
   ]
  },
  {
   "key": "0x10..0x11",
   "name": "step frequency",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "2659-2668"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "function": "scsp_device::UpdateSlotReg",
     "case": [
      "0x10"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "OCT raises or lowers the sound generation frequency by octave, against the waveform stored in memory.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2659-2662",
       "sha": "a0f7a1f5141de6554bc4382edc630a7f5e94411f6ea08fa1ef9dbd2b093d7e80"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "FNS adjusts the tone between the octaves OCT sets; with both zero the tone matches the sample data.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2663-2668",
       "sha": "fd273abcb325df1ae8172d641dc8f3e5ebc47800f794ae68a2e45edf041f30e2"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "OCT and FNS can be written by the CPU.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2659",
       "sha": "e6e45d5c60a25a283acfe5324bea4524e2ea131c949f82b2db47560063a4062c"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2663",
       "sha": "9fdaf768959db5ea1a6cd1b84b9812b54530021e13700adc251e1f753c62a44a"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "mame",
     "text": "MAME recomputes the slot's frequency step from FNS plus 1024 shifted by the signed octave on either byte's write.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/scsp.cpp",
       "lines": "735-738",
       "sha": "6886f40ce45026d1482d4a839cf1df28d9180447b1a6f3fc9f10e93c1897569f"
      },
      {
       "ref": "mame:src/devices/sound/scsp.cpp",
       "lines": "546-557",
       "sha": "47f0477319e3befc245f2cbbf530e41d6f1d7173cdb724466e7663edcd985be5"
      }
     ],
     "vs": "extra"
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "712",
     "as": "decode"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "735-738",
     "as": "agrees",
     "row": "3"
    }
   ]
  },
  {
   "key": "0x0A..0x0B",
   "name": "RR and DL rates",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "1686-1697"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "function": "scsp_device::UpdateSlotReg",
     "case": [
      "0xA"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "RR designates the EG's change volume in the release state, minimum at 00H and maximum at 1FH.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "1686-1690",
       "sha": "33163b9166641bd3a4459d48ad120960f9a7af71e02c2857c0500c7d91cd9592"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "DL is the upper five bits of the attenuation at which decay 1 moves to decay 2; 00H is maximum and 1FH minimum.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "1691-1697",
       "sha": "7f62b02a8a174cca1ce835d62708c3ea6e5f64ed0f899420ac960121887b0b7d"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "RR and DL can be written by the CPU.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "1686",
       "sha": "cf7dee2f76c9eb95a5137a46c9e6eea70ebaf1b8538d411be3a101c07d8ec651"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "1691",
       "sha": "a4e196fc6c70899261b895f6b479ec91042d0e429edc4e7158c3ec4fdf176832"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "mame",
     "text": "MAME converts RR through its rate table at key rate zero and stores 31 minus DL, the complement of the register value.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/scsp.cpp",
       "lines": "739-743",
       "sha": "f741560b405da521dabc56979773fce593e396d3a02ee87f37615aeaeeb80e1b"
      },
      {
       "ref": "mame:src/devices/sound/scsp.cpp",
       "lines": "470-473",
       "sha": "903de3539eb94e61084768f390ca88bff32b4c5c3b5ab28bb116dd3c7fb77403"
      }
     ],
     "vs": "extra"
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "712",
     "as": "decode"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "739-743",
     "as": "agrees",
     "row": "3"
    }
   ]
  },
  {
   "key": "0x12..0x13",
   "name": "LFO parameters",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "2830-2840"
    },
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "2860-2866"
    },
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "2922-2927"
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "function": "scsp_device::UpdateSlotReg",
     "case": [
      "0x12"
     ]
    },
    {
     "ref": "mame:src/devices/sound/scsp.cpp",
     "lines": "1000"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "LFORE set to 1 resets the LFO; writing 0 starts its operation.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2830-2832",
       "sha": "c6ec7d498e77ba4dae9231fa86d3001b0d6ba40d04989e0b7eb1e1af33774b7a"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "LFOF designates the LFO oscillation frequency.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2833-2834",
       "sha": "1ec0aa2e46bc565839b36b6203d87888777f446c02af2a3f07184dcde201181f"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "ALFOS sets the degree of amplitude modulation through the LFO, which produces a tremor effect.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2836-2840",
       "sha": "885e2a4dbf8280220ab05ae69a17cf1365c71b9f82e221e9bdbe2c6a02b7773d"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "ALFOWS and PLFOWS select the amplitude and the pitch modulation waveform.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2860-2862",
       "sha": "35339c5b82b7e1fe55ccb863d960c7a412b7b770c0fd4dbe67866a12cea0a3bd"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2864-2866",
       "sha": "379cbafe158e7a0e4fe1b402c3f0e6f709dd6167cdebe5945bda60b07d448e7b"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "PLFOS specifies the degree of frequency modulation through the LFO, which produces a vibrato effect.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2922-2927",
       "sha": "b6769ea0b3a3c0b8afc2713192329adc0ec7c4fcb7380ce43876a06317d17c11"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "The LFO fields can be written by the CPU.",
     "quotes": [
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2830",
       "sha": "1f25c8683a4ca98d047e7298d4fe484488629f72e4e0e3ea5a64acaba274bd96"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2833",
       "sha": "55dad29cccff687c08858f013fda5794f19a4f27b3295438e6ec0c6f8983a26b"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2836",
       "sha": "113601dbffc8109cc73286463d38f971db73c536172d6b9fc04f080ebe7f4b05"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2860",
       "sha": "a08ca4730543ddabc38cb6d946054536076597d249e6f3e79b329942afcaf4f7"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2864",
       "sha": "ccf27f7b4ffb6e447cf23af49b2d77935ce690762b79abdd9af41a567aec5894"
      },
      {
       "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
       "lines": "2922",
       "sha": "feb98454c2f32e82baea86076b1c8c55aae1d04c0075b2c7b18fc198f7ced656"
      }
     ]
    },
    {
     "n": "7",
     "on": "write",
     "of": "mame",
     "text": "MAME computes the pitch and amplitude LFO phase steps on a write, each skipped when its sensitivity is zero.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/scsp.cpp",
       "lines": "744-747",
       "sha": "23f9ed4500d9acd3d23fb857ce8e24e3843cd7f6da6e408ac8a253d3ee2fd76c"
      },
      {
       "ref": "mame:src/devices/sound/scsp.cpp",
       "lines": "561-567",
       "sha": "d4188aa3248ec76eb3165c2875b9601054ff1ebe5e57f5383ef8b979fa134e84"
      },
      {
       "ref": "mame:src/devices/sound/scsp.cpp",
       "lines": "1633-1636",
       "sha": "036411bf1afe268947147fcfaf1c7983908c910ea39d21a99b5d2e3b5b0d6846"
      }
     ],
     "vs": "extra"
    }
   ],
   "closed": [
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "2835",
     "as": "layout"
    },
    {
     "ref": "datasheet:SCSP-UserManual-1994.raw.txt",
     "lines": "2863",
