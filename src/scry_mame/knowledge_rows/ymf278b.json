       "sha": "9384db857505a523fdca411228e464eb72c18102f88d4f95d48bf66242619aca"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "With LFO reset set, a key-on clears the channel's LFO counter.",
     "quotes": [
      {
