       "sha": "77867165695650b660043e36f51f37d88313c63cf38a09e640c45845ef1842ee"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The output channel selects the pair of output samples the channel's left and right are added to.",
