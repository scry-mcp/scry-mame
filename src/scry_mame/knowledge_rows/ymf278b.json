       "sha": "0db65570dee5d1f322e369a3786f5b315347d91d6c6ad687ae4bc3eb319421d3"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The key handler marks a key-on or key-off pending, and the next prepare starts the attack or the release when the key-on bit changes.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
