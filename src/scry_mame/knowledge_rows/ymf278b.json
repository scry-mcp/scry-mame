      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "130-138",
       "sha": "bc34b761fbd9e3d9b8ae72c5b5f9e705d459f5f4ec4cbe687345752f7a286763"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The panpot is signed: 0 to 7 fades the left side, -7 to -1 the right, and -8 silences both.",
