       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.h",
       "lines": "189",
       "sha": "003fd73344a33bfbf5c2c5518459812484788e9d26d7821374a64f17db130983"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write stores the byte in the register array.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "703",
       "sha": "aeaa6d4d2be3cb5c7e36752ccbae4955f873707bf2598b4b42d0704d13a0e22b"
      }
     ]
    }
   ]
