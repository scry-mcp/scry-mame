  {
   "where": "maker",
   "gave": "A web search found no Yamaha page holding the YMF278B manual, only a product brochure."
  },
  {
   "where": "bitsavers",
   "gave": "The Yamaha components listing holds YMF262, YMF289B and YMF701, no YMF278B."
  },
  {
   "where": "archive-org",
   "gave": "The item yamaha-chip-jpn holds a 20-page Japanese scan of the same catalog."
  },
  {
   "where": "index",
   "gave": "datasheetarchive.com answered YMF278B with a search page that served no document list."
  }
