     "n": "1",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "Register 0x68..0x7F holds key on in bit 7, damp in bit 6, LFO reset in bit 5, output channel in bit 4 and panpot in bits 0-3.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.h",
       "lines": "194-198",
       "sha": "bf178f765ccdfe13e626ec9d7eed3f7d15c64a1411256d44de3eb021eda0cb4c"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write stores the byte and passes bit 7 to the channel's key handler.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "703",
       "sha": "aeaa6d4d2be3cb5c7e36752ccbae4955f873707bf2598b4b42d0704d13a0e22b"
