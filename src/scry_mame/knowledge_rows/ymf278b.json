   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "Register 0x08..0x1F holds the low eight bits of a channel's wave table number.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.h",
       "lines": "188",
       "sha": "dbe60df46ad8eef2b1bc2aaf8eb8dd1b5b24685b084f1f2c7a928d8dc9c294dd"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write stores the byte and then loads that channel's wave table.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "703",
       "sha": "aeaa6d4d2be3cb5c7e36752ccbae4955f873707bf2598b4b42d0704d13a0e22b"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "710-711",
       "sha": "08c20fa9b68c9c4966937ca373482eaa28b17b1fe56e9fe9665d8a3786f2e8d6"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "The write sets the load wait counter to 13 samples, which raises the LD status bit.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "1840-1843",
       "sha": "d08cca637578ca424f99a635a4c5f34c817b3af0b4347cf3e0990adaf3f504f1"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "1702-1703",
       "sha": "d581ec2f1c0947648748553642db6fad9ff76317dbe0b1e05f5c2cdc194d4572"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "The wait counter falls with each sample generated until it reaches 0.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_opl.cpp",
       "lines": "1938-1940",
       "sha": "b455281c086ae8ebb414565248eeabfc1a8a4b818caafbac635cb946fa2310e1"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The load reads twelve bytes at twelve times the number; from 384 up, a nonzero header moves the read to its bank.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "400-408",
       "sha": "1b7c7dff61a00ca7484c68f14a6f672b657cdf5b5353f1332e7f1e89d5e683f5"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The first byte gives the sample format in bits 6-7 and the base address's top six bits.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "411-414",
       "sha": "8140ac5ad5786315d1e613ccdcd8a8de2b91bb493b3a9f2dcd80067c568c2856"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The next bytes complete a 22-bit base address and the loop and end positions, the end negative.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "411-414",
       "sha": "8140ac5ad5786315d1e613ccdcd8a8de2b91bb493b3a9f2dcd80067c568c2856"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "415-416",
       "sha": "9fbf86e6c8a76ad5161b067c058a5b4a26e0884b05a118a2c180ffd989769c81"
      },
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "419-427",
       "sha": "6fb797efe3d22db74e9ac1dd67eb64c5d1f4ce54387ed06badfc16ff0de3a0c2"
      }
     ]
    },
    {
     "n": "8",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The last five bytes are written into registers 0x80, 0x98, 0xB0, 0xC8 and 0xE0 of the channel.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "429-434",
       "sha": "9a3371dda40fafa5798ce8685644118a1866d523298608cb6bd9c213ae95d482"
      }
     ]
    },
    {
     "n": "9",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The load resets the channel's envelope attenuation to 0x3FF.",
     "quotes": [
      {
       "ref": "mame:3rdparty/ymfm/src/ymfm_pcm.cpp",
       "lines": "436-437",
       "sha": "272be31ff79afe704e7e517af19ef2792b19c3d98dd39c4a4789bdd4996cfab3"
      }
     ]
    }
   ]
  },
