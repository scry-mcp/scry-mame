       "lines": "463-465",
       "sha": "3398e4a6bf2110f15f96264b54d7d155d527a9b68ac6982c320a41667eb125fd"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "With damp set, the channel decays at rate 48 to -12 dB and then at the maximum rate.",
