    },
    {
     "ref": "mame:src/devices/machine/z80sio.cpp",
     "function": "z80sio_channel::do_sioreg_wr0",
     "case": [
      "WR0_ERROR_RESET"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Command 6 is Error Reset; the capture's table row for it is cut after '(latches'.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10656",
       "sha": "eacd1b56c7d3bbd7eef4933f185e21583ad9fdb1209528482568c95bc0b4e156"
      },
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10671",
       "sha": "712bf4e558fe98a52ebe5f7d098f7a60ae5a67c95f91bd255115916374cdb0fd"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The Error Reset command, listed on the row 6 1 1 0, resets the error latches.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10656",
       "sha": "eacd1b56c7d3bbd7eef4933f185e21583ad9fdb1209528482568c95bc0b4e156"
      },
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10671",
       "sha": "712bf4e558fe98a52ebe5f7d098f7a60ae5a67c95f91bd255115916374cdb0fd"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Parity and Overrun errors are latched in RR1 until they are reset with the Error Reset command.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10671-10673",
       "sha": "fcbebb86f2423d75e814e1e74c0942fd59f58cbb61ed73ad97351cb8415e19ba"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "Using this method, parity errors occurring in block transfers can be examined at the end of the block.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10673-10674",
       "sha": "459b42d3a1e99a0fb5e1399334c6e2d16025e98784442d929bc1d2f07af04b08"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "mame",
     "text": "When WR1 selects interrupt on first character and RR1 holds CRC/framing, overrun or end-of-frame, MAME's Error Reset also advances the receive FIFO (its TODO questions this).",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/z80sio.cpp",
       "lines": "1681-1686",
       "sha": "1973ce3b96efd52a2b1d4be2a0223e529c9a9bed42a23aaa79927d5ec8c39183"
      }
     ],
     "vs": "extra"
    }
   ],
