     "function": "z80sio_channel::do_sioreg_wr0",
     "case": [
      "WR0_RETURN_FROM_INT"
     ]
    },
    {
     "ref": "mame:src/devices/machine/z80sio.cpp",
     "function": "z80sio_device::return_from_interrupt"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Command 7 is Return From Interrupt.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10675",
       "sha": "ae197e78aeb4ea44aadfeaa28815bfd7586cbc85ab06697637bdc5316289977f"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The Return From Interrupt command must be issued in Channel A.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10675-10676",
       "sha": "45984f43c3f020794e75f0ab83226412918d1adb16a09f8b6b731e18271e2eb0"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The Z80 SIO interprets the Return From Interrupt command in the same way it interprets a RETI command on the data bus.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10676-10677",
       "sha": "c92996bee8840db5205760602e65a413ecf0f685895dd2c05a127e128a4f6587"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "The Return From Interrupt command, listed on the row 7 1 1 1, resets the interrupt under-service latch of the highest priority internal device under service.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10657",
       "sha": "ed175a784ff3ac69ff3b6ea9f703c23ddc90ae98f25e263d7d944893628ea9c0"
      },
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10677-10678",
       "sha": "a22b9f4a4518074951dc5f25fda2ece0cde13f1317d98c1dc40a56ac2c268ca8"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "This reset allows lower-priority devices to interrupt through the daisy-chain.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10678-10680",
       "sha": "c669662cdc903ff68eaecfada296eaa959bce92bf4a4038a373505ab7893c316"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The command also allows use of the internal daisy-chain even in systems with no external daisy-chain or RETI command.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10680-10681",
       "sha": "010e22d1ad55ea250f422524ed220adfa728ba416eb9a4434407a6453b0325fd"
      }
     ]
    }
   ],
