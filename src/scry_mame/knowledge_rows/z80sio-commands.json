  {
   "key": "0x28",
   "name": "reset tx int pending",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:UM0081.raw.txt",
     "lines": "10655"
    },
    {
     "ref": "datasheet:UM0081.raw.txt",
     "lines": "10665-10670"
    },
    {
     "ref": "mame:src/devices/machine/z80sio.cpp",
     "function": "z80sio_channel::do_sioreg_wr0",
     "case": [
      "WR0_RESET_TX_INT"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Command 5 is Reset Transmitter Interrupt Pending.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10665",
       "sha": "9418e96e8fe4b1be3d49fa86c927d37f30e266b1f32469ffba1db4a0e21bf235"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "A transmitter interrupt occurs when the transmit buffer becomes empty, and only when the Transmit Interrupt Enable mode is selected.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10665-10667",
       "sha": "827c0b41bb774746be91e0e2b762a95407a77c76703e817971d6d74f3e331821"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "When no more characters are to be sent, command 5 prevents further transmitter interrupts until the next character is loaded or CRC is completely sent.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10655",
       "sha": "e97927c8c4860d330d6819467893d259a4f1cc8e3eda666bfc778ba172e1ef0d"
      },
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10667-10670",
       "sha": "d6266050930a38b3d1abaf70fe63c38f0961e3ec32c2fd6a68f100127b26305c"
      }
     ]
    }
   ],
