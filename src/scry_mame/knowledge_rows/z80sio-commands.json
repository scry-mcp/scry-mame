       "sha": "9e72e961d7349714bd24d611c9919aaaf02549f342e24a0ab41ac07738ed5944"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "mame",
     "text": "MAME's Reset Receive CRC Checker command also clears the receive CRC enable flag.",
