  {
   "key": "0x20",
   "name": "enable int next rx",
   "aliases": [],
   "regions": [
    {
     "ref": "datasheet:UM0081.raw.txt",
     "lines": "10654"
    },
    {
     "ref": "datasheet:UM0081.raw.txt",
     "lines": "10661-10664"
    },
    {
     "ref": "mame:src/devices/machine/z80sio.cpp",
     "function": "z80sio_channel::do_sioreg_wr0",
     "case": [
      "WR0_ENABLE_INT_NEXT_RX"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Command 4 is Enable Interrupt On Next Receive Character.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10661",
       "sha": "9692e26d0c35410affc175761481ec1488e023fe7b58139a52eabef77305a9ef"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "If Interrupt On First Receive Character mode is selected, command 4 (listed on the row 4 1 0 0) reactivates Enable Interrupt On Next Receive Character mode after each message.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10654",
       "sha": "ad68f38a2c6ad4277a5e7af0312c38de5d1c659fa0ee5eaf623f18ef58dbdc88"
      },
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10661-10663",
       "sha": "cf40e327d1aae0c83a88473e98fe94edec5d0721ed23fb08fa094ea01ca4ddcb"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "This sequence prepares the Z80 SIO for the next message.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10664",
       "sha": "de7e91d2b8b23ef13f1c068f4bdd815ff801bb07a276ee9879055feb1c99596c"
      }
     ]
    }
   ],
   "closed": [
