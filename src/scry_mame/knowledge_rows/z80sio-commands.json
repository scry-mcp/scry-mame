     "case": [
      "WR0_NULL"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Command 0 is the Null command.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10631",
       "sha": "a856a84c25de2018e54f0cd7ee24400561648a7df6df2639b68c58a9ed6dddd8"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The Null command, CMD2 CMD1 CMD0 = 0 0 0, has no effect.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10631-10632",
       "sha": "0de4d3f81b754f8f601826d951d1de32e6d1a25c8dacdfcdf9722e03bae90829"
      },
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10649-10650",
       "sha": "3e3ff52bfa0ac705a217c2780daaf9d3f618389db339527b38b0c823b5c49662"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Normally the null command instructs the Z80 SIO to wait while the pointers are set for the following byte.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10632-10633",
       "sha": "7e5294272cf771967aa1d7f008391ac60847f39154b876b2b31c6c347dc5d95b"
      }
     ]
    }
   ],
