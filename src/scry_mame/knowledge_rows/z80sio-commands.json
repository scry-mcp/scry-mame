      "WR0_SEND_ABORT"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Command 1 is Send Abort.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10634",
       "sha": "7f11d302c9439d9d0eaa9e56521bdca0156ce218786a41b7a12a17b7359b49d6"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The Send Abort command, listed on the row 1 0 0 1, generates a sequence of eight to thirteen 1s.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10634-10635",
       "sha": "11125427da437e82858b31b4f406503209ba4d11e6ff2878636491dfcad5eabc"
      },
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10651",
       "sha": "7f37b8a33c123c131525d8ca1812b065ffb30855d1efe2724a4d51684482968f"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "The Send Abort command is used only in SDLC mode.",
     "quotes": [
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10634-10635",
       "sha": "11125427da437e82858b31b4f406503209ba4d11e6ff2878636491dfcad5eabc"
      },
      {
       "ref": "datasheet:UM0081.raw.txt",
       "lines": "10651",
       "sha": "7f37b8a33c123c131525d8ca1812b065ffb30855d1efe2724a4d51684482968f"
      }
     ]
    }
   ],
