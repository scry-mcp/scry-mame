   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The channel ON/OFF register at 0008H starts and stops sounding for each channel.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "509",
       "sha": "427c7d81c5a4a61f5cb798d7c0b6093f4a3a00c18c208332d7883252abe6030c"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "667",
       "sha": "aefb0cf58bd62fc2de51cc5c239165a375801c5b6ba5a3d83b0f33761a31b9a9"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "672",
       "sha": "fad12ce75a67eb86699d3c434ea6207610c57ccfc89f96d086901b38b7ed6e9a"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The control register has priority: this register acts only while the control register sets the sounding state.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "673-674",
       "sha": "fdb3401389bbadfc6f838cd939d6dfd11695f3eef5faf574ca67cbd790c4ddb0"
      }
     ]
    },
    {
     "n": "3",
     "on": "bit 0",
     "of": "doc",
     "text": "Bit 0, stored, corresponds to channel 1 and bit 7 to channel 8.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "675",
       "sha": "622bd19120761cc23ab4db425da077bab4f288b7d7382317125c20aefd2598d4"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "A write to 0008H sets the start and stop state of each channel.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "509",
       "sha": "427c7d81c5a4a61f5cb798d7c0b6093f4a3a00c18c208332d7883252abe6030c"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "667",
       "sha": "aefb0cf58bd62fc2de51cc5c239165a375801c5b6ba5a3d83b0f33761a31b9a9"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "672-675",
       "sha": "f7dbc7f416c14c996abf2fa912284049081e2489e6618015f7e08864b1fe2c6a"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "mame",
     "text": "MAME enables a channel when its data bit is 0 and returns a stopped channel's read address to its start address.",
     "quotes": [
