  {
   "key": "0x02",
   "name": "FDL",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:RF5C68A.raw.txt",
     "lines": "515"
    },
    {
     "ref": "datasheet:RF5C68A.raw.txt",
     "lines": "612-613"
    },
    {
     "ref": "datasheet:RF5C68A.raw.txt",
     "lines": "629-633"
    },
    {
     "ref": "datasheet:RF5C68A.raw.txt",
     "lines": "642-654"
    },
    {
     "ref": "mame:src/devices/sound/rf5c68.cpp",
     "function": "rf5c68_device::rf5c68_w",
     "case": [
      "0x02"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "FDL data controls the address counter that says which waveform memory address is read while the IC sounds.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "515",
       "sha": "0350e30844ba709088b64f28848088e95b32caa3b4b968d9c72adb8aadeeec86"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "629-632",
       "sha": "8abdfc0969ad1f2529b262118be6f1b045b6c4f8cdf33cc98aa21c5ca8c2fe50"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "Setting bits of FDL changes the address increment of one sampling time, as the next page's table shows.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "631-632",
       "sha": "1a3aa0770d36d149e76905b7917f39ba7d095f09aa5754ced455c804a594efc7"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The FDL table weights bit 7 as 2^-4 down to bit 0 as 2^-11; the capture's exponents are doubtful.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "642-650",
       "sha": "f6075c7de7d5b0fc1038a56bce569d56374edb2491e20832c3ce260a73f97ecb"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "With only bits 4 and 3 of FDL set, the address is incremented by 2^-7 + 2^-8 counts in one sampling; the exponent glyph is doubtful.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "651-654",
       "sha": "4b324e1e21f20a584726c82ee1d2803547b8edadb223c8c71f47d41713277c2b"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "A write to 0002H stores the FDL data.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "515",
       "sha": "0350e30844ba709088b64f28848088e95b32caa3b4b968d9c72adb8aadeeec86"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "612-613",
       "sha": "5e9a5148b3a9a1c6fa9487856a63bfd3dd02711e3d83ceb2fc28e467c2c5b539"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "629-632",
       "sha": "8abdfc0969ad1f2529b262118be6f1b045b6c4f8cdf33cc98aa21c5ca8c2fe50"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "mame",
     "text": "MAME keeps the increment as a 16-bit step, with FDL as its low byte and FDH as its high byte.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/rf5c68.cpp",
       "lines": "234",
       "sha": "1d14a1153165d05bc1ab226b55fe621e50eaa4f4f522b8e73cb552407ef1785e"
      },
      {
       "ref": "mame:src/devices/sound/rf5c68.cpp",
       "lines": "238",
       "sha": "22fd60749de7f8f7452e659ff2b399ad5347899efc38eb2dc3f2c87775c52fd3"
      }
     ],
     "vs": "extra"
    }
   ],
