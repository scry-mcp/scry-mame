  {
   "key": "0x01",
   "name": "pan",
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:RF5C68A.raw.txt",
     "lines": "516"
    },
    {
     "ref": "datasheet:RF5C68A.raw.txt",
     "lines": "637-641"
    },
    {
     "ref": "datasheet:RF5C68A.raw.txt",
     "lines": "655-664"
    },
    {
     "ref": "mame:src/devices/sound/rf5c68.cpp",
     "function": "rf5c68_device::rf5c68_w",
     "case": [
      "0x01"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "PAN data is the internal memory at address 0001H that separates a channel's output into left and right.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "516",
       "sha": "437b6591941f6bef2121c1d48748bc67d80546fc6e6fb8ca8a7c02abbc14a2d7"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "637-638",
       "sha": "53d7a5abedc1e416f8ea66e32680744fd0df091808828352ac1194a29ab42b32"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "655-656",
       "sha": "cbe548e150523b831368062e53aa987a208598225ce3eae41592413af5ac9554"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The higher four bits of PAN are the coefficient of the right output and the lower four bits the left.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "657-658",
       "sha": "4e4ca149cc35b67931595f9c816317386345315c7f7d9917f5d70f44e585defb"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "A write to 0001H stores the pan byte.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "516",
       "sha": "437b6591941f6bef2121c1d48748bc67d80546fc6e6fb8ca8a7c02abbc14a2d7"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "637-638",
       "sha": "53d7a5abedc1e416f8ea66e32680744fd0df091808828352ac1194a29ab42b32"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "655-658",
       "sha": "ce53509146e1ef483c12034bbd2c18b2cac09f7b6d597095d6ae6c48dc38c8df"
      }
     ]
    }
   ],
