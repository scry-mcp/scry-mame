   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "ST data is the internal memory at address 0006H, the higher eight bits of the address a channel starts reading at.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "511",
       "sha": "6dddb310a15ff73ae893b21fa2d3e4136a33d6faaca88b46610cafd71b6c15ba"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "599-603",
       "sha": "3b9e547137440ced5d5123e8b4ea1003bef75e1fcd2bedba7f1c1fc8d0e76926"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The lower address bits are set to 00H when the channel starts sounding.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "601-603",
       "sha": "0b79d3d0bcc393f7cb9cae75d11d1319a0194452e00c5eb84925d7941828d14a"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "A write to 0006H stores the ST data.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "511",
       "sha": "6dddb310a15ff73ae893b21fa2d3e4136a33d6faaca88b46610cafd71b6c15ba"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "599-603",
       "sha": "3b9e547137440ced5d5123e8b4ea1003bef75e1fcd2bedba7f1c1fc8d0e76926"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "MAME leaves the read address unchanged when ST is written to a channel that is enabled.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/rf5c68.cpp",
       "lines": "251-252",
       "sha": "ed343eaef03d28fa4f56120792e2635c68dc6c237d8171010d75d043aebb4a40"
      }
     ]
    }
   ],
   "closed": [
