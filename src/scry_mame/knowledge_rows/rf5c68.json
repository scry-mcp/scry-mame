   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "ENV data is the internal memory at 0000H in the address map; the starred memories are set per channel through the control register's bank.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "517-519",
       "sha": "477c9908ebb65a383a722553ecfa314b959d4a3f193bd33501f95b705a2f3bd3"
      },
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "665-666",
       "sha": "6068387fb2e38b679de9c10965a5a4075859bcaa661a491ce9cb75a0cf2154dc"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The envelope data multiplies the waveform data of a sounding channel to vary its amplitude.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "668-670",
       "sha": "4af79bf8a6d04b8a8caa1929f1886da5bed630003aaa853f4c4920ec6bf14acd"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Bit 7 of ENV data is the most significant bit and bit 0 the least.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "671",
       "sha": "1ba70dad52e89ab75e25f74466558f8e5273fd4bd2beb4b2199257836499e462"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "A write to 0000H stores the envelope data.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "517-519",
       "sha": "477c9908ebb65a383a722553ecfa314b959d4a3f193bd33501f95b705a2f3bd3"
      }
     ]
    }
   ],
