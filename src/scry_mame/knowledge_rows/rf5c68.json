      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "With only bits 4 and 3 of FDH set, the address is incremented by 2^1 + 2^0 = 3 counts in one sampling.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "627-628",
       "sha": "9b43be1e87cbb3bc099009a62da29ffe2936369719df6102b0ce9b413f4da5af"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "A write to 0003H stores the FDH data.",
     "quotes": [
      {
       "ref": "datasheet:RF5C68A.raw.txt",
       "lines": "514",
       "sha": "4d1610870e64fb13d63f4bd08e224bd21a9170b5812f6bea96c18a252c5d4c14"
