     "n": "101",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "MAME's vdp_r answers byte offsets 0x04 and 0x06 alike with the word that ctrl_port_r builds.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1318",
       "sha": "e6943f4dd1aca982e94b629815b8ee80db7416b96b72dc8532e82f6689b9ae30"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1330-1333",
       "sha": "f53723696bedf64c135736892f2fdca7dab9d132a7adc7dacf223907858e70f7"
      }
     ]
    },
    {
     "n": "102",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "Bits 13, 12, 10 and 9 (FIFO empty) read 1, and bits 8 (FIFO full), 6 (sprite overflow) and 1 (DMA in progress) read 0.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1095",
       "sha": "d572e08a799f6b21a1e127932302884461763fa47d62c2f24244879e4e380e0f"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1098",
       "sha": "6984ed8e9c3992a5c37f1de31e540c00570a234ebe46026ae1cdbea800bdf41f"
      },
      {
