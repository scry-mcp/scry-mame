   "rows": [
    {
     "n": "101",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "MAME's vdp_w answers byte offsets 0x00 and 0x02 alike by calling data_port_w, after copying a one-lane write onto the other byte lane.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "897-900",
       "sha": "5d594b17f6ee24d9e01a877b1b433b0b3c02b81bbf2543c47befb1a8bfdecc23"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "901-911",
       "sha": "541ce343012fbc52a3a1b3099ee999f8c356725668260b1b797c4fa2c6e7a877"
      }
     ]
    },
    {
     "n": "102",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A data port write first cancels a pending second command word.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "488",
       "sha": "d1f4c856b240c8e25541d82d345d018259be9a209385517f2a974909fb995940"
      }
     ]
    },
    {
     "n": "103",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "With a fill pending, the low byte of the written word is stored in VRAM at the address register without advancing it.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "501-512",
       "sha": "d29ad94d67c2edbca568087cf9282cc70bfb542169ee1bd307a0c0205619b390"
      }
     ]
    },
    {
     "n": "104",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "Then the high byte is stored length plus 1 times, the address advancing by register 0x0F each time, and registers 0x13 and 0x14 are cleared.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "514-525",
       "sha": "b7dd9c6206740d9609f1480f12955d1340e464e33fc8f474441e8c1a837660f1"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "528-529",
       "sha": "3d5e892a767ae492f606f8791d8a6f97637dc3b0c71ab9b8ed3e9f447361ef30"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "417-421",
       "sha": "5e59f44f31a7e616ca5fb5053212e9a61c2e4a7d1dc4e1521086ad4962ee274d"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "128",
       "sha": "a9fcf71128b54c58e7d0462e62014effaa3a0fc0c746962441965c3806c1ec98"
      }
     ]
    },
    {
     "n": "105",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "With no fill pending, code 0x01, 0x03 or 0x05 hands the word to the VRAM, CRAM or VSRAM write routine.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "501",
       "sha": "ae04fa3b56d4d80a2dc045a43d786d9da4e34879f3a496f9d22aed824c26640c"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "535-538",
       "sha": "193902eb70608250ded451c7f38a507ed5bccc656c98d1b7724c6ebfe224b015"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "544-546",
       "sha": "71d4993f7dbba620f6b3cfbfe89960e9d3939cb20cef7f5a6c1b1727a4a85565"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "548-550",
       "sha": "c6efa854240c48e3d3972b15b8643debffe99941058bf8b813121f2e5f4b128f"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "556-558",
       "sha": "4c49833ef308c13a4e6ed8c0a4341119f7df4cf4e462462d5cc8525cf36672b4"
      }
     ]
    },
    {
     "n": "111",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "Each of these writes then adds register 0x0F's value to the address, wrapping at 16 bits.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "128",
       "sha": "a9fcf71128b54c58e7d0462e62014effaa3a0fc0c746962441965c3806c1ec98"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "446",
       "sha": "7a35ee2e4109b8ab842bbf773bf800b2e986fcfebce0a25fbf43da4fb04a0650"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "455",
       "sha": "7a35ee2e4109b8ab842bbf773bf800b2e986fcfebce0a25fbf43da4fb04a0650"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "483",
       "sha": "7a35ee2e4109b8ab842bbf773bf800b2e986fcfebce0a25fbf43da4fb04a0650"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "419-420",
       "sha": "7fd7dc7534297a67331a0c0f30f072c88ce5fd30ecdfb60e7e1df48e26565b9a"
      }
     ]
    },
    {
     "n": "112",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A VSRAM write stores the word at the address register in the vertical scroll RAM.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "451",
       "sha": "db00f50d7b6493ddccce4579a3573f8019a763948849be93fb97b28bd68ae49b"
      }
     ]
    },
    {
     "n": "106",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A VRAM write at an odd address swaps the two bytes of the word before storing it.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "430-435",
       "sha": "d409af2d968e216370a60d4d88ed6f0198bbc2e66237f5b187129e8ab8d0e4f2"
      }
     ]
    },
    {
     "n": "107",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A VRAM write inside the sprite attribute table also stores the word in an internal copy; the source comment says a change of the base address does not invalidate it.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "425-428",
       "sha": "410d17f13a876d04420632bf4d622f03a0e3d1ce96e00bc3d29d23a296ed35cb"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "437-443",
       "sha": "4f28757a40de69c9b18bfb737a881b4a65e1f96321d620141095993556101dfd"
      }
     ]
    },
    {
     "n": "108",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A CRAM write stores the word in the entry at the address register and, when m_use_cram is set, derives a palette lookup entry from three bits per channel.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "458-466",
       "sha": "2e368c22ebd1f103811afdea97996f05221276f976ba42ca3bfb249900159b4b"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "481",
       "sha": "234358c7b61a4a4888ca0f547031385a42dbd5bac32701bb9b0e569405724387"
      }
     ]
    },
    {
     "n": "109",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "With m_use_cram set, an external palette and a base other than -1, a CRAM write sets three pens at offsets 0, 0x40 and 0x80, with flags 0, 0x200 and 0x400.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "463-474",
       "sha": "de1114e8b53ddf06233e1d3d5203127dfbd53e6e3b4bf356b394a22b0a366dcd"
      }
     ]
    },
    {
     "n": "110",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "With read code 0x00, 0x04 or 0x08, or an undefined code, a data port write is only logged.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "540-542",
       "sha": "79ba9c16989da9455c029efd27a4d54503fe1995b0c17376564d6e28b1864afb"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "552-554",
       "sha": "2a5f0f59018544f54b855d8c48690beb091c7c36da9766e4e1aea9fb2fed16f9"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "560-562",
       "sha": "12db5acdd4fa342d52cb4ff4135162113c95f3e4b27f7c902766d18658ce399a"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "564-566",
       "sha": "46ae3a92b1eadfd4822ac22c175a863288ae1fc374a0e050a21f1d7a6bda2d24"
      }
     ]
    }
   ],
