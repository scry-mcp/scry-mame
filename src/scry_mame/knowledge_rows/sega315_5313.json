       "sha": "b15b69588bb58138b98a9cba1dc0d9bc315c34b77e038f453ab3acd4ec10e2b6"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1105-1108",
       "sha": "76fe295e183d0c353480b7c4ab16722933fb6aa84a958e086ccdf9fd471a8c4b"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1147",
