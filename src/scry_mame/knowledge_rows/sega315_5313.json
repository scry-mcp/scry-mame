       "sha": "03cb775d8a169a96dd500d60a2f7796f3827211f0a92372b84a0a87207781b4a"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1137-1141",
       "sha": "3e0c07d6fa6bfb41bee25da38358d67e7fe428a138bbeebe76e3915d3c4d914f"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1143",
       "sha": "f4e3118c9d77dd13f3af2cecd1b23ef681874289fd838d1cc557ad6b9a527755"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1148",
       "sha": "84d4dd0e57af613fa587e34b3080123c73c8034e734363516bcae02ec49a8815"
      }
     ]
    },
    {
     "n": "103",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "Bit 7 is m_irq6_pending, bit 5 is m_sprite_collision and bit 0 is m_vdp_pal.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1142",
       "sha": "b165b2c24e993b92249b3831e34fc5fe25e122fd36bbe7390bbcfb4a8ac81deb"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1144",
       "sha": "ce0ee039021ca77a1343e93f3faf5dc1bed1cdbcdf966f685d881ff67f0f02c0"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1149",
       "sha": "534fa6d1c76875bcb81f6bab9fe098918c7741f6575a2d5efb85001f9e044a04"
      }
     ]
    },
    {
     "n": "104",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "Bit 4 is m_imode_odd_frame inverted when bit 0 of m_imode is set, and 0 otherwise.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1096",
       "sha": "8fa4fe1ba63cbc583b815dcd3836f6c476a1cedad8f72d41972539b8fe0c3be1"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1103",
       "sha": "36de0c26ae10e45adbc9b6e8207841905eef01627828486db2657d880d2e9510"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1145",
       "sha": "2d85d3b988d78d73ea2a1ea8f0508f0cfb8fae4986cf071d832303a7b744aee4"
      }
     ]
    },
    {
     "n": "105",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "Bit 3 is m_vblank_flag, forced to 1 while bit 6 of register 0x01 is 0.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "78",
       "sha": "89d393a6163a6f37d235143c5e4ed63686db607d3202c9ec7f71cdbf42d2aad8"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1099",
       "sha": "7c1ebc3c2dc44fdea9a7871c2994bce57077f9fe6983d7cdafe6041bf2eac43d"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1111",
       "sha": "9ad4f58ae53e0b06001596be79e4f81033fc8f9fa783d85c3b2b24d64bfdb618"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "1146",
       "sha": "f6b7663a9008ce4d6f5bd319e7a34c09cc6c475b9ad20310c571463eab07af12"
      }
     ]
    },
    {
     "n": "106",
     "on": "read",
     "of": "mame",
     "vs": "extra",
