 "title": "The Capcom QSound command and DSP registers",
 "kind": "register",
 "scope": "qsound",
 "covers": "the host's command data and address offsets and the DSP command words for echo feedback, reverb end position, delay update and the next state, as MAME's two QSound devices handle them; no official document was found",
 "source": "emulator",
 "searched": [
  {
   "where": "mame-header",
   "gave": "The headers of qsound.cpp and qsoundhle.cpp name the chip as Capcom's QSound DL-1425, describe its DAC, and cite a die map at siliconpr0n, never a datasheet."
  },
  {
   "where": "maker",
   "gave": "A web search for a Capcom QSound or DL-1425 manual found no page of Capcom or QSound Labs holding one."
  },
  {
   "where": "bitsavers",
   "gave": "Searching the site found two VIA codec datasheets licensing QSound audio effects, no QSound chip document; the components listing answered HTTP 403."
  },
  {
   "where": "archive-org",
   "gave": "A search for DL-1425 or QSound returned 82 items, all QSound Labs software, demos and game images, with no datasheet."
  },
  {
   "where": "index",
   "gave": "datasheetarchive.com answered DL-1425 with five Amphenol connectors and no QSound document."
  }
 ],
