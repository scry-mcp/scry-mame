 "dictionary": "upd7759-commands",
 "title": "The uPD7759 block headers in its speech data",
 "kind": "command",
 "scope": "upd7759",
 "covers": "the block header bytes the uPD7759 decodes from its speech data, as MAME's state machine reads them",
 "source": "emulator",
 "searched": [
  {
   "where": "mame-header",
   "gave": "The comment of upd7759.cpp lists the five header forms and cites no document; its own TODO says low-level emulation is missing."
  },
  {
   "where": "maker",
   "gave": "NEC's 1992 data book and 1985 product description give pins, timing and slave mode, and no byte format of the speech data."
  },
  {
   "where": "bitsavers",
   "gave": "Hosts those NEC documents and the uPD7755 and uPD7756 user's manual; none lists the header bytes."
  },
  {
   "where": "archive-org",
   "gave": "Holds a copy of the same data book; nothing else was looked for there."
  },
  {
   "where": "index",
   "gave": "Web searches for uPD7759 data sheets gave the same NEC pages and mirrors, none with the header bytes."
  }
 ],
 "engine": [
  "read_byte",
  "update_adpcm"
 ],
