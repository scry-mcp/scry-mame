     "n": "102",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "The count state reads one byte, from m_fifo_in in slave mode or from read_byte at m_offset in stand-alone mode, and sets m_nibbles_left to that value plus 1.",
