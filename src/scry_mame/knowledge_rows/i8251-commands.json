   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The RTS output is a general-purpose, 1-bit inverting output port, normally used as Request to Send; it is set low by programming a bit of the command instruction.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "250-255",
       "sha": "f178065f0b04743041b64b73b671da6ddec70cf0dac738ab47eb064cede93f68"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Request to send: a \"high\" bit forces the output to a value the capture garbles; RTS is set \"low\" by programming the command bit.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "905-907",
       "sha": "189ddc0bc8f01f8a5a74dce458ce6516a9d2110ee70f2a83aad07fea75ab70f6"
