   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The command instruction figure has a line of bit labels that the capture garbles; only IR, RTS, ER and SBRK are legible.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "882-883",
       "sha": "a34a252d5f4622ceaf34311032b8b04e5122182fd5e6b628ed0b512795a5323f"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Transmit enable: 1 enables the transmitter, 0 disables it.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "887-889",
       "sha": "160ea97ce2950bb894c2d4591f76b8796dfff52646373c8d23260340910fb052"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "Data terminal ready: a high bit forces the DTR output to zero.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "890-894",
       "sha": "33758cb8c671538780bccc022aae5c6e4eee4717ed0f92fb31d5f27ed32cf1b9"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "Receive enable: 1 enables the receiver, 0 disables it.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "895-897",
       "sha": "b4dd9cefc55242d3e4c679d9b2e5661e5061a83442e42530c2184f2febeedd3a"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "Send break character: 1 forces TxD low, 0 is normal operation.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "898-901",
       "sha": "34a30b54ad8016ee6dfeda18b05351eb39c4f31a82248055c2cdedb729bcdda7"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "Error reset: 1 resets the error flags PE, OE and FE.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "902-904",
       "sha": "7d58b8e4d4098e60c76f61fbb0dd265972c242a182d087c5dd8f869a558abe56"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Error reset must be performed whenever RxEnable and Enter Hunt are programmed.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "917",
       "sha": "d103187f2cf745ae553d39e30bbf0a9f82821a871f2a369af8e6d4ebe0e067b8"
      }
     ]
    }
   ],
