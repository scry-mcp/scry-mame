   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "A command reset operation is one way to put the device into the Idle state.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "167-168",
       "sha": "72de47c9469f2be82f89b1b0f010b28a6e09c2fb51d18f448024c86f8552a1b0"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A command reset operation also puts the device into the Idle state.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "167-168",
       "sha": "72de47c9469f2be82f89b1b0f010b28a6e09c2fb51d18f448024c86f8552a1b0"
      }
     ]
    },
    {
     "n": "103",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "2",
     "text": "On a command reset MAME makes the next control word a mode instruction; its comment says the datasheet means this, not a complete chip reset.",
     "quotes": [
