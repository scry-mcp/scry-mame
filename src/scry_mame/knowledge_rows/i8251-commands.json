    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "An ENTER HUNT command has no effect in the asynchronous mode of operation.",
     "quotes": [
      {
       "ref": "datasheet:8251A.raw.txt",
       "lines": "773-774",
       "sha": "363830fd309dceabfab31137f00c912d79de41d8828f0967ebd0eee142b58a88"
      }
     ]
