 "entries": [
  {
   "key": "0x00",
   "name": "status",
   "access": "read",
   "aliases": [
    "voice busy"
   ],
   "regions": [
    {
     "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
     "lines": "2085-2093"
    },
    {
     "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
     "lines": "2389-2403"
    },
    {
     "ref": "mame:src/devices/sound/okim6295.cpp",
     "function": "okim6295_device::read"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The RD input outputs the busy state of channels 1 to 4 on the data bus, and a high level indicates busy.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "2088-2090",
       "sha": "7f428ab27b3e2896580329b48d6561126dc5cc8a618be938f44b1a6f048ab95e"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "While CS and RD are low, a read outputs the busy state of channels 1 to 4, and a channel's bit is high during synthesized playback.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "2390",
       "sha": "a0faa7cfc01efdf8fc5e4e94940fdb862601a4582dbae78d72c8b83a163dd77c"
      },
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "2398-2400",
       "sha": "43677a5ceca68ce7a41f1efa8d63e830abf13ff18010a96be2d46b6864c48d1f"
      }
     ]
    },
    {
     "n": "101",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "The upper four bits of a status read are 1.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/okim6295.cpp",
       "lines": "216",
       "sha": "068f3ac427b00e45a4416d9fbdf1e0ee06a43485f86fd542e94c46512e5f0ddc"
      },
      {
       "ref": "mame:src/devices/sound/okim6295.cpp",
       "lines": "224",
       "sha": "882101dd8697a52e0480af0873d4640b6bb8b487665fdc6013a1e87120badb76"
      }
     ]
    }
   ],
   "closed": [
