     "n": "101",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "When both type bits of register 0x17 are set, handle_dma_bits takes the branch that does the copy.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "838-846",
       "sha": "eded807fc3f3a12a8f8a2af0f2d50cc817bfaae1c098a3382ced2cba4ca8b146"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "151",
       "sha": "c27f9842e1a9ee0219874ce775d71620d65b545989cc1482fc73331e7b65c50a"
      }
     ]
    },
    {
     "n": "102",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A code with bit 4 set, or whose low four bits are 1, allows the copy; any other code only prints a debug message.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "840",
       "sha": "7fadc362c16fbd2796e450d14f74b4f172bcfefbe056f8f1ebf38009484e8d39"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "848-851",
       "sha": "b769dbc218dd213bb8e1c975ede1c57694d46581723712a31fd47ddc6c435514"
      },
      {
       "ref": "mame:src/devices/video/315_5313.h",
