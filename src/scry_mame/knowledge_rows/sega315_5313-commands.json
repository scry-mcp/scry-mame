  {
   "key": "0x80..0xBF",
   "name": "VRAM fill",
   "regions": [
    {
     "ref": "mame:src/devices/video/315_5313.cpp",
     "lines": "822-837"
    }
   ],
   "rows": [
    {
     "n": "101",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "When the type bits of register 0x17 are 2, handle_dma_bits takes the branch that arms a fill.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "822-825",
       "sha": "c1206859e0fb3a8c85ba67a54640b032f64ab32ebcd5a956f605d300393b8b15"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "827-831",
       "sha": "52a16d029425ff5c7bab56231cd333e6944a1132641084d68418651701786f56"
      }
     ]
    },
    {
     "n": "102",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "With a code whose low four bits are 1, 3 or 5 and bit 4 of register 0x01 set, the fill is armed and the length registers' value is kept.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "824",
       "sha": "b904c135d6c3682e4d78c4ebea83deee9c2c4d894aa76a903fff1d1384693d6d"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "827-831",
       "sha": "52a16d029425ff5c7bab56231cd333e6944a1132641084d68418651701786f56"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "80",
       "sha": "6163f2c0e99eb7fd80a4919d99f0097c2f40108055734610aa3dcc8f137aa2f9"
      },
      {
       "ref": "mame:src/devices/video/315_5313.h",
       "lines": "140-143",
       "sha": "1cafae65f76969f4cd571a917f4f935793ce457a3c460d77ed22f42d5ca13cd4"
      }
     ]
    },
    {
     "n": "103",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "Any other code only prints a debug message.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "833-836",
       "sha": "f9f90f4f28d2b0f96e55197061f000fea876178c33c7b83c4ada8e4631f745d1"
      }
     ]
    },
    {
     "n": "104",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "The next data port write does the fill: its low byte goes at the address, then its high byte length plus 1 times.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "501-512",
       "sha": "d29ad94d67c2edbca568087cf9282cc70bfb542169ee1bd307a0c0205619b390"
      },
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "514-525",
       "sha": "b7dd9c6206740d9609f1480f12955d1340e464e33fc8f474441e8c1a837660f1"
      }
     ]
    },
    {
     "n": "105",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A control port write cancels an armed fill.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5313.cpp",
       "lines": "858",
       "sha": "a28dca754df44868e5e3b31fbb8e686c8f223367dd5fa47e6a2514e8656af9a3"
      }
     ]
    }
