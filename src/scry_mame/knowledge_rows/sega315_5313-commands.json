       "sha": "7c2673962ae3e9b49e6985208238ab76c865cf5360379d12338f50af6b9daab9"
      }
     ]
    },
    {
     "n": "103",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "With bit 4 of register 0x01 set, insta_vram_copy copies the length in bytes from the VRAM byte address of registers 0x15 and 0x16.",
