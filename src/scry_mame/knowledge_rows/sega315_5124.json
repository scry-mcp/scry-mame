  {
   "key": "0x01",
   "name": "control write",
   "aliases": [
    "VDP command",
    "COMMAND"
   ],
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "368-369"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "373-389"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "390-401"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "409-415"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "416-417"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "418-426"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "1006-1012"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "1047-1049"
    },
    {
     "ref": "mame:src/devices/video/315_5124.cpp",
     "function": "sega315_5124_device::control_write"
    },
    {
     "ref": "mame:src/devices/video/315_5124.cpp",
     "function": "sega315_5124_device::load_vram_addr"
    },
    {
     "ref": "mame:src/devices/video/315_5124.cpp",
     "function": "sega315_5124_device::write_memory"
