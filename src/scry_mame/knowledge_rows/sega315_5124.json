   ],
   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "The Command Register is written twice in succession for all command operations.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "368",
       "sha": "979512642e1e5c1b00fda08df488ce048ebb4d0e5854e7474fc9f2dff7e59235"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The data register may be read or written any number of times in succession, depending on the operation.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "368-369",
       "sha": "167f8817d18406f95a8ce7a287aba062b3a1c94c4e724bf2ec44dc5f171dace5"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Two consecutive OUT or IN instructions to the VDP should be separated by at least a NOP, for Video RAM, Color RAM and the internal registers alike.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "377-379",
       "sha": "991f37e1425994727ea716f8fee31d0de7b6cce8b2b6014268349a0b8907ce2a"
      }
     ]
    },
    {
     "n": "4",
     "on": "bits 7-6",
     "of": "doc",
     "text": "A two bit mode field in bits 7 and 6 of the second COMMAND byte determines one of four operations.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "380-381",
       "sha": "8c11e2320b1ce4551cf8c79a3c42015633aa7d408a8df60b2289c02f87ecfe32"
      }
     ]
    },
    {
     "n": "5",
     "on": "bits 7-6 = 00",
     "of": "doc",
     "text": "Mode field 00 in the second COMMAND byte selects the Read 16 Kbyte VDP RAM operation.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "384",
       "sha": "4f26e87e5182b8dc4a153df00e1dc54e275701a5c40dbdeec946316f8574e937"
      }
     ]
    },
    {
     "n": "6",
     "on": "bits 7-6 = 01",
     "of": "doc",
     "text": "Mode field 01 in the second COMMAND byte selects the Write 16 Kbyte VDP RAM operation.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "385",
       "sha": "f1d12c46c13d113eb3543737b60263c82f165311f6acb06c0ce1dea288106527"
      }
     ]
    },
    {
     "n": "7",
     "on": "bits 7-6 = 10",
     "of": "doc",
     "text": "Mode field 10 in the second COMMAND byte selects the Write VDP Register operation.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "386",
       "sha": "e236f48fc8a22099d6b2cd7a62bd3a9dd60084aecf2b420644d81aa03b98fb5b"
      }
     ]
    },
    {
     "n": "8",
     "on": "bits 7-6 = 11",
     "of": "doc",
     "text": "Mode field 11 in the second COMMAND byte selects the Write Color RAM operation.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "387",
       "sha": "cd96fb2e2d26a4b5f27789f282f3c46a36cf4f7759d8890dcb53739b1c2ed323"
      }
     ]
    },
    {
     "n": "9",
     "on": "is",
     "of": "doc",
     "text": "To set up a read or a write of Video RAM the two COMMAND bytes have the formats shown after this line.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "388-389",
       "sha": "d0ae136520d49cc8363956350ee2449a540c6f45f58589f2d243857e02a59a45"
      }
     ]
    },
    {
     "n": "10",
     "on": "write",
     "of": "doc",
     "text": "To read VDP RAM the first command byte written to $BF is address bits A7 to A0 and the second is 0 0 followed by A13 to A8.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "391-395",
       "sha": "a2f040a5555f60135fff9c2b6aaf9c280c4d18b778bb52b6198f004320e26775"
      }
     ]
    },
    {
     "n": "11",
     "on": "write",
     "of": "doc",
     "text": "To write VDP RAM the first command byte written to $BF is address bits A7 to A0 and the second is 0 1 followed by A13 to A8.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "397-401",
       "sha": "8382736d15cfd30d1747344d06b0f8c7f5326403b9ac63c700e1af97aae42d1a"
      }
     ]
    },
    {
     "n": "12",
     "on": "is",
     "of": "doc",
     "text": "The COMMAND register format for writing a VDP register is shown after this line, and the registers are write-only.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "409",
       "sha": "7a0914df2b6324dba94e9ee9159b80c0cbbddd167eba42ec21a1e23766cb8001"
      }
     ]
    },
    {
     "n": "13",
     "on": "write",
     "of": "doc",
     "text": "To write a VDP register the first command byte is data d7 to d0 and the second is 1 0 0 0 then register number r3 to r0.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "410-415",
       "sha": "7d774216f0d71ffefea9b01d8e60938abf9cb1e6b75850e0238d8060b97f2d26"
      }
     ]
    },
    {
     "n": "14",
     "on": "write",
     "of": "doc",
     "text": "A register write has no write to the DATA register at $BE, since the data d7 to d0 is in the first byte of the COMMAND byte pair.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "418-419",
       "sha": "e4d9f55c5ce69d73d3b98029cd26abb7bd6ec44f3004b4a06c841c273c7d5049"
      }
     ]
    },
    {
     "n": "15",
     "on": "is",
     "of": "doc",
     "text": "The final command mode allows writing color values to the write-only VDP Color RAM.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "420",
       "sha": "944c6766c0fb3475da69f1cc0300d9f6cc2dc505849a9b1a8ff83bfbaf09488f"
      }
     ]
    },
    {
     "n": "16",
     "on": "write",
     "of": "doc",
     "text": "To write Color RAM the first command byte is 0 0 0 then address A4 to A0, and the second byte is 1 1 0 0 0 0 0 0.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "421-426",
       "sha": "2296d6bb05a76ca0b90c9254aaeb9fdedbb20b8aef9da2c16ed9e6023698d823"
      }
     ]
    },
    {
     "n": "17",
     "on": "is",
     "of": "doc",
     "text": "The Appendix A diagram shows a register write as a first byte of register data and a second byte 1 0 X X r3 to r0.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "1006-1010",
       "sha": "6b32b6eac1c741d5b11457bbb1d94a07c34271ba6e17d6b531530a6e46573fc9"
      }
     ]
    },
    {
     "n": "18",
     "on": "is",
     "of": "doc",
     "text": "Interrupts should be disabled first because the command register must always be written twice and register accesses are sequence sensitive.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "1011-1012",
       "sha": "94fcad744c75b9e32c020f3c001012788901ae202df08114a3d60a0f4f8a9f0a"
      }
     ]
    },
    {
     "n": "19",
     "on": "write",
     "of": "doc",
     "text": "Port $BF is written to send a VDP command.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "1047",
       "sha": "cda5653bd32a146000a290d7cc85d49d22667d1003f7e1e5e5e2588f5707de89"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "MAME completes a read command by loading the read buffer from video RAM at the new address and incrementing the address.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "879-880",
       "sha": "a2248d93a4769df1b911cd955165522e3478640f46ca4580dfb65ff4b1628aa6"
      }
     ]
    },
    {
     "n": "102",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "After a write to R0 or R1 with the matching interrupt flag already set, MAME clears /INT if the enable bit is 0 and asserts it if 1.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "918",
       "sha": "55f8fdaa3fa49fd3fe35efa67db937fa4fd7182ef6bf4c3a34b15d8321c4df63"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "931-932",
       "sha": "a1ea250409d0c72639916fea35c39b26afe95b717c0e5e2b57b46bba771a4226"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "934-937",
       "sha": "4d09b69d7a6c829e9fbea73e5e91cd93319418e855527b2ae28993e136e5101c"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "940-949",
       "sha": "a40b1e954a3c59554e310511b660f75f6b2513c3f262149d578e2f0d5327ce5f"
      }
     ]
    },
    {
     "n": "103",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "After a register write MAME sets the address mode back to 0.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "952",
       "sha": "f45b9b2c7a48578f2e546321b815fa4adae12d6855bcd0074ea810987aebd01f"
      }
     ]
    }
   ],
