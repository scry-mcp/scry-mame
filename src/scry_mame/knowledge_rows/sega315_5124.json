   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Port $7F is an input port that holds the horizontal gun spot position, and as an output port it is the PSG.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "734-735",
       "sha": "4596ba52bc6a7cd53481eaa99503fda353661d220d9ecb8376fc815f26a04a7b"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "A read of port $7F returns the eight bits H7 to H0 of the horizontal gun position.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "1030-1034",
       "sha": "3bae885b4048e12703c919191167729d098978328c7aa3a918c3a477b4665603"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "MAME latches the horizontal count in its hcount_latch function, and a read of the port returns the stored count.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "454-457",
       "sha": "c60f0e52cd9a8c823ec17356886277ddd4f582025d3db254dc1127b0374e39e2"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "450",
       "sha": "19289a4d34dfc4116c33304977fcd3cf50c223966a93dc15c26348ff3522597e"
      }
     ]
    },
    {
     "n": "102",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A read of the horizontal counter port in MAME also clears the latched flag.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "449",
       "sha": "fcf62c2ae79a42a280a06663814bc351a86247005e2473dd3a239a8e5a391cbe"
      }
     ]
    },
    {
     "n": "103",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "The stored count is the previous horizontal clock position minus 46, halved, in the low eight bits.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "464-468",
       "sha": "4b77f6bcf174ca34f7ddf313ea2f628fd4692d347044a625b0f287a7ee95e9d5"
      }
     ]
    },
    {
     "n": "104",
     "on": "place",
     "of": "mame",
     "vs": "extra",
     "text": "MAME clears the latched flag on the last line of the top border.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "682",
       "sha": "747233dcdb5bdf63477c87a4d9cb6a9151aa633f070b8eb7901de71149bc20fc"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "684",
       "sha": "fcf62c2ae79a42a280a06663814bc351a86247005e2473dd3a239a8e5a391cbe"
      }
     ]
    },
    {
     "n": "105",
     "on": "reset",
     "of": "mame",
     "vs": "extra",
     "text": "MAME's device reset sets the stored horizontal count to 0.",
     "quotes": [
