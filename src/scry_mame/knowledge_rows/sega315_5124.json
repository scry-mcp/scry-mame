   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Port $7E is an input port that holds the vertical gun spot position.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "733",
       "sha": "b038db26916a033798c9b214e51c2f6864237c4bd88ba9475370bcc52cc0b144"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "The vertical beam position is latched into a register, which is read at input port $7E.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "788-789",
       "sha": "42f265dbb65fa091ca5957f45572a0151abbef97f5a211591586ecf73d5936bc"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "A read of port $7E returns the eight bits V7 to V0 of the vertical gun position.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "1024-1029",
       "sha": "cfcab4a4c341ea80362b8145ea628040fbccf53fce7c3cd77f20dfd8510dd464"
      }
     ]
    },
    {
     "n": "101",
     "on": "read",
     "of": "mame",
     "vs": "differs",
     "row": "2",
     "text": "MAME's read of port $7E returns the line number worked out from the screen position at the time of the read.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "416",
       "sha": "b3b89b0c523826ad70ef28307180b01ec23611a70ccc23a0762f356edd108bab"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "427",
       "sha": "eeb17076434fdc2a294ff0e06118fd61b4d7a28a9d686fd24d5ae469f43210bd"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "433-443",
       "sha": "362baa44fadce7a1165d928d8fef9cfcd9a17db28a7e7c01bd62a25e34d44aba"
      }
     ]
    },
    {
     "n": "102",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "That line number is the screen line minus the first active line, and holds the previous line until a set position early in the line.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "433",
       "sha": "763bd79c5499472335f12dfca1111eb02bc74a759927895e7d8407fdc462b4a2"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
