   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "I/O location $BF is the COMMAND register for a write and the STATUS register for a read.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "365-366",
       "sha": "020e1ebedf563b043d84c60610fc536e36d34805921b51d1956389e7a062ad8c"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "When read with an IN ($BF) instruction, the command register functions as an interrupt status register and also clears interrupt requests from the VDP chip.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "470-471",
       "sha": "87a2903c9fef12bc3829818592b03a61d32ad3fd44c8940b6180a0a7be05a542"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "Reading the I/O port at $BF clears the interrupt request line from the VDP chip.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "147-148",
       "sha": "03201bb35cb95dea4f1a960193bb32a045681d1e45f004fb9856307141ed6cec"
      }
     ]
    },
    {
     "n": "4",
     "on": "bit 7",
     "of": "doc",
     "text": "Status bit 7 is 1 for a VBLANK interrupt.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "149",
       "sha": "4479afe33c3ad2c615da6141e999dcdb69d964518815a00e23534a9d442b3b88"
      }
     ]
    },
    {
     "n": "5",
     "on": "bit 6",
     "of": "doc",
     "text": "Status bit 6 is 1 for 9 sprites on a raster line.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "150",
       "sha": "7a50b124dbe356bf18bea2eb368ee88b2f93376850dedf80ad32f1074d87e864"
      }
     ]
    },
    {
     "n": "6",
     "on": "bit 5",
     "of": "doc",
     "text": "Status bit 5 is 1 for a sprite collision.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "151",
       "sha": "8997a68180ba94b605429be98c9123a4c3fcb189e8856ea6786d1cefc41a58a8"
      }
     ]
    },
    {
     "n": "7",
     "on": "bits 4-0",
     "of": "doc",
     "text": "Status bits 4 to 0 have no significance.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "152",
       "sha": "53e7a71efe1d5edd3d1e11db9cc24191931a91b9d1a73d52181eca8dc3c1f72d"
      }
     ]
    },
    {
     "n": "8",
     "on": "read",
     "of": "doc",
     "text": "An interrupt routine that reads the VDP status register disrupts the two byte synchronization of the command register.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "370-372",
       "sha": "4468090530fbed6648b722db08bb0d634cbebb5fd8d6fa2b91e42b4505474e1c"
      }
     ]
    },
    {
     "n": "9",
     "on": "is",
     "of": "doc",
     "text": "Port $BF is an input and output port for the VDP command and status register.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "737",
       "sha": "50473be8b3af5b396c8dc552d4d846b4b5ad8072647f4fb2012d6cd30b5f44ae"
      }
     ]
    },
    {
     "n": "10",
     "on": "is",
     "of": "doc",
     "text": "The Appendix A diagram shows the read of port $BF as the status: interrupt source (VBL), nine sprites flag, sprites collide flag and five unused bits.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "1002-1004",
       "sha": "9cb122310aa3d3afd6af1db3db6a4b4d0c952678db7f8996218e3f7cf980d8c8"
      }
     ]
    },
    {
     "n": "11",
     "on": "read",
     "of": "doc",
     "text": "The interrupt source, sprite overflow and sprite collision flags of port $BF are cleared by reading $BF.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "1051-1059",
       "sha": "b05ec05ffd9e6b6f362cbe7a3194a0f2ac317f3504cdf26cc99140be48989c41"
      }
     ]
    },
    {
     "n": "101",
     "on": "bits 4-0",
     "of": "mame",
     "vs": "differs",
     "row": "7",
     "text": "MAME's status read gives 1 in bits 4 to 0 once the flags are cleared; after sprite overflows they hold a value derived from the sprite indexes, ANDed together.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "754-755",
       "sha": "b5162b357c12c2b400e383e254bc16823be3d9524dc47e23ae6534c9b06b85f0"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "778",
       "sha": "11f664b3446409de904083f266ab1e6110f37a3e58e0616c1bea7fc9c7808a15"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "1160-1165",
       "sha": "21f538b2a50b4397a1308a9da0844a5e6f81ef03600aae77fa294ea451eb69ef"
      }
     ]
    },
    {
     "n": "102",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "MAME's status read first moves a pending line interrupt to the occurred latch once the beam has reached its position in the line, and clears that latch.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "736-741",
       "sha": "73a39311863ba68711730dfd86ad09d86617bbcda7280ba21e3a474a38ef64a8"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "771",
       "sha": "a21e13538ad988e3359e470e31c0aa2b23ab9ad592a5183de72041c1b943c7bb"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "777",
       "sha": "7f1f357d84168666ece8482a2077b834b27104cfa41b515950c887831efa0655"
      }
     ]
    },
    {
     "n": "103",
     "on": "reset",
     "of": "mame",
     "vs": "extra",
     "text": "MAME's device reset clears the vertical interrupt, sprite overflow and sprite collision flags of the status byte and sets the other bits to 1.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "2058",
       "sha": "fd90b0c84a726527fd1a8201c6b60928c671aa7e7f12fa48e977566172304246"
      }
     ]
    }
   ],
