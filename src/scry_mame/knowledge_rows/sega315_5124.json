 "entries": [
  {
   "key": "0x00",
   "name": "data read",
   "aliases": [
    "VDP data read"
   ],
   "access": "read",
   "regions": [
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "367"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "402-408"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "736"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "1041-1042"
    },
    {
     "ref": "mame:src/devices/video/315_5124.cpp",
     "function": "sega315_5124_device::data_read"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "I/O port $BE is the read/write DATA register.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "367",
       "sha": "cdeb10787d9611f6b38bd9db4e9a7e56d65cfb4158ef63d4aa8428a2d6f86f22"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "Data can be read at Input Port $BE.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "402-403",
       "sha": "9c79a9381a166c0b55dcabb363869abfaa8594b79841dcfa69cafd939f5f618a"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "Once the Video RAM starting address has been loaded, repeated accesses of the data port increase the address automatically by one byte for every access.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "404-406",
       "sha": "4491d9ef797f7e36c24cb7d4e31040e92f4af8ca971ca7bfea6dd2f88b1c0bcf"
      }
     ]
    },
    {
     "n": "4",
     "on": "when",
     "of": "doc",
     "text": "The autoincrement feature works only with all reads or all writes; changing from read to write or the reverse requires two writes to the command register to reselect the mode.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "407-408",
       "sha": "90536d232d10e47a84a392a25095fbc2a80d440505ae93a369c8f6fa84c59b13"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "Port $BE is an input and output port for the VDP data register.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "736",
       "sha": "3b813351c287480ea76ae39085dcbcbdb40d3094a79fb34d2ac04f338e6451dc"
      }
     ]
    },
    {
     "n": "6",
     "on": "read",
     "of": "doc",
     "text": "Port $BE is read to get VDP data.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "1041-1042",
       "sha": "08bdb480032635d20834d32499bfd6817dac2ae69c058b6596df214685746898"
      }
     ]
    },
    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "4",
     "text": "Each data port read in MAME, except a debugger read, reloads the buffer and increments the address register, whatever came before.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "705-713",
       "sha": "33dbfc7dea10e39a6e508efa28917f4bc8f9c3f165b72ee62b86235001eea1ed"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "714-722",
       "sha": "aafab67cf6b9a6634d5d8748d2c3d50337be4f8838b5c06ac707275d3aafacfe"
      }
     ]
    },
    {
     "n": "102",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "MAME's data port read returns the byte held in a buffer and, except on a debugger read, reloads it from video RAM at the address register.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "707",
       "sha": "0231dd4450c363538b617f1f96fdee9cd9727fdf1676c2cda7e2add969b04d4b"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "713",
       "sha": "a21e13538ad988e3359e470e31c0aa2b23ab9ad592a5183de72041c1b943c7bb"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "716",
       "sha": "2130957601d32a13e5a097fe5c1796e2d892de10938d86cbb9c2547bb015b839"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "721",
       "sha": "91a32d9cb4a6e9709994e5659f26edc34df01289cccce9158c63ae5aefc67555"
      }
     ]
    },
    {
     "n": "103",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A data port read in MAME also cancels a half-finished command write.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "711",
       "sha": "4cc166c8a08857beadfc941f5853c609e3a81fb3af71999b606b01f293437c6e"
      }
     ]
    },
    {
     "n": "104",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A data port write in MAME loads the byte a later data port read returns, the read buffer, with the written byte.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "707",
       "sha": "0231dd4450c363538b617f1f96fdee9cd9727fdf1676c2cda7e2add969b04d4b"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "721",
       "sha": "91a32d9cb4a6e9709994e5659f26edc34df01289cccce9158c63ae5aefc67555"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "807",
       "sha": "fbf64526816293faaccedf81671cd429cc5c75620a91915d2ec10c82ca56eb85"
      }
     ]
    },
    {
     "n": "105",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A completed command pair that selects read mode loads the read buffer from video RAM at the new address in MAME, and increments the address.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "707",
       "sha": "0231dd4450c363538b617f1f96fdee9cd9727fdf1676c2cda7e2add969b04d4b"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "721",
       "sha": "91a32d9cb4a6e9709994e5659f26edc34df01289cccce9158c63ae5aefc67555"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "879-880",
       "sha": "a2248d93a4769df1b911cd955165522e3478640f46ca4580dfb65ff4b1628aa6"
      }
     ]
    },
    {
     "n": "106",
     "on": "reset",
     "of": "mame",
     "vs": "extra",
     "text": "MAME's device reset sets the read buffer to 0, so a data port read straight after reset returns 0.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "707",
       "sha": "0231dd4450c363538b617f1f96fdee9cd9727fdf1676c2cda7e2add969b04d4b"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "721",
       "sha": "91a32d9cb4a6e9709994e5659f26edc34df01289cccce9158c63ae5aefc67555"
      },
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "2071",
       "sha": "068d8766132cfa30352bc3ab132f866ff6eeed9a3dc052269891b8c65b2b441c"
      }
     ]
    }
   ],
