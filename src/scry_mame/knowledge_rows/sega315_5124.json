   "rows": [
    {
     "n": "1",
     "on": "write",
     "of": "doc",
     "text": "After the COMMAND byte pair is loaded, the color RAM data is written to Output Port $BE.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "427-428",
       "sha": "320badae96905038f8d161e8655d753ecafa35c84b73c5bf37fde98ec87f61d0"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "The color RAM data written to Output Port $BE has the format 0 0 b1 b0 g1 g0 r1 r0.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "429-431",
       "sha": "c3ff898a81a94bd9ae61576edd2aced927d17f707544308e4ce19aa93b2b4e69"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "In the color RAM data b1-b0 set four intensities for blue, g1-g0 for green and r1-r0 for red.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "432-433",
       "sha": "a8b295c712c205c0c7e565fec27123b510f0f54720db7d36a28ed49a8c749ae2"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "As with the Video RAM, repeated writes to Output Port $BE automatically increment the Color RAM address.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "434-435",
       "sha": "7407dd76881946a2b77b3298e923aa57e0fb07762f12ffb757c2ba595ff61680"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "Port $BE is written to send VDP data.",
     "quotes": [
      {
       "ref": "datasheet:SegaMk3-SRM.raw.txt",
       "lines": "1043",
       "sha": "ac163739f94bd0a12d86e4193ea4f0bd08bf8437c1bc5539bb17fe673c8cec91"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A data port write in MAME also cancels a half-finished command write.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "832",
       "sha": "4cc166c8a08857beadfc941f5853c609e3a81fb3af71999b606b01f293437c6e"
      }
     ]
    },
    {
     "n": "102",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A data port write in MAME also loads the read buffer with the written byte.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "807",
       "sha": "fbf64526816293faaccedf81671cd429cc5c75620a91915d2ec10c82ca56eb85"
      }
     ]
    },
    {
     "n": "103",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A color RAM write in MAME sets the m_cram_dirty flag only when the written byte differs from the stored one.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/315_5124.cpp",
       "lines": "1919-1927",
       "sha": "a0f3b388a153473068496185bf63850a3eafc4c91e994f487e06c1d08f5b78b0"
      }
     ]
    }
   ],
