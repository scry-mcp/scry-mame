  {
   "key": "0x00",
   "name": "data write",
   "aliases": [
    "VDP data write"
   ],
   "access": "write",
   "regions": [
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
     "lines": "427-435"
    },
    {
     "ref": "datasheet:SegaMk3-SRM.raw.txt",
