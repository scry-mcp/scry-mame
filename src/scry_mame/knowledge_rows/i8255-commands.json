 "entries": [
  {
   "key": "0x80..0xFF",
   "name": "mode set",
   "regions": [
    {
     "ref": "datasheet:82C55A.raw.txt",
     "lines": "158-163"
    },
    {
     "ref": "datasheet:82C55A.raw.txt",
     "lines": "176-182"
    },
    {
     "ref": "datasheet:82C55A.raw.txt",
     "lines": "231-232"
    },
    {
     "ref": "datasheet:82C55A.raw.txt",
     "lines": "252-273"
    },
    {
     "ref": "datasheet:82C55A.raw.txt",
     "lines": "437-442"
    },
    {
     "ref": "mame:src/devices/machine/i8255.cpp",
     "function": "i8255_device::set_mode"
    },
    {
     "ref": "mame:src/devices/machine/i8255.cpp",
     "function": "i8255_device::device_reset"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The 8255 has three basic modes of operation selected by software: mode 0 basic input/output, mode 1 strobed input/output and mode 2 bi-directional bus.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "158-163",
       "sha": "4b782d594f97871c45ec9adb1adc5fc572d5b0f65575e0fc32385ab4b462c821"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The modes of port A and port B can be defined separately, port C is divided into two portions as their definitions require, and modes may be combined.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "176-178",
       "sha": "81dc905ccebf07d9cfc8a7a932b5d9200ef185cad3a9b03b4908ec0923aa0876"
      },
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "181-182",
       "sha": "5a8c9e2987c03ef4b74ec015852d5d5be16f1cd19dbcad7a6d8e52d1bae5029a"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "All of the output registers, including the status flip-flops, are reset whenever the mode is changed.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "178-180",
       "sha": "efb3a85c0cf764daf65e8e400f7608f200413a9b32fa5504a03ea8ceb79e81b8"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "All mask flip-flops are automatically reset during mode selection and device reset.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "231-232",
       "sha": "387a9528331bd122621d39f4f649321d99c5d8630278ae825ff1f616d70a61a2"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "In mode 0 the mode word bits D4, D3, D1 and D0 set port A, port C upper, port B and port C lower as input (1) or output (0).",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "252-262",
       "sha": "717ba8d1e1fa9f65915bd63670d88fc12fdb8f5c6612ef17ac9f9182f3a066e0"
      },
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "263-273",
       "sha": "6473e651ccbb87d08f8a881a159e94880e0e6e19e76f85b43e7526bef7d19817"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "In any combination of modes some or all port C lines are used for control or status; the remaining bits are inputs or outputs as the Set Mode command defines.",
     "quotes": [
      {
       "ref": "datasheet:82C55A.raw.txt",
       "lines": "437-442",
       "sha": "749d525602fc060bec707134fce86b304b5abf6ddeae14401a273e5329fc3b01"
      }
     ]
    },
    {
     "n": "107",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "3",
     "text": "A mode set clears IBF and INTE flags, sets OBF to one and, unless m_dont_clear_output_latches is set, clears the output latches; port A as an output also gets IBF set.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/i8255.cpp",
       "lines": "584-591",
       "sha": "bf84f5f028a06321d03a6b027f9e3e329e6901421cb7804247c1aa79bcbd5bfd"
      },
      {
       "ref": "mame:src/devices/machine/i8255.cpp",
       "lines": "593-596",
       "sha": "faed48dfdd092d33271bf7f9c934fc30734e97ce232e5d4615ead37ece79a1de"
      },
      {
       "ref": "mame:src/devices/machine/i8255.cpp",
       "lines": "612-617",
       "sha": "98fd8449c3042b58c770330566230177cd79379d4593d4d57a949683f7150b39"
      },
      {
       "ref": "mame:src/devices/machine/i8255.cpp",
       "lines": "629-631",
       "sha": "1b72962d14d46f4974562cf67de745723bfb20b613e60b48f5c0ecb0e8e34e7f"
      }
     ]
    },
    {
     "n": "108",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "5",
     "text": "MAME stores the mode word, direction bits included, in m_control; m_force_portb_in sets its port B input bit and m_force_portc_out clears its port C input bits.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/i8255.cpp",
       "lines": "572",
       "sha": "b7540a86cbecaaf91111b1ff4f89da2f99554faf54629f4665702cce6a0d08ab"
      },
      {
       "ref": "mame:src/devices/machine/i8255.cpp",
       "lines": "574-581",
       "sha": "97c30f8b9113d6bf5c9718af406f169927314fc65a61cc66cf0b47382d8c507e"
      },
      {
       "ref": "mame:src/devices/machine/i8255.cpp",
       "lines": "778",
       "sha": "5bbcaab587cc47e8926e504e6f87dd0c7f58be400be66b8efc3af3fa9d5cd5d1"
      }
     ]
    }
   ],
