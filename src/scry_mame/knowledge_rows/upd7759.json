  {
   "key": "0x02",
   "name": "busy_r",
   "regions": [
    {
     "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
     "lines": "21081-21087"
    },
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "function": "upd775x_device::busy_r"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "BUSY outputs the status of the uPD7759.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21081-21082",
       "sha": "556e01a6cb0da366b0cf266a3a40405c149ce25bbd961ba4eefd6696273d79c5"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "BUSY is an active low output that goes low during speech decode and output operations.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21082-21083",
       "sha": "40d8a2d35b667062081272161ccb61bd1b160bfdb5545cffa923b145f3b2b6ae"
      },
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21086-21087",
       "sha": "e322e43c9d3dd96755797d02b9026840058288b484a070cfc9016451d3f463b6"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "When ST is received, BUSY goes low.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21083-21084",
       "sha": "7cdaacb9f378a1219dfe0e38c7773bd851df162fa8e3d7b3eaf2e4273c9d4d41"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "While BUSY is low, another ST is not accepted.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21084-21085",
       "sha": "145beadeac25176ae60a8ba836b8c6d5f986c20907ccf03d91babf7ddb6d213a"
      }
     ]
    },
    {
     "n": "5",
     "on": "when",
     "of": "doc",
     "text": "In standby mode BUSY becomes high impedance.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21085-21086",
       "sha": "e67a3994d57d9b22af07432ce4ec280ef955b7c17153cc48b7f62d1e03dd5f58"
      }
     ]
    },
    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "When the DRQ drop state runs, MAME sets m_state to the state saved for after it; busy_r returns whether m_state is the idle state.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "388-389",
       "sha": "682109374b4ace3f79ae4c953e8923dcef2e29cbcc49a45103b79b7b18929e5f"
      },
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "675-680",
       "sha": "1bf524c99932afc400e1e4bf1b4f2639b9bba580c88b6623c6075df35aa5ab38"
      }
     ]
    },
    {
     "n": "102",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "5",
     "text": "MAME's busy_r has no high impedance state: it returns 0 or 1.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "675-680",
       "sha": "1bf524c99932afc400e1e4bf1b4f2639b9bba580c88b6623c6075df35aa5ab38"
      }
     ]
    }
   ],
   "closed": [
