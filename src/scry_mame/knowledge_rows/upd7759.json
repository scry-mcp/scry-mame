 "entries": [
  {
   "key": "0x00",
   "name": "reset_w",
   "regions": [
    {
     "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
     "lines": "21109-21115"
    },
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "function": "upd775x_device::reset_w"
    },
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "function": "upd775x_device::internal_reset_w"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "RESET is the reset input, which initializes the chip.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21109-21110",
       "sha": "dc3077d393cbe88555789383369e8cd65c8ddd83bd5e7aecf41ca608ded2a5c5"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The RESET input initializes the chip (the capture reads `initializedthe`).",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21110",
       "sha": "16788672c0aa2cdb2dd86942536a022cd55788997385cce7d85586aa0d9491dd"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "RESET is used following power-up to abort speech reproduction or to release standby mode.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21110-21112",
       "sha": "92a6cbf5d4bdf5b7362e90240dfb1bb216b0b4729e794187caa3fa1e2aac8004"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "RESET must remain low for at least 12 oscillator clocks.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21112-21113",
       "sha": "9bd0a96934e5688a3e5e0fa19943c8278ec1302cbfda59b6079154b990fe7796"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "At power-up or when recovering from standby mode, RESET must stay low 12 more clocks after clock oscillation stabilizes (the capture reads `least.12`).",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21113-21115",
       "sha": "5f3fd1eca81f7e84fd6029e02a20bc6331e73bbc5188dfbe9801843a8a4c724e"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "reset_w has the scheduler call internal_reset_w, which stores the level in m_reset and calls device_reset when the level falls from 1 to 0.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "595",
       "sha": "753962ebb40edef935e21dcfdeeb655fe3732e07ad061e5025b9943e13ead00e"
      },
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "603",
       "sha": "f793c90e116a61d0b5b03f0216e057cc1aada119c346a65b1cc137be1463deae"
      },
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "605-606",
       "sha": "33119e98900de63d164803b3257f150b0ad305e20790324e7632ba4bd3eac3ca"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "lines": "605-606",
     "as": "unfollowed",
     "row": "2"
    }
   ]
  },
  {
   "key": "0x01",
   "name": "start_w",
   "regions": [
    {
     "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
     "lines": "21088-21090"
    },
    {
     "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
     "lines": "21120-21125"
    },
    {
     "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
     "lines": "21173-21181"
    },
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "function": "upd775x_device::start_w"
    },
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "function": "upd775x_device::internal_start_w"
    },
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "lines": "678-679"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "CS is the chip select input.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21088",
       "sha": "1a0a7b2ec61522d8875749dfbaf7873c8ac8514c2ef98afe0d2a4391234ad659"
      }
     ]
    },
    {
     "n": "2",
     "on": "when",
     "of": "doc",
     "text": "When CS goes low, ST is enabled in stand-alone mode (the capture's punctuation is garbled).",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21089-21090",
       "sha": "660ab40d104b77bb8245df5de9101d610f597f1df2cb9da0cf7f7c00da2ccd75"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Setting the ST input low while CS is low starts speech reproduction of the message in the speech ROM locations addressed by the contents of I0 to I7.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21121-21123",
       "sha": "bcd8f4baabb210e9166de9bd9ffc918fb31ea224baa4df0fe83ad02b51902fd3"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "Setting the ST input low starts speech reproduction; the document adds the condition that CS is low (see row 2).",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21121-21122",
       "sha": "3aaee2f5b1e22a4097b6cf214964e974edbea2db23217709537e075560d385d2"
      }
     ]
    },
    {
     "n": "5",
     "on": "when",
     "of": "doc",
     "text": "In the paragraph on setting ST low, the document adds that if the device is in standby mode, standby mode will be released.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21121-21125",
       "sha": "d8a0b92af3fc41261ebb92ca3dad7e3d9f85e9939023af4f2ade42e2aae706ea"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The chip has a message selection interface for 1 Mbit of external ROM, and stores a maximum of 256 messages and up to 50 seconds of speech.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21173-21176",
       "sha": "e5a6c5002643164d58b02a96af73207c6cdf6fc5ddbd4143115bf38ee9ad7e0b"
      }
     ]
    },
    {
     "n": "7",
     "on": "when",
     "of": "doc",
     "text": "The message is selected on I0 to I7 and the selection is latched at the rising edge of ST when CS is asserted.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21176-21178",
       "sha": "1ac88ff52ff91d0d74112ce0c3d6183999329978c492b4ad7c5149a9d8bff6e8"
      }
     ]
    },
    {
     "n": "8",
     "on": "is",
     "of": "doc",
     "text": "When ST is asserted, BUSY goes low.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21178-21179",
       "sha": "e5de8640fa3527647f1298cdf6181855277c3cababf475f788138f73c69472e0"
      }
     ]
    },
    {
     "n": "9",
     "on": "is",
     "of": "doc",
     "text": "BUSY stays low until the selected speech output is completed.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21179-21180",
       "sha": "b78704a7fa8002b67cf13d0f05d2fab6a20208733e922df6f975ad910cd32456"
      }
     ]
    },
    {
     "n": "10",
     "on": "when",
     "of": "doc",
     "text": "While BUSY is low, a new ST is not accepted.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21180-21181",
       "sha": "319b00360edf466f6d29b1e2665104f4ce1f5287315c672400e0a2ff5288df51"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "start_w has the scheduler call internal_start_w, which stores the level in m_start.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "612",
       "sha": "ebdd4dd03e04e90384c4d298be02d7b6ed2ced33b7338dfe58890e446084373c"
      },
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "620",
       "sha": "26d23fcfbf6b7abf1e68b6d08a3303c2867222dfd780377cae392a7f078e1706"
      }
     ]
    },
    {
     "n": "102",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "Besides a fall of ST from 1 to 0, MAME's start check needs an idle chip, stand-alone mode and RESET high.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "624",
       "sha": "9c786b78ce764c0b6ea78f9ac7cb14f9f8fcf62a90279b1490d5d65d2f8fc202"
      }
     ]
    },
    {
     "n": "103",
     "on": "when",
     "of": "mame",
     "vs": "absent",
     "row": "2",
     "text": "MAME's internal_start_w has no chip select input, so a fall of ST is not gated by CS.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "616-622",
       "sha": "9da20fc148ac425fe80fc430508e974f5650d4e70c8996f1873e7e94d9c4acd5"
      },
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "623-628",
       "sha": "bccb80bdd0c13682e841ed23c90ebe028a6a7fa0198384868cbe6b54e315d90b"
      }
     ]
    },
    {
     "n": "104",
     "on": "when",
     "of": "mame",
     "vs": "absent",
     "row": "5",
     "text": "MAME's internal_start_w does nothing about a standby mode.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "616-622",
       "sha": "9da20fc148ac425fe80fc430508e974f5650d4e70c8996f1873e7e94d9c4acd5"
      },
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "623-628",
       "sha": "bccb80bdd0c13682e841ed23c90ebe028a6a7fa0198384868cbe6b54e315d90b"
      }
     ]
    },
    {
     "n": "105",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "7",
     "text": "MAME takes the sample number from m_fifo_in, the last byte written to port_w, when the start state runs, not from a latch at a rising edge of ST.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "394",
       "sha": "c857849d216ce2cd00361508947e0de6fe6b4ecaa32d7566e63fd866a8dd4641"
      },
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "640",
       "sha": "64be2c33e98c197b4a0aacf2136e7b8b9c08325182959857227ecc182cf9ed6e"
      }
     ]
    }
   ],
   "closed": [
