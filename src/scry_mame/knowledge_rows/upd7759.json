    },
    {
     "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
     "lines": "21093-21099"
    },
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "function": "upd775x_device::port_w"
    },
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "function": "upd775x_device::internal_port_w"
    },
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "lines": "394"
    },
    {
     "ref": "mame:src/devices/sound/upd7759.cpp",
     "lines": "533"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "In stand-alone mode AEN/WR is AEN, which is high while the address signal is valid.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21062-21065",
       "sha": "a23498b0c0247cbed284259f8a2993742d63db1cdd0f98e0f091e8ca8c5ea869"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "In slave mode WR is the write input signal for speech data.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21065-21066",
       "sha": "b9810392457b746887b0e7fc6e0f90a638839fafa6fffcffce596621eb18e46a"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "In stand-alone mode ASD0 to ASD7 are the output lines for the higher 8 bits of the address and the input lines for speech data.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21070-21073",
       "sha": "6d6a1bea1101788e322fffa0f434e8c9016fecb50b5cef2a0a5ac4bfe962498e"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "In slave mode ASD0 to ASD7 are input lines for speech data.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21073-21074",
       "sha": "d3add0c4aba4df58d2834a87b91f12586b0fc010703d03e8a6cb42bc1be1a2d7"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "I0 to I7 input the message number of the message to be reproduced.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21093-21094",
       "sha": "b17ecbb9ac55611ddd1615ba80ee4e1cbb0a713ffe609870200e48ffaa1270f5"
      }
     ]
    },
    {
     "n": "6",
     "on": "when",
     "of": "doc",
     "text": "The I0 to I7 inputs are latched at the rising edge of the ST input.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21094-21096",
       "sha": "714989c1d6b64eb2b10e52043899bc4ace41a8338bee426fbd9207e6fc0e4c82"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Unused I0 to I7 pins should be grounded; in standby mode they should be set high or low, as at or near the CMOS switch input they drain excess current.",
     "quotes": [
      {
       "ref": "datasheet:NEC-DSP-Speech-1992.raw.txt",
       "lines": "21096-21099",
       "sha": "5a8928a0bd93c6840f24bd33df0a621c6fbbb124073d7dc079ecd8e2accb41de"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "port_w has the scheduler call internal_port_w with the byte, which stores it in m_fifo_in.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/upd7759.cpp",
       "lines": "633",
       "sha": "919b23c58074eef8e4398307782a966cce56cd3b52064025d6a6dd62677df030"
