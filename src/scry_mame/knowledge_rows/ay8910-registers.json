 "entries": [
  {
   "key": "0x00..0x05",
   "name": "tone period",
   "aliases": [
    "tune"
   ],
   "regions": [
    {
     "ref": "datasheet:AY-3-8910.raw.txt",
     "lines": "566-649"
    },
    {
     "ref": "mame:src/devices/sound/ay8910.cpp",
     "function": "ay8910_device::ay8910_write_reg",
     "case": [
      "AY_AFINE"
     ]
    },
    {
     "ref": "mame:src/devices/sound/ay8910.cpp",
     "function": "ay8910_device::ay8910_write_reg",
     "case": [
      "AY_BFINE"
     ]
    },
    {
     "ref": "mame:src/devices/sound/ay8910.cpp",
     "function": "ay8910_device::ay8910_write_reg",
     "case": [
      "AY_CFINE"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "R0/R1, R2/R3 and R4/R5 are the fine and coarse tune registers of the tone generators of channels A, B and C.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "569",
       "sha": "620f22d138fa449e99b2b3aa792b90f6be6f09bd46f0ce26104f5d88bbe31b0b"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "577-581",
       "sha": "756ae16039c29643d4ca7566d5c3e4ffe433e544ba44cee51ff03768e20d47e0"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "A tone generator counts the input clock down by 16 and then down by its programmed 12-bit tone period.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "570-573",
       "sha": "df525523641cbcc5a185fe68e7dc472b4871837175d894abdb50a0cb53d2aaa2"
      }
     ]
    },
    {
     "n": "3A",
     "on": "write",
     "of": "doc",
     "text": "Channel A's tone period is R1, bits B3 to B0 as TP11 to TP8, over R0 as TP7 to TP0.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "574-576",
       "sha": "629482842782f023b2072b5a32ef6118610725dc9bb571c37385a251457197d9"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "579",
       "sha": "8c068a3cfba288cfacb925144950c7ff2329a8a4f7ab8330580c5affc2c9f030"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "611-614",
       "sha": "6dcf2b0a04520c922e6398a33b1335edc6a841ad69ed13a29a71b6c2f66b70de"
      }
     ]
    },
    {
     "n": "3B",
     "on": "write",
     "of": "doc",
     "text": "Channel B's tone period is R3, bits B3 to B0 as TP11 to TP8, over R2 as TP7 to TP0.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "574-576",
       "sha": "629482842782f023b2072b5a32ef6118610725dc9bb571c37385a251457197d9"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "580",
       "sha": "58083fe0f81da96619fb620e50b354a3a15e26f20f38525f16ab902d37b170f9"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "611-614",
       "sha": "6dcf2b0a04520c922e6398a33b1335edc6a841ad69ed13a29a71b6c2f66b70de"
      }
     ]
    },
    {
     "n": "3C",
     "on": "write",
     "of": "doc",
     "text": "Channel C's tone period is R5, bits B3 to B0 as TP11 to TP8, over R4 as TP7 to TP0.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "574-576",
       "sha": "629482842782f023b2072b5a32ef6118610725dc9bb571c37385a251457197d9"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "581",
       "sha": "126c198f0555f0d9d9b574f6adddf53dba06a18b37410f2daff3a33a8f4df79a"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "611-614",
       "sha": "6dcf2b0a04520c922e6398a33b1335edc6a841ad69ed13a29a71b6c2f66b70de"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "The tone period is a period: the higher the value, the lower the tone frequency.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "595-597",
       "sha": "1d99c1f6ed73a6441c5f468164a190203350e013fa4f1f9ce6078ca74a532314"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "The lowest tone period is 1, which divides by 1, and the highest is 4095.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "598-600",
       "sha": "5d3b2e0a4b340eb762ac902f8e2b180677b92b03996cc4128b4960b558bfcf15"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The document gives equations from the input clock and the tone period to the tone frequency, and back.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "601-610",
       "sha": "25300cb392ad759cf9a7d72c17dac7c0ab57b9aee352cedd6a3d568b9561e7dd"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "619-622",
       "sha": "a4b36259b62cfc85118faa5980b5b053911fb7877c93baf5ff4aba4963b491d3"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "With a 2 MHz input clock the tone frequencies range from 30.5 Hz to 125 kHz.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "615-618",
       "sha": "aa0528591a3b096ef2d91da64edebcdca273ded92d89cabbd49ff546c960cb8c"
      }
     ]
    },
    {
     "n": "8",
     "on": "is",
     "of": "doc",
     "text": "From a 2 MHz clock, a 1 kHz tone has tone period 125: coarse tune 0000 and fine tune 01111101.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "623-628",
       "sha": "6bad143efced29e590e89718d0c84aa89d88c28d4da591a8b93d861271d3247d"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "629-635",
       "sha": "b31055094494d4baa41e330ec7d84bc9029c8dd878e658a67b53961970ca22f3"
      }
     ]
    },
    {
     "n": "9",
     "on": "is",
     "of": "doc",
     "text": "From a 2 MHz clock, a 100 Hz tone has tone period 1250: coarse tune 0100 and fine tune 11100010.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "636-642",
       "sha": "ea28e50e4c791f790b66ee2a6de544e64993f8a9f8e7894759ecfa49d016cb04"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "643-648",
       "sha": "e151945f6181eb31d1b09b54a40748453e08ad96feed88c2dc1d6502515cc7fb"
      }
     ]
    },
    {
     "n": "10",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "On the AY8930 in expanded mode the coarse tune register keeps all 8 bits; otherwise it keeps its lower 4 bits.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/ay8910.cpp",
       "lines": "929",
       "sha": "388710ac7c4c1535bf6e16e2371793b5afe0c233ecb6715cd380402a57296020"
      },
      {
       "ref": "mame:src/devices/sound/ay8910.cpp",
       "lines": "934",
       "sha": "3e57e93a9713ebd263f6ff3d54e12c013afc22fcfec8ec0b14652a3c4a7858b9"
      },
      {
       "ref": "mame:src/devices/sound/ay8910.cpp",
       "lines": "939",
       "sha": "c14393fd08f8fd2b8940824c00326e306178d99e53f35aafad799ecc1ef78b88"
      }
     ]
    }
   ],
