  {
   "key": "0x0E..0x0F",
   "name": "I/O port data",
   "aliases": [
    "port"
   ],
   "regions": [
    {
     "ref": "datasheet:AY-3-8910.raw.txt",
     "lines": "930-958"
    },
    {
     "ref": "mame:src/devices/sound/ay8910.cpp",
     "function": "ay8910_device::ay8910_write_reg",
     "case": [
      "AY_PORTA"
     ]
    },
    {
     "ref": "mame:src/devices/sound/ay8910.cpp",
     "function": "ay8910_device::ay8910_write_reg",
     "case": [
      "AY_PORTB"
     ]
    },
    {
     "ref": "mame:src/devices/sound/ay8910.cpp",
     "function": "ay8910_device::ay8910_read_ym",
     "case": [
      "AY_PORTA"
     ]
    },
    {
     "ref": "mame:src/devices/sound/ay8910.cpp",
     "function": "ay8910_device::ay8910_read_ym",
     "case": [
      "AY_PORTB"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "R16 and R17 are data storage registers between the PSG data bus and the two I/O ports; they have no effect on sound.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "933-938",
       "sha": "a30931c7309de6fc145c52da2eedb33d6e444e46ef60d550d3bd9df30a2cbd3d"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A write to R16 or R17 puts the data on I/O port A or B when its direction bit in R7 is output.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "939-944",
       "sha": "af2c47e258033855960dd00a9ebc419f0918557a979b929743b127b9964bc2a5"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "692-694",
       "sha": "c4c4909562b23a75cfb55f08a74b301462f1799cd6b5b81d5879b073d2159c91"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "711-717",
       "sha": "db2ae4f12cbecfe5df5f1255ae1962c2a7a81848687939e230b9c4388a709f4c"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "A read of R16 or R17 returns the data at the pins when the port direction bit in R7 is input.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "945-950",
       "sha": "d95d21a555378af2d90ceb1bd89a3e85d701b4bff26c110bf35116c7f1dc893e"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "955-958",
       "sha": "39d45c05d8839f3df75103529e736a6f77a99fcf1307669dad9a979f3fd0d3ce"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "692-694",
       "sha": "c4c4909562b23a75cfb55f08a74b301462f1799cd6b5b81d5879b073d2159c91"
      },
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "711-717",
       "sha": "db2ae4f12cbecfe5df5f1255ae1962c2a7a81848687939e230b9c4388a709f4c"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "Output data stays on the port until new data is loaded, reset is applied, or the port is switched to input.",
     "quotes": [
      {
       "ref": "datasheet:AY-3-8910.raw.txt",
       "lines": "951-954",
       "sha": "b20106fa2ffcfe11d78a562489d69cdd32c34ad5197f9e981fb6a9dd71e00165"
      }
     ]
    },
    {
     "n": "5",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "MAME returns the data at the port A pins on a read even when R7 sets port A to output, and logs a warning.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/ay8910.cpp",
       "lines": "1406-1415",
       "sha": "dd19a3d7865049a84c1993eeb2094aadb016d1c10685ca25909cdbc0057b7d5a"
      }
     ]
    }
   ],
