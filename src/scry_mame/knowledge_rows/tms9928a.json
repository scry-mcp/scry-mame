  {
   "key": "0x00",
   "access": "write",
   "name": "Register 0 options",
   "aliases": [
    "R0",
    "register 0"
   ],
   "regions": [
    {
     "ref": "datasheet:TMS9918.raw.txt",
     "lines": "563-571"
    },
    {
     "ref": "datasheet:TMS9918.raw.txt",
