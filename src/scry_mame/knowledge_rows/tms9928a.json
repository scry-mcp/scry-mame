     "ref": "mame:src/devices/video/tms9928a.cpp",
     "function": "tms9928a_device::change_register",
     "case": [
      "1"
     ],
     "preamble": true
    },
    {
     "ref": "mame:src/devices/video/tms9928a.cpp",
     "function": "tms9928a_device::check_interrupt"
    },
    {
     "ref": "mame:src/devices/video/tms9928a.cpp",
     "lines": "368-372"
    },
    {
     "ref": "mame:src/devices/video/tms9928a.cpp",
     "lines": "543-552"
    },
    {
     "ref": "mame:src/devices/video/tms9928a.cpp",
     "lines": "768-769"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "reset",
     "of": "doc",
     "text": "An external reset clears VDP registers 0 and 1.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "554",
       "sha": "abe8c36ccc1dd65d74cb38e809c9097d7ab29c7d61c4f1dea5121269773ae6b3"
      }
     ]
    },
    {
     "n": "2",
     "on": "reset",
     "of": "doc",
     "text": "After reset the display is blanked because the BLANK bit of register 1 becomes 0.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "554-555",
       "sha": "7c87e6dceca4bbb95b8deae864f6664226bc2acae1f980d7644128ce168a5aa3"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Register 1 holds eight option control bits.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "572",
       "sha": "cae7c1797c0593082139efbb5a8d69f15af20d3fd2e8500d18d746035823509e"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "BIT 0 selects 4027 RAM operation at 0 and 4108/4116 RAM operation at 1.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "573-575",
       "sha": "bb37762264dba86cc18754344069730c3f40958cd122a2129e33e49d677bdb4a"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "BIT 1 (BLANK): 0 blanks the active display area, which then shows only the border colour.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "576-577",
       "sha": "d5b59ef537549bc5528e8fa595d398a3cc96c730230815c637c437cf37dee74b"
      },
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "579",
       "sha": "03f03cfd4169a1d41507455db762f1f3f432e9c7856e37422554c2e7cca2d86b"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "BIT 1 at 1 enables the active display.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "578",
       "sha": "078c44536f79dd57e2e919e025310a249c25645395c544ea196bb22fb88f71e7"
      }
     ]
    },
    {
     "n": "7",
     "on": "write",
     "of": "doc",
     "text": "BIT 2 (IE): 0 disables the VDP interrupt and 1 enables it.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "580-582",
       "sha": "617e032fe585226fe62e031fb6fad9aaa80a098a5e69c477855cc35285f9e6ae"
      }
     ]
    },
    {
     "n": "8",
     "on": "bits 3-4",
     "of": "doc",
     "text": "BITs 3 and 4 are M1 and M2, mode bits 1 and 2.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "583",
       "sha": "55884f66d5679301d8ed288a6bb3e20821d895a5066584d795de9c0004f41de4"
      }
     ]
    },
    {
     "n": "9",
     "on": "bits 3-4",
     "of": "doc",
     "text": "M1, M2 and M3 select the mode: 000 Graphics I, 001 Graphics II, 010 Multicolor and 100 Text.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "584-589",
       "sha": "719775592ec46e3a0169c579addd9050da00a8052d89ff82efe70aa17523f850"
      }
     ]
    },
    {
     "n": "10",
     "on": "is",
     "of": "doc",
     "text": "BIT 5 is reserved.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "590",
       "sha": "b9e607c44e2e7d41d86b28a4ecdcbefe5ac6c8db9c0cd85bf6685b49e898e366"
      }
     ]
    },
    {
     "n": "11",
     "on": "write",
     "of": "doc",
     "text": "BIT 6 (Size): 0 selects 8x8 sprites and 1 selects 16x16.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "590-592",
       "sha": "03bc0376028b85e624925858028a1a99640b5347681a46e661bb9b08e1a898fb"
      }
     ]
    },
    {
     "n": "12",
     "on": "write",
     "of": "doc",
     "text": "BIT 7 (MAG): 0 selects 1x sprites and 1 selects 2x.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "593-595",
       "sha": "ac3739e3606336d12b92de35110606c40c0830551d1110bdb9e45e60ef51b55d"
      }
     ]
    },
    {
     "n": "13",
     "on": "is",
     "of": "doc",
     "text": "The capture's line for register 1 reads 4/16K PBLANKE 1E M1 M2 0 size | MAG.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "601",
       "sha": "b90d5633d64d8e72be3663ed623cde5f7c0bf1722c243a7bce746d18899fff30"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "absent",
     "row": "4",
     "text": "MAME does not use this bit: its register 1 case only re-evaluates the interrupt and the mode.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "276-280",
       "sha": "4b05c616cd2b5f782b7a1bae0c0ea37d3604a603e2f2c83d10f9200a313561fc"
      }
     ]
    },
    {
     "n": "102",
     "on": "bits 3-4",
     "of": "mame",
     "vs": "extra",
     "text": "MAME draws no sprites and sets the fifth sprite number to 31 while the display is blanked or 0x10 (M1) is set.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "543-546",
       "sha": "eed272f2c906999c6c2c53ec9f7e8ef065e15bfa5ddea51fe336fb657396e1e3"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "368",
       "sha": "83043b3922c9fb56ce512863c346f58b139b58fcf8ba0e457be9acef3ad2d3a1"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "271",
       "sha": "f9d311b2a7524d79d21fd3298ce9c4388d9b54cb3fb7d160e68037e9e772203d"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "242-247",
       "sha": "94513d76f3628af469a85f5484af0362dc0ebe888f823dc0d4400aafb00f9a81"
      }
     ]
    },
    {
     "n": "103",
     "on": "reset",
     "of": "mame",
     "vs": "extra",
     "text": "MAME's reset clears all eight registers and the status register, not only registers 0 and 1.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "768-773",
       "sha": "e9828f269f14cecbd72bcb8dd54da76cb29fce5a0f4c3ebb8223ecfb3be0fc07"
      }
     ]
    },
    {
     "n": "104",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "MAME tests the document's bits as masks: 0x40 is BIT 1, 0x20 is BIT 2, 0x02 is BIT 6 and 0x01 is BIT 7.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "368",
       "sha": "83043b3922c9fb56ce512863c346f58b139b58fcf8ba0e457be9acef3ad2d3a1"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "211",
       "sha": "3e5d033f6513c2cece112088b8ea6b26922bd61d038d815290851b0313ecb28e"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "550-551",
       "sha": "e613a6f5f9f59a88930f030faf241b86548166d3a62096d3b02ac8ff975258e9"
      }
     ]
    }
   ],
