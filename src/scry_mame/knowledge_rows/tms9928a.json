     ],
     "preamble": true
    },
    {
     "ref": "mame:src/devices/video/tms9928a.cpp",
     "lines": "241-247"
    },
    {
     "ref": "mame:src/devices/video/tms9928a.cpp",
     "function": "tms9928a_device::update_backdrop"
    },
    {
     "ref": "mame:src/devices/video/tms9928a.cpp",
