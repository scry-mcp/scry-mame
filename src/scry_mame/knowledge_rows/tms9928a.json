    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Register 0 holds two option control bits, and all its other bits are reserved and must be 0.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "564",
       "sha": "f1fc58ae1481b16a68925ac925e8e3cab8dbe72ab79c88660f9ebc7910771594"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "BIT 6 is M3, mode bit 3.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "565",
       "sha": "bea8752f8d125a57d3817100214e13fbe36273ebcc2ccc7c19c8ae762cf01c9b"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "BIT 7 enables the external VDP input: 0 disables it and 1 enables it.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "566-568",
       "sha": "532d56a91bc41d940751c75ad53565709650919c5afda3523d251e8d286e8970"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "In the TMS9928A and TMS9929A, enabling bit 7 sends A-Y and B-Y to the sync level only when every plane in front of the pixel is transparent.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "569-571",
       "sha": "da2e33c5dffad1d5b711cc81e1a879eeef9af60245be8d786ae77209b29f39d2"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "Figure 2-3 labels its register rows MSB and LSB and draws register 0 with M3 and the external VDP bit as the two rightmost fields.",
     "quotes": [
      {
       "ref": "datasheet:TMS9918.raw.txt",
       "lines": "599-600",
       "sha": "da690c017ca99007a972bc6b6f556e455431cabe734765450d8b15e7f26fd711"
      }
     ]
    },
    {
     "n": "101",
     "on": "bit 7",
     "of": "mame",
     "vs": "differs",
     "row": "3",
     "text": "MAME masks the value with 0x03 and, while 0x01 is set, makes pen 0 transparent when the backdrop index is 0; the external video input remains a TODO.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "240-241",
       "sha": "21c294ed752823c3c6e116e10674e03f66fed93b37515a64dd6bf64735742f00"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "251-252",
       "sha": "dcd2cb6ff3890c450984272117989022c1c6704a59a0fef42f63917fc59d9a9e"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "272",
       "sha": "b01043656bccaacf6d498b50623374f59f9c551ae43e79f99b1513a787285291"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "224-225",
       "sha": "8291edc1169b4d0a9ab051ec85aa26825f93fb2cc7a3eed23ba83a7677fb7078"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "17-18",
       "sha": "2cead891bd7840caaca34569ff9fa83a8b9e63b04dc923bf324d057187ffe584"
      }
     ]
    },
    {
     "n": "102",
     "on": "bit 7",
     "of": "mame",
     "vs": "absent",
     "row": "4",
     "text": "MAME uses the bit only to make pen 0 transparent in this body; no line here produces A-Y or B-Y sync levels.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "222-226",
       "sha": "d2de8cc5903386764b7537ca14c90a388837b990c24aa01d400c4a79349fe2b7"
      }
     ]
    },
    {
     "n": "103",
     "on": "bit 6",
     "of": "mame",
     "vs": "extra",
     "text": "With M3 set, MAME derives the colour and pattern table bases from single bits of registers 3 and 4 and rebuilds the address masks from both.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "260-269",
       "sha": "13c1646372d8e0927a70a1b0a7a6ed6a4637a0623bef96292afa50815bd629e0"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "231-234",
       "sha": "7bfd81c16c18aee5a3b0d52d2f9c6a1b04d42d94b87b752fe99ebc9c2f54406e"
      }
     ]
    },
    {
     "n": "104",
     "on": "bits 3-4",
     "of": "mame",
     "vs": "extra",
     "text": "MAME names all eight combinations of M1, M2 and M3, four of them marked as a variation or bogus: Mode 1+2, Mode 1+3, Mode 2+3 and Mode 1+2+3.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "242-247",
       "sha": "94513d76f3628af469a85f5484af0362dc0ebe888f823dc0d4400aafb00f9a81"
      }
     ]
    },
    {
     "n": "105",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "MAME logs the chosen mode name and each register write only when its TRACE_MODE and TRACE_REG are set; both are 0 in this source.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "43",
       "sha": "5dfbbff0d94adff784f8610887ea2a641df8c6e293ded218fc48c570db76dc79"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "46",
       "sha": "3b3f443b3f03004dc8bc7bf1af454eb173e4801934209c44825db724ebdc44c5"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "274",
       "sha": "8e32f286f08ab45f195b3a42b874a02a8591eec95b985834799b37910b84fce7"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "254",
       "sha": "9a3ffa95d0466eb0e3a6b9d367b4c60008bf1ea6d5ef346e0acd18eadb861c34"
      }
     ]
    },
    {
     "n": "106",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "MAME reads register 0's two control bits from the least significant end: 0x02 is M3, the document's BIT 6, and 0x01 the external VDP bit, BIT 7.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "271",
       "sha": "f9d311b2a7524d79d21fd3298ce9c4388d9b54cb3fb7d160e68037e9e772203d"
      },
      {
       "ref": "mame:src/devices/video/tms9928a.cpp",
       "lines": "272",
       "sha": "b01043656bccaacf6d498b50623374f59f9c551ae43e79f99b1513a787285291"
      }
     ]
    }
   ],
   "closed": [
