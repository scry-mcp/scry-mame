    {
     "ref": "datasheet:XR68C681.raw.txt",
     "lines": "716"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "variant": "XR68C681",
     "text": "Table 3, the miscellaneous commands of the command registers' upper nibble, lists four commands that set or clear the BRG select extend bits.",
     "quotes": [
      {
       "ref": "datasheet:XR68C681.raw.txt",
       "lines": "697-704",
       "sha": "4d05ef816128434def27285be12261167736f7c8a9f98a3fe170c18cdf156034"
      },
      {
       "ref": "datasheet:XR68C681.raw.txt",
       "lines": "716",
       "sha": "3588bbdb0407cd1fe7f746eba71dc8c010c6930ca606eb90e80d718bd7b2b9ce"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "variant": "XR68C681",
     "text": "Set Rx BRG select extend bit sets the channel's Receiver BRG Select Extend Bit to one.",
     "quotes": [
      {
       "ref": "datasheet:XR68C681.raw.txt",
       "lines": "697-698",
       "sha": "9d6f4f77f3162b55215a0f7f8cd58da3f9350ca8ef953b0db46f37927d90e190"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "variant": "XR68C681",
     "text": "Clear Rx BRG select extend bit clears that bit.",
     "quotes": [
      {
       "ref": "datasheet:XR68C681.raw.txt",
       "lines": "699-700",
       "sha": "9b1a3ec1baceb4388c8aa1bbb43c1e5cd566e92f203b2adbb98c421208b3c67b"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "variant": "XR68C681",
     "text": "Set Tx BRG select extend bit sets the channel's Transmitter BRG Select Extend Bit to one.",
     "quotes": [
      {
       "ref": "datasheet:XR68C681.raw.txt",
       "lines": "701-702",
       "sha": "a182db3351945f853fd722863427014de530073bbf330ecbfd65d49694d00877"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "variant": "XR68C681",
     "text": "Clear Tx BRG select extend bit clears that bit; the capture garbles its value, so the value is not stated.",
     "quotes": [
      {
       "ref": "datasheet:XR68C681.raw.txt",
       "lines": "703-704",
       "sha": "57af48d613fa297f3958e083ca251ee18059fddd0a49ac529a3486e2edc0f0c6"
      }
     ]
    }
   ],
