   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "CRA[6:4] = 101 is the Reset Channel A Break Change Interrupt command.",
     "quotes": [
      {
       "ref": "datasheet:MC68681.raw.txt",
       "lines": "1741",
       "sha": "17445fae28166928c1f4fccda9f7f6fa33654a63546236998b8c798a8b53b870"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "The command clears the channel A break detect change bit of the interrupt status register, ISR[2].",
     "quotes": [
      {
       "ref": "datasheet:MC68681.raw.txt",
       "lines": "1741-1742",
       "sha": "ff78725920a3118be9d6d1d835ca74bdae0d5980b8293a19fb32c4dc95979082"
      }
     ]
    }
   ],
