  {
   "key": "0x70..0x7F",
   "name": "stop break",
   "regions": [
    {
     "ref": "datasheet:MC68681.raw.txt",
     "lines": "1750-1752"
    },
    {
     "ref": "mame:src/devices/machine/mc68681.cpp",
     "function": "duart_channel::write_CR",
     "case": [
      "7"
     ]
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "CRA[6:4] = 111 is the Stop Break command.",
     "quotes": [
      {
       "ref": "datasheet:MC68681.raw.txt",
       "lines": "1750",
       "sha": "85251d229830fb27aec7e17547570bf754023448e93d788c6bb17f40d1ac4950"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Stop break raises TxDA within two bit times, and it stays high one bit time before the next character.",
     "quotes": [
      {
       "ref": "datasheet:MC68681.raw.txt",
       "lines": "1750-1752",
       "sha": "39415e31304fb62d683a164f808c20b8653f64b4109bda9283520bc35b11e3f7"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "text": "MAME clears m_tx_break and in loopback sets the break bit of ISR; the case does not drive the TxD output.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/mc68681.cpp",
       "lines": "1781-1790",
       "sha": "606b101d4e20cb8f29e5bae863b4d61f62c9008bc39f68fa3f84ab157e7bbe18"
      },
      {
       "ref": "mame:src/devices/machine/mc68681.cpp",
       "lines": "1791-1794",
       "sha": "22742dd1a4cda8959921d198524c5b3e0ce07b520d434607a4445772221cc22a"
      }
     ],
     "row": "2"
    }
   ],
   "closed": [
