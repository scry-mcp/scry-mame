 "entries": [
  {
   "key": "0x01",
   "name": "Clear Display",
   "regions": [
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1625-1630"
    },
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1761-1766"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "719-730"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "731-733"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Clear display is instruction 0000 0001: RS and R/W are 0 and DB7 to DB0 are 0000 0001.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1625-1628",
       "sha": "32825a5d44bfed56d0c1ef93b0ba25755b8e181b987ee848a98716cb9c060597"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "Clear display writes space code 20H into all DDRAM addresses, and character code 20H must hold a blank pattern.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1762-1763",
       "sha": "71f4125558ea8484da7233fc26d651376105685840d435068e76f118069c9ea0"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "It sets DDRAM address 0 into the address counter and returns the display to its original status if it was shifted.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1763-1764",
       "sha": "c7df2ad1a19c7752054144ade6c881e4b5f4543d665f3ff4b91a3b574740206e"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "The display disappears and the cursor or blinking goes to the left edge, the first line in a 2-line display.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1764-1765",
       "sha": "2dd3e0fa0503dd0d440a2e2cd6edb553360c8aad4b832aefae0df94ed3124e0f"
      }
     ]
    },
    {
     "n": "5",
     "on": "write",
     "of": "doc",
     "text": "Clear display stores I/D as 1 (increment mode) in entry mode.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1765-1766",
       "sha": "e761dc2a4864fb91dbf296792a0558d9091bab9da4a9cc041e5ce85628d27a3c"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "S of entry mode does not change.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1766",
       "sha": "480260afe5a81f4323a8468edb49d7f6fd1df0ce80316d0792a9cd43c4b41275"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Table 6 says clear display sets DDRAM address 0 in the address counter.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1629-1630",
       "sha": "b5870f81a5a2dcf716edf9d5ac3e84c1a52c0d31681b40c8901893c51c335e5d"
      }
     ]
    },
    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "MAME raises the busy flag for 410 device-clock cycles after clear display, counted at the device clock divided by the busy factor.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/hd44780.cpp",
       "lines": "729",
       "sha": "faf880eac1ca7b612d16eecd0286cd6980484b86f5ed6596ecbceaf421db62e5"
      },
      {
       "ref": "mame:src/devices/video/hd44780.cpp",
       "lines": "376-380",
       "sha": "682f48ea86cb3b11f4f45fd6c422d1b289689154d55959539c7bd9b0b3ee472e"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1761",
     "as": "key"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "726",
     "as": "agrees",
     "row": "5"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "719-730",
     "as": "agrees",
     "row": "6",
     "nothing": true
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "719-733",
     "as": "structure"
    }
   ]
  },
  {
   "key": "0x02..0x03",
   "name": "Return Home",
   "regions": [
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1631-1638"
    },
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1743"
    },
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1767-1770"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "708-718"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Return home is instruction 0000 001x: DB1 is 1 and DB0 is a dash, which Table 6's note reads as no effect, so 0x02 and 0x03 both return home.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1631-1633",
       "sha": "b66683804daafaedca6c861090a424e7f5e565e64e91acdd2e0e8cddd30c6fd6"
      },
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1743",
       "sha": "ba56456d0eb569f246678dd21650e59d6fb979ebe9a71cf2cd20a95907d2f957"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Return home sets DDRAM address 0 into the address counter and returns the display to its original status if it was shifted.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1768-1769",
       "sha": "58c01e253e07505dbef1520b90bc08c0de300375a06c480d1745b1b137d04556"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The cursor or blinking goes to the left edge of the display, in the first line if 2 lines are displayed.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1770",
       "sha": "c41b2eb8d8c149f6ba80a9b81c9d2df392f4045e35171398e401f16d700b97fa"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "The DDRAM contents do not change.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1769",
       "sha": "9409158f33607f444e70f31b661bc27de59fd6a61c3654d49d349675e3c52d51"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "Table 6 says return home also returns a shifted display to its original position, and DDRAM contents remain unchanged.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1634-1638",
       "sha": "63490f21e11a72145504a12bd66dd6206c2c55d18aeedcd8faabf20a20784f25"
      }
     ]
    },
    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "MAME records DDRAM as the active memory and sets the entry direction to +1 on return home.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/hd44780.cpp",
       "lines": "714-715",
       "sha": "2381c0a2bc3869db2a38c986059bf2f7c65dbb86af3644b85d4ae2d886a4aecd"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1767",
     "as": "key"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "713-716",
     "as": "agrees",
     "row": "2"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "708-718",
     "as": "structure"
    }
   ]
  },
  {
   "key": "0x04..0x07",
   "name": "Entry Mode Set",
   "regions": [
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1640-1646"
    },
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1771-1779"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "699-707"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Entry mode set is instruction 0000 01IS: DB2 is 1 and DB1 and DB0 carry I/D and S.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1640-1642",
       "sha": "f165acbca871982f768a040484fd1e01b4faf7daef91b575d1700b8698e05fab"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Entry mode set stores I/D, which makes a later DDRAM character write or read increment the address when I/D is 1 and decrement it when I/D is 0.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1772-1773",
       "sha": "98e9504506a6ebe0115179731841ce4c6eee161534945012c01eacc528e92d83"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "The cursor or blinking moves right when the address is incremented and left when it is decremented; the same applies to CGRAM.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1774-1775",
       "sha": "322229335f762f3f0f5ed28821da6c70693b294e7760e2d8ac1da7dac807409f"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "Entry mode set stores S, which shifts the entire display right when I/D is 0 and left when I/D is 1; the display does not shift when S is 0.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1776-1777",
       "sha": "23b1a792fcff86169d6e2b42a5901ca0ec40a47f6e9430033783f953dbcccd35"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "With S = 1 it seems as if the cursor does not move but the display does.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1778",
       "sha": "cebec1045d988bb9ded04af43bf1104c3401ac3b6eab3a10c84bc7851b10c97e"
      }
     ]
    },
    {
     "n": "6",
     "on": "write",
     "of": "doc",
     "text": "A DDRAM read does not shift the display, and writing into or reading out from CGRAM does not shift it.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1778-1779",
       "sha": "eb5e916d616f6753843c1efb116dbd30980ede36ff22f8c03a2776ee9306b32f"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Table 6 says it sets the cursor move direction and specifies display shift, performed during data write and read.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1642-1646",
       "sha": "4a50006f3f20d5ab3a505f5e7869d0af702993fa168efa573a083b2a3435b1d6"
      }
     ]
    },
    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "6",
     "text": "MAME leaves a DDRAM read unshifted, as the row says, but with S set it shifts the display after a CGRAM write, which the row says it does not.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/hd44780.cpp",
       "lines": "780-783",
       "sha": "575f55d819ada3ee16005f1578fb0aed3047a25b74628002e9656384ccf1d020"
      },
      {
       "ref": "mame:src/devices/video/hd44780.cpp",
       "lines": "787-788",
       "sha": "bb957c549ab057102be6b17d11158f7ac6c895e0282add82325bd3184a67aaf8"
      },
      {
       "ref": "mame:src/devices/video/hd44780.cpp",
       "lines": "791-802",
       "sha": "3aeb9a81082edc24b5fd9a87f8d3e61ad310172896d37d4cfd58cd93c84246d6"
      },
      {
       "ref": "mame:src/devices/video/hd44780.cpp",
       "lines": "803-812",
       "sha": "5d61d20b27c76ac8746d3f8154856cc7392db7e0cec647e2255e154931598d63"
      }
     ]
    }
   ],
   "closed": [
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1771",
     "as": "key"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "702",
     "as": "agrees",
     "row": "2"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "703",
     "as": "agrees",
