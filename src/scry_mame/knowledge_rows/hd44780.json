  {
   "key": "0x80..0xFF",
   "name": "Set DDRAM Address",
   "regions": [
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1676-1681"
    },
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1974-1978"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "632-642"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Set DDRAM address is instruction 1AAAAAAA: DB7 is 1 and DB6 to DB0 carry the seven address bits.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1676-1679",
       "sha": "9384fa63b16c17f04eb9429e8ea1382749dc78260a30b72e505cbea0c774eb84"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Set DDRAM address stores the DDRAM address AAAAAAA into the address counter and selects DDRAM for the data that follows.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1975-1976",
       "sha": "c4d34557eedadeeaf5836b38961f19e72ff47d228e9b21f5b9279e8815662d12"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "With N = 0 the address can be 00H to 4FH; with N = 1, 00H to 27H for the first line and 40H to 67H for the second.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1977-1978",
       "sha": "055930a268ad254be40cb3897c8fab68ed9ba7954ee2695bb516e44e9deb9576"
      }
     ]
    },
    {
     "n": "4",
     "on": "is",
     "of": "doc",
     "text": "Table 6 says it sets the DDRAM address, and DDRAM data is sent and received after this setting.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1679-1681",
       "sha": "9e82acca9d233843a6933bbf168a5c898b12aef0f910b41c36c691ca19fffe52"
      }
     ]
    },
    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "extra",
     "text": "MAME folds an address outside those ranges back in: past the last address it wraps, and in 2-line mode an address between 0x28 and 0x3F is moved up by 0x18.",
     "quotes": [
      {
       "ref": "mame:src/devices/video/hd44780.cpp",
       "lines": "637",
       "sha": "970bdf3d2e5a633d57a9e1355ca1a3695d071393cb3d628091ba93fc7d3e2591"
      },
      {
       "ref": "mame:src/devices/video/hd44780.cpp",
       "lines": "382-393",
       "sha": "fe3cc38476ecfea11677048720f81dc00a0051d484b363d4a6c06294408672ad"
      }
     ]
    }
   ],
