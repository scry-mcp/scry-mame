  {
   "key": "0x40..0x7F",
   "name": "Set CGRAM Address",
   "regions": [
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1669-1674"
    },
    {
     "ref": "datasheet:HD44780.raw.txt",
     "lines": "1809-1811"
    },
    {
     "ref": "mame:src/devices/video/hd44780.cpp",
     "lines": "643-652"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Set CGRAM address is instruction 01AAAAAA: DB6 is 1 and DB5 to DB0 carry the six address bits.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1669-1672",
       "sha": "9f92d9c32c50d8c39d313b1859244b089b76e463ab50cfff1697d7bb1bbcbd6e"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Set CGRAM address stores the CGRAM address AAAAAA into the address counter and selects CGRAM for the data that follows.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1810-1811",
       "sha": "d2f6d653e9f8701eac84954784d6c8e6e46e25175c0c800b8aa556c5186b768d"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Table 6 says it sets the CGRAM address, and CGRAM data is sent and received after this setting.",
     "quotes": [
      {
       "ref": "datasheet:HD44780.raw.txt",
       "lines": "1672-1674",
       "sha": "f930c1df5a5abe86c949840e453e31ca0065da36e9d39d5d03162e72ad4f0abf"
      }
     ]
    }
   ],
   "closed": [
    {
