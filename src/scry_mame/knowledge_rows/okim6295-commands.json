  {
   "key": "0x80..0xFF",
   "name": "select phrase",
   "regions": [
    {
     "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
     "lines": "2116-2139"
    },
    {
     "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
     "lines": "2321-2337"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Phrases are specified and read in as 2 bytes of data on the instruction data bus.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "2118-2119",
       "sha": "718678afdc76a91832eb40cdc5aa297155aec90346323c347034c17ddf1e93f6"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A bit of the first data byte, its name lost in the capture, is always 1, and bits I0 to I6 specify the phrase (the capture reads `10 -16`).",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "2124-2126",
       "sha": "ebdcb1178c990d9095ab15535cd74f2d3ea651e7b32741dfa0fe434a91717443"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "Phrase selection data has a selection of 127 phrases, which correspond to 0000001 to 1111111.",
     "quotes": [
      {
       "ref": "datasheet:OKI-VoiceSynthesis-1994.raw.txt",
       "lines": "2126-2128",
       "sha": "9ec44205f9fc8a561d426170f81c36814abd30b594c722213f6917ded4cd7f89"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "With no phrase pending, a byte with bit 7 set stores its low seven bits as the pending phrase; with one pending the byte is a second byte.",
     "quotes": [
      {
       "ref": "mame:src/devices/sound/okim6295.cpp",
       "lines": "235",
       "sha": "f7e345c34046fbd451b356f7b776cb62508a02dc77f9b6d5db34fba2756b4ad4"
      },
      {
       "ref": "mame:src/devices/sound/okim6295.cpp",
