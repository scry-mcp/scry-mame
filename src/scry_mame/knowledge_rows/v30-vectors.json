   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The device has a single-step interrupt function for program debugging, controlled by the Break Flag of the PSW (the capture garbles the device name and the bit number).",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "2060-2062",
       "sha": "1d7f8f7e99b3cd9cc9ee38ebdae3a8d9958cdbda40e77587c70317d6941fbc94"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "No instruction directly sets or resets the BRK flag; the PSW is restored from the stack and changed there with OR and AND instructions.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "2062-2067",
       "sha": "8700bab5133e5019a73797a84f88c79941081f050d9d056470b5ca20094060b8"
      }
     ]
    },
    {
     "n": "3",
     "on": "when",
     "of": "doc",
     "text": "When the BRK flag is set, the interrupt routine specified by vector 1 starts after the current instruction has been executed.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "2068-2070",
       "sha": "1581f0fce6f66662862b962bd6ec58bd414b4197c024b395f9f1233f715ff953"
      }
     ]
    },
    {
     "n": "4",
     "on": "does",
     "of": "doc",
     "text": "The BRK and interrupt enable (IE) flags are also reset at this point.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "2070-2071",
       "sha": "2b791a43c092ba51d57b381ced8e91a77c06db1a51a2c4e07dce2746e366b476"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "i_popf calls nec_trap when m_TF is set after restoring the flags, and i_iret calls i_popf; nec_trap runs the next instruction, then raises NEC_TRAP_VECTOR (enum value 1).",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/necinstr.hxx",
       "lines": "541",
       "sha": "eafd9cbc1ef2fc1d9b6b04081c6ea7ce15a3a651d98287febda411e13e787ef3"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necinstr.hxx",
       "lines": "648",
       "sha": "8debb946471aa4ec77c4fdd815a5413605066a7053c994780c93a827d00142a3"
      },
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "349-350",
       "sha": "cf4c55e0c2daf502c028429b4a6f11be04183cf0d0266e229c96d380411d77ee"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necpriv.ipp",
       "lines": "17",
       "sha": "12d239193032d73eade5d128139e16d05a0b8dea4ab80c35b18ed11d42c8e58c"
      }
     ]
    },
    {
     "n": "102",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "nec_interrupt clears m_TF and m_IF, which CompressFlags places at bits 8 and 9 of the word it builds.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "324",
       "sha": "10057fa3a47a6b3d41eea2878e3468da39d27d5c5e91e99f572cdd60f31eebc5"
      },
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "330",
       "sha": "89b1076f69640e84579f98ca76c9877647b8f7356c01a0684cf25e10bd12dfc1"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necpriv.ipp",
       "lines": "118-119",
       "sha": "2536b4f31ac3fb2d1e6f9675b51029498d0c8aeaf8a4f1a6a5f68141f339b35c"
      }
     ]
    }
   ],
