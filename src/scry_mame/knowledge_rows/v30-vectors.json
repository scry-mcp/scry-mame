    },
    {
     "ref": "mame:src/devices/cpu/nec/nec.cpp",
     "lines": "647-650"
    },
    {
     "ref": "mame:src/devices/cpu/nec/nec.cpp",
     "lines": "666-669"
    },
    {
     "ref": "mame:src/devices/cpu/nec/nec.cpp",
     "lines": "656-657"
    },
    {
     "ref": "mame:src/devices/cpu/nec/necpriv.ipp",
     "lines": "18"
    },
    {
     "ref": "mame:src/devices/cpu/nec/nec.cpp",
     "lines": "337-338"
    },
    {
     "ref": "mame:src/devices/cpu/nec/nec.cpp",
     "lines": "342-343"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The NMI signal is used for interrupt requests that cannot be masked by software.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "891-892",
       "sha": "4c53cdce8963de6a06d5ea23d78a0a16a5d5effa744f1817740263abaf129ac1"
      }
     ]
    },
    {
     "n": "2",
     "on": "when",
     "of": "doc",
     "text": "The interrupt is triggered on the rising edge of NMI.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "892-893",
       "sha": "e2980291eeb8aa5aa563028034a01cd8f2236d430db80ddb5de788826cdb8c84"
      }
     ]
    },
    {
     "n": "3",
     "on": "is",
     "of": "doc",
     "text": "NMI must be held high for at least five clock cycles after its rising edge.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "894-895",
       "sha": "c00afce66beea031ea14f1a1cf8716d5aa4af1448dc0a2ddf5f75796106d00ba"
      }
     ]
    },
    {
     "n": "4",
     "on": "when",
     "of": "doc",
     "text": "Actual interrupt processing begins after completion of the instruction in progress.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "895-897",
       "sha": "36b30f0970be2ccf5971e2324cd8ca3dbf02d8bad80131e583176015a559dc6b"
      }
     ]
    },
    {
     "n": "5",
     "on": "does",
     "of": "doc",
     "text": "The contents of interrupt vector 2 determine the starting address of the interrupt servicing routine.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "898-899",
       "sha": "8a223293aea07241dff89611453d187caaaad3e94624e40f426accb62614a5b0"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "A hold request will be accepted even during NMI acknowledge.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "899-900",
       "sha": "8ebbb6be2aa23fc333a48cc553bdba761535095e4b8993bb7e3c205aa4884bd8"
      }
     ]
    },
    {
     "n": "7",
     "on": "does",
     "of": "doc",
     "text": "This interrupt will cause the microprocessor to exit the standby mode.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "900-902",
       "sha": "a537df6cc39e70dc2fd431c1b436b22b9c23a61b8f4ba93a1672175543a65512"
      }
     ]
    },
    {
     "n": "8",
     "on": "is",
     "of": "doc",
     "text": "NMI can be sensed during any clock cycle.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "893-894",
       "sha": "1a61008f155b79b2bfe5e5ee54c3e7631285800ea030a4430da86a6d3c27dd7c"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "INPUT_LINE_NMI selects set_nmi_line, which sets NMI_IRQ in m_pending_irq; a pending NMI_IRQ makes the dispatch call external_int, whose NMI branch calls nec_interrupt with NEC_NMI_VECTOR (enum value 2).",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "430-431",
       "sha": "5a65cf12d55e529f44eca0209d60a975480ba1ced856c0467298f34af8e2a2ba"
      },
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "406-416",
       "sha": "035639538144cd3b26291aeebc3ee4859e34ba554762892190ff10e0f656a54e"
      },
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "649-650",
       "sha": "4e3e7347fc3343cf3179470dbd917a3d300bdda454ff5a4083b1fb9ca06facfa"
      },
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "368-372",
       "sha": "03c47e304b421eee50376003f9a123dbf9262f7e50025bea4cc4e55d8a6dfc0f"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necpriv.ipp",
       "lines": "18",
       "sha": "b17d6ff58403aeb33e00b54506c4a54965611bb14faabb5c49459275b98b1e1c"
      }
     ]
    },
    {
     "n": "102",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "The interrupt dispatch block is entered when an interrupt is pending and m_no_interrupt is zero; m_no_interrupt is decremented after each dispatch check when it is not zero.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "647-648",
       "sha": "ef93800c5c8f83d95a9872102db1cf22cf9e220a24656fb81cc4f536418eb8b1"
      },
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "656-657",
       "sha": "2d80164d3b4ec41d67cef957aca86ff2db4330d23a618fa5b3cff5e08694f83e"
      }
     ]
    }
   ],
