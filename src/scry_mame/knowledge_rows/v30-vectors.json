   "rows": [
    {
     "n": "1",
     "on": "does",
     "of": "doc",
     "text": "In the example of vector 0, PS takes the word at (003H, 002H) and PC the word at (001H, 000H) (the capture reads 000H as OOOH).",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "1915",
       "sha": "4d2a89b8d9b2d5c8a0c19b16411c31cd039a3b101288c08dae324905609f98a4"
      },
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "1940-1941",
       "sha": "191d5518015b14741ed2c99f10477237b28d74c44fbb4162ec236505c9528a4f"
      }
     ]
    },
    {
     "n": "2",
     "on": "is",
     "of": "doc",
     "text": "The contents of the vectors are initialized at the beginning of a program; the basic steps of a jump to an interrupt routine follow.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "1942-1944",
       "sha": "80ec949440e078e27da3dc696184d8351d9a2af6e59983e14b629e91f38e05bc"
      }
     ]
    },
    {
     "n": "3",
     "on": "does",
     "of": "doc",
     "text": "The jump stores to the stack: (SP-1, SP-2) gets PSW, (SP-3, SP-4) gets PS, (SP-5, SP-6) gets PC and SP becomes SP-6 (the capture lost the arrows).",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "1945-1948",
       "sha": "06b246222db4d7c24a3b45c62fd8c28f803c5f9cb37a3dde87e68e35e0c3afa4"
      }
     ]
    },
    {
     "n": "4",
     "on": "does",
     "of": "doc",
     "text": "The jump sets IE and BRK to 0 and MD to 1 (the capture reads MD as MO and 0 as O).",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "1949",
       "sha": "949f1af4e9a8c88c43711590e91388d9d11367e7ff99db5116a6093fb72868cd"
      }
     ]
    },
    {
     "n": "5",
     "on": "does",
     "of": "doc",
     "text": "PS takes the higher vector word and PC the lower vector word of the interrupt vector table.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "1950-1951",
       "sha": "cda198ad6cbcc8b3003c6982241cd154f4515d3d7ecb0767e374c56cedbadfd2"
      }
     ]
    },
    {
     "n": "6",
     "on": "does",
     "of": "doc",
     "text": "The interrupt enable (IE) and break (BRK) flags are reset when an interrupt routine is started.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "1952-1953",
       "sha": "834d9ffc1d0a4479cde5eac7edea07f381bee8d24ff1305be3af0cb15bafc026"
      }
     ]
    },
    {
     "n": "7",
     "on": "is",
     "of": "doc",
     "text": "Therefore maskable interrupts (INT) and single-step interrupts are disabled.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "1953-1954",
       "sha": "5c7d1ad2782bd89a4064b331d99f228f42ada0532a61d739964d533eabb35af6"
      }
     ]
    },
    {
     "n": "8",
     "on": "when",
     "of": "doc",
     "text": "When the quotient exceeds FFH, the capacity of AL, the vector 0 interrupt is generated; this especially occurs when the divisor is 0.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "6608-6612",
       "sha": "d1b559ba97cdfbe493425b18ac678f439b0222d906574db490fb03aa114889ac"
      }
     ]
    },
    {
     "n": "9",
     "on": "is",
     "of": "doc",
     "text": "The quotient and remainder then become undefined, and the fractional quotient is rounded off.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "6610-6612",
       "sha": "b08083db266e9c7832ed1aff78a9facea7cec80b17f28289d2c2c3ffe1c29014"
      }
     ]
    },
    {
     "n": "10",
     "on": "when",
     "of": "doc",
     "text": "When the quotient exceeds FFFFH, the capacity of AW, the vector 0 interrupt is generated; this especially occurs when the divisor is 0.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "6711-6714",
       "sha": "a69b3cc362d259fa2d336e3208e5381db4e7fab3626d3b2ba94407cd3ff187d8"
      }
     ]
    },
    {
     "n": "11",
     "on": "is",
     "of": "doc",
     "text": "The quotient and remainder then become undefined, and the fractional quotient is rounded off.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "6713-6715",
       "sha": "26e2535677a01bf47a489a0a761974d91db7b19853cee8c6242351df2f5a900a"
      }
     ]
    },
    {
     "n": "12",
     "on": "when",
     "of": "doc",
     "text": "The maximum positive quotient is +127 (7FH) and the minimum negative is -127 (81H); a quotient beyond either generates the vector 0 interrupt, especially when the divisor is 0.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "6825-6831",
       "sha": "5804069fca7fac617b0b65bbea9dd3e18f9767136e55aa0698e5c4aa17411d3d"
      }
     ]
    },
    {
     "n": "13",
     "on": "is",
     "of": "doc",
     "text": "The quotient and remainder become undefined, the fractional quotient is rounded off and the remainder has the sign of the dividend.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "6828-6833",
       "sha": "b722ce597849e98f1ecd190f6de238e43f70071a4686be5a58d95363ee29df5a"
      }
     ]
    },
    {
     "n": "14",
     "on": "when",
     "of": "doc",
     "text": "The maximum positive quotient is +32,767 (7FFFH) and the minimum negative is -32,767 (8001H); a quotient beyond either generates the vector 0 interrupt, especially when the divisor is 0.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "6933-6939",
       "sha": "74ddd73c4cbe2ed845f865cae5a2620918d553ba24b331cfb70858aae591746e"
      }
     ]
    },
    {
     "n": "15",
     "on": "is",
     "of": "doc",
     "text": "The quotient and remainder become undefined, the fractional quotient is rounded off and the remainder has the sign of the dividend.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "6937-6941",
       "sha": "9b9aff6cdb1ec6bd9e8f018a3f0cc4e6b0e27062a4653d609fe3786d0eb477ae"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "nec_interrupt is called with NEC_DIVIDE_VECTOR, the enum value 0, in a zero-divisor branch of necinstr.hxx and at four overflow tests in necmacro.h.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/necpriv.ipp",
       "lines": "16",
       "sha": "8308768233afafd51256c5ae231e1e635ba069d8903a8ca3762693809bcf0759"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necinstr.hxx",
       "lines": "750-756",
       "sha": "388dda3cabbd23e38a2adf7e1cb5b2637d0792c9edb918bd4e1d962f5016e295"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necmacro.h",
       "lines": "181-182",
       "sha": "268e302ba02f195891dacee1262bdf8eae01312cb2d1a69ef6823fbde4836789"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necmacro.h",
       "lines": "196-197",
       "sha": "268e302ba02f195891dacee1262bdf8eae01312cb2d1a69ef6823fbde4836789"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necmacro.h",
       "lines": "211-212",
       "sha": "268e302ba02f195891dacee1262bdf8eae01312cb2d1a69ef6823fbde4836789"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necmacro.h",
       "lines": "226-227",
       "sha": "268e302ba02f195891dacee1262bdf8eae01312cb2d1a69ef6823fbde4836789"
      }
     ]
    },
    {
     "n": "102",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "nec_interrupt clears m_TF and m_IF and sets m_MF; CompressFlags places them at bits 8, 9 and 15 of the word it builds.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "324",
       "sha": "10057fa3a47a6b3d41eea2878e3468da39d27d5c5e91e99f572cdd60f31eebc5"
      },
      {
       "ref": "mame:src/devices/cpu/nec/nec.cpp",
       "lines": "330-331",
       "sha": "fda47e35607cebcacbc47df3bc1a205d80f2e28c261315de54ed2115b577a6c3"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necpriv.ipp",
       "lines": "118-120",
       "sha": "f16eee6979ae616c0cbede6ebdccbf9de34db3ff15dace805a41918adf12bbe2"
      }
     ]
    },
    {
     "n": "103",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "In the case whose non-zero branch runs DIVUB, a zero tmp clears m_CarryVal and m_OverVal, then calls nec_interrupt.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/necinstr.hxx",
       "lines": "750-756",
       "sha": "388dda3cabbd23e38a2adf7e1cb5b2637d0792c9edb918bd4e1d962f5016e295"
      }
     ]
    },
    {
     "n": "104",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "In the case whose non-zero branch runs DIVB, a zero tmp clears m_CarryVal and m_OverVal, then calls nec_interrupt.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/necinstr.hxx",
       "lines": "761-767",
       "sha": "0cf7114511e9ec19015e00fe55163bc6aeeda37e4fad5f1679fa95da367a151e"
      }
     ]
    },
    {
     "n": "105",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "In the case whose non-zero branch runs DIVUW, a zero tmp clears m_CarryVal and m_OverVal, then calls nec_interrupt.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/necinstr.hxx",
       "lines": "784-790",
       "sha": "38a7d3fd9d0218ca290ee4e935da6b90deffd98b0facc4a02e7b0d541adc3e6d"
      }
     ]
    },
    {
     "n": "106",
     "on": "is",
     "of": "mame",
     "vs": "extra",
     "text": "In the case whose non-zero branch runs DIVW, a zero tmp clears m_CarryVal and m_OverVal, then calls nec_interrupt.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/necinstr.hxx",
       "lines": "795-801",
       "sha": "bf4e9c7dc0a914feafc00cb20d2f711498ec1b68b606daf3e55eb25355345756"
      }
     ]
    }
