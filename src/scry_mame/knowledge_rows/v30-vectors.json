   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "CHKIND reg16,mem32 is the check index instruction.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12312-12313",
       "sha": "b85b017437271e73fa680a9becc274a2ef935b42cf3bcc7913f048f4ea7047ad"
      }
     ]
    },
    {
     "n": "2",
     "on": "when",
     "of": "doc",
     "text": "The interrupt is taken when (mem32) is greater than reg16 or (mem32 + 2) is less than reg16.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12327",
       "sha": "69303884b687ab6179ec607ada5e74a568b6b8865a27648ccab2a7576d0a84f7"
      }
     ]
    },
    {
     "n": "3",
     "on": "does",
     "of": "doc",
     "text": "CHKIND stores to the stack: (SP-1, SP-2) gets PSW, (SP-3, SP-4) gets PS, (SP-5, SP-6) gets PC and SP becomes SP-6 (the capture lost the arrows).",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12328-12331",
       "sha": "c90ede634d9739c3a19e1380b1cc2cdfdf2f5caa07d8876becf96f4117f6037c"
      }
     ]
    },
    {
     "n": "4",
     "on": "does",
     "of": "doc",
     "text": "CHKIND resets the IE and BRK flags to 0 (the capture reads 0 as O).",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12332-12333",
       "sha": "6288d8361f5dc96e78be525c15a6e63c9bdcfeb04366b9fa697fc78a17609a7d"
      }
     ]
    },
    {
     "n": "5",
     "on": "does",
     "of": "doc",
     "text": "PS takes the word at locations 23 and 22 and PC the word at 21 and 20, written without an H suffix in the capture.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12334-12335",
       "sha": "ccc1c323b718af654d8bacbdaba55d736276c34a00ef5a2d86779744fb1c927a"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "CHKIND is used to check whether the index value in reg16 is within the defined array bounds.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12338-12339",
       "sha": "9d02ccbc9531a65d853eeb11a88170392ccdc75b76072fb8eaea6b1a4f1e8a7e"
      }
     ]
    },
    {
     "n": "7",
     "on": "does",
     "of": "doc",
     "text": "CHKIND initiates a BRK 5 when the index does not satisfy the condition.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12339-12340",
       "sha": "969978d46cbff2cd6f4fec6438b252cb73af5130d075297c721ffba0c6478e62"
      }
     ]
    },
    {
     "n": "8",
     "on": "is",
     "of": "doc",
     "text": "The definition region should be set beforehand in two words of memory: the first for the lower limit, the second for the upper limit.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12340-12343",
       "sha": "857a7d445b1fdd47384211727c5f835e96a7c13e2c94b036958f5134f6e01899"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "The handler of opcode 0x62, i_chkind, calls nec_interrupt with NEC_CHKIND_VECTOR, the enum value 5, when tmp is below low or above high.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/necinstr.hxx",
