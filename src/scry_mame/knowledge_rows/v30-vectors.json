    {
     "ref": "mame:src/devices/cpu/nec/necinstr.hxx",
     "lines": "540"
    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "BRKV, with no operand, is the break-if-overflow instruction.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12195-12196",
       "sha": "99ff9124c3bd8425f38744b2bcf7b1bb3b515020644d0c0cc545f0a919666316"
      }
     ]
    },
    {
     "n": "2",
     "on": "when",
     "of": "doc",
     "text": "When V = 1 BRKV starts the interrupt sequence; when the V flag is reset it proceeds to the next instruction.",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12199",
       "sha": "19c710dba627ad6596f1960b2f725cfc100027a4c0599ac1c24b55dcd89b3c20"
      },
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12211-12212",
       "sha": "83452e31c6d4f875bc18b4532740f3389d28180f75ee963ecc2474751a1fd6b2"
      },
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12215",
       "sha": "7b2c53817ab7790361820c6f3ddeba8c37750471ec45b339828bb65e120eb51f"
      }
     ]
    },
    {
     "n": "3",
     "on": "does",
     "of": "doc",
     "text": "BRKV stores to the stack: (SP-1, SP-2) gets PSW, (SP-3, SP-4) gets PS, (SP-5, SP-6) gets PC and SP becomes SP-6 (the capture lost the arrows).",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12201-12204",
       "sha": "62e7d8f578f6cdc9719a53e2044b193993f4e47fb742a598b6cf1c0626dce69f"
      },
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12211-12212",
       "sha": "83452e31c6d4f875bc18b4532740f3389d28180f75ee963ecc2474751a1fd6b2"
      }
     ]
    },
    {
     "n": "4",
     "on": "does",
     "of": "doc",
     "text": "BRKV resets the IE and BRK flags to 0 (the capture reads 0 as O).",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12205-12206",
       "sha": "6288d8361f5dc96e78be525c15a6e63c9bdcfeb04366b9fa697fc78a17609a7d"
      },
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12212",
       "sha": "6585b382d4cc3b473ebff1c51f1c9bf45ab844f9d46b29636342f8277882bae3"
      }
     ]
    },
    {
     "n": "5",
     "on": "does",
     "of": "doc",
     "text": "BRKV loads the lower two bytes of vector 4 into PC, (011H, 010H), and the upper two bytes into PS, (013H, 012H).",
     "quotes": [
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12207-12208",
       "sha": "db40f850249d2e5b157452a369e4159526ce84bf253b359f5235db84099eb94e"
      },
      {
       "ref": "datasheet:V20V30UM.raw.txt",
       "lines": "12212-12214",
       "sha": "6aab0535697f8bb6ecf797276132dbf9ef734ce9f95254198f2ca887b31e2844"
      }
     ]
    },
    {
     "n": "101",
     "on": "place",
     "of": "mame",
     "vs": "place",
     "text": "The handler of opcode 0xce, i_into, calls nec_interrupt with NEC_BRKV_VECTOR, the enum value 4, when OF is true.",
     "quotes": [
      {
       "ref": "mame:src/devices/cpu/nec/necinstr.hxx",
       "lines": "647",
       "sha": "9ec2b4cf4b980226c403645515266434861052723eb17c61de952141281e33f0"
      },
      {
       "ref": "mame:src/devices/cpu/nec/necpriv.ipp",
       "lines": "19",
       "sha": "677f38933ed0e969323cb37363a02d7f57c97a74ddc7a10e7c30b4beaa004995"
      }
     ]
    }
   ],
