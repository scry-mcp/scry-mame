      }
     ]
    },
    {
     "n": "102",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "MAME adds the DAC value to output 0 when bit 7 of register 0x1B6 is set and to output 1 when bit 6 is set.",
