      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "The table row 1 1 X X lists Control Register B.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "522",
       "sha": "1292e876b6249498416cd91d7b621a957cd22e7b7a29860be87fb84306c39f5f"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "Control register bit 6 is the interrupt flag IRQA(B)2.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "652",
       "sha": "8eccdc227fcc23b1c1668504b6c02a00ea8a5cea1a721abb8b5357861ed6f430"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "doc",
     "text": "With CB2 established as an output (b5 = 1), IRQB2 is 0.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "657-658",
       "sha": "84a01b12034674e9582d13346607ac49239d945594e1fbfd37493023abfe7b82"
      }
     ]
    },
    {
     "n": "101",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A read first polls CB1 through its input handler, so a pending edge sets its flag before the value returns.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "535-546",
       "sha": "f6e15314ab8a282274a8986be2701dcaa8054d6b15c1138bc584343117ca05c6"
      }
     ]
    },
    {
     "n": "102",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A read logs an error once when CB2 is an input with no pushed level.",
