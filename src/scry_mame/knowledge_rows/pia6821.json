   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Six locations are accessible to the MPU data bus: two peripheral registers, two data direction registers and two control registers, selected by RS0, RS1 and control register bit 2.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "506-510",
       "sha": "81f27e2e9254a750490fd238278f125318056b9de510aed501c7f9b07e8448c0"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "With RS1 RS0 = 0 0, CRA-2 = 1 selects Peripheral Register A and CRA-2 = 0 selects Data Direction Register A.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "516-518",
       "sha": "2773747aafe00c9597f9fd56302e1ea48644ff32a47320a1e37290bdc3dbfe72"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "The data on peripheral lines programmed as inputs appears directly on the corresponding MPU data bus lines.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "451-452",
       "sha": "ea4b3f5cfad8709f7940accedf8e30f649d61b6e8b5a0ceca73e6fe9192ebc7c"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "doc",
     "text": "Output Register A data may be read by an MPU read of peripheral data A when the corresponding lines are programmed as outputs.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "460-461",
       "sha": "0f15d34a4a4ef44e8df41b120c428635a1cfc1b133a88af0a52fae5e69359def"
      }
     ]
    },
    {
     "n": "5",
     "on": "read",
     "of": "doc",
     "text": "In the output mode, a read of port A reads the actual pin, whereas the B side read comes from an output latch ahead of the pin.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "538-541",
       "sha": "6d32e400242b462d69df7eedc763e52b9edf08dcd211b5fad893561206a146c4"
      }
     ]
    },
    {
     "n": "6",
     "on": "when",
     "of": "doc",
     "text": "The interrupt flags are cleared as a result of an MPU Read Peripheral Data Operation.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "428-429",
       "sha": "98c9a9800476203448e72af5ffe3ed4ec9756eeaf803b11d08b6a4a37a0dc3e3"
      }
     ]
    },
    {
     "n": "7",
     "on": "when",
     "of": "doc",
     "text": "With bit 3 = 0, read strobe with CA1 restore: CA2 goes low on the first high-to-low E transition following an MPU read.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "663-665",
       "sha": "a9cd7236e04adc918327631ab7e261a6ad449677bda5608ee585b5910c33104b"
      }
     ]
    },
    {
     "n": "8",
     "on": "when",
     "of": "doc",
     "text": "With bit 3 = 1, read strobe with E restore: CA2 goes low on the first high-to-low E transition following an MPU read.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "669",
       "sha": "b2c1bc6db9bd7a66803a6a1d40df7c9f1c90385d60d1daca36d3db252e8a3a00"
      },
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "671-672",
       "sha": "98ef517ce5b796eba75a3d149a8e7ffeac371883196da0c668e522d650c6c7f7"
      }
     ]
    },
    {
     "n": "9",
     "on": "when",
     "of": "doc",
     "text": "In read strobe with E restore, CA2 is returned high by the next high-to-low E transition during a deselect.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "669",
       "sha": "b2c1bc6db9bd7a66803a6a1d40df7c9f1c90385d60d1daca36d3db252e8a3a00"
      },
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "671-675",
       "sha": "eb693ee33813297960494dedd3b682e58212282f5dbdd3d1e2c63aeeac2b5531"
      }
     ]
    },
    {
     "n": "101",
     "on": "read",
     "of": "mame",
     "vs": "differs",
     "row": "5",
     "text": "A port A read returns Output Register A bits for output lines; only pins in m_a_input_overrides_output_mask return the pin level.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "238-240",
       "sha": "7aeefaf1940422d93cc0e4bfec333aa425709f46a04714fde374ec396c3cdece"
      }
     ]
    },
    {
     "n": "102",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "7",
     "text": "MAME drives CA2 low during the read itself, not at an E transition.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "403-408",
       "sha": "33fae29d0c600365bb9c749b85ad15b670f183f39c8da8d3ef562b8a813ef375"
      }
     ]
    },
    {
     "n": "103",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "8",
     "text": "MAME drives CA2 low during the read itself, not at an E transition.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "403-408",
       "sha": "33fae29d0c600365bb9c749b85ad15b670f183f39c8da8d3ef562b8a813ef375"
      }
     ]
    },
    {
     "n": "106",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "9",
     "text": "When strobe_e_reset is set (bit 3 of the control register) MAME sets CA2 high again inside the same read, not at a deselect E transition.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "406-411",
       "sha": "4b71e906d6d24178e41a53b7db83722cd0be2ba282ed8e04230c6ffb7a71e5b8"
      },
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "1111",
       "sha": "3f837785173d07d47bdc7b205195d6002061c75d9d6e33f9630c0618ee9f006b"
      }
     ]
    },
    {
     "n": "104",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A debugger read, with side effects disabled, clears no flag and moves no CA2 level.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "395-406",
       "sha": "165b97beca2d29aeac01b465ee227f659e4ead21271c8fc1e6c40816c395cab8"
      },
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "407-416",
       "sha": "ef32ca24e95f9a5e86182f9e2f2d0de9ff3528371cf88ccf2e2e2cfb000431a4"
      }
     ]
    },
    {
     "n": "105",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "With no input handler and no pushed value, MAME reads 0xFF on the input pins, and logs a warning once if any pin is an input.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "211",
       "sha": "573f04c83afc8c8094d4a798baa322134d6f3c7073d6ca114a80eb4069c60929"
      },
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "215-224",
       "sha": "12c399a67b83436484bef4d9d36360baa6687eb59a318018885c572c872f52f5"
      },
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "226-231",
       "sha": "26464fdbff7e10c57ea2b20c6045ca6ca920d4375f5eee9f98b2e361a5e98fc8"
      }
     ]
    }
   ],
