   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The two lowest-order bits of the control registers control the interrupt input lines CA1 and CB1.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "583-585",
       "sha": "24c586835a401ab0005d58cace80dd0eab6b421619cdcde526099bc254a408ac"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Bits 0 and 1 are stored; the text says CRB-0 enables the MPU interrupt IRQB and CRB-1 determines the active transition of CB1.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "585-589",
       "sha": "e76bdd13d8687997877e07cc289bec078f30c9e66a0433996cc85618aacce6ad"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "This line is programmed by Control Register B.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "498-499",
       "sha": "c45d63814151fcba84be3f1c5064f2d3e9ba47ee8e2dd74435078aae586a8673"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "Bit 5 is stored; the text says low makes CB2 an interrupt input like CB1 and high makes it an output signal.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "573-577",
       "sha": "1785dc9c839588791164691cb663edd070bca4529671278754833daac4e88738"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "4",
     "text": "MAME stores bit 5 and also drives CB2 from bits 4 and 3 on every control write, even with bit 5 low.",
     "quotes": [
