   "rows": [
    {
     "n": "1",
     "on": "read",
     "of": "doc",
     "text": "Control register bit 7 is the interrupt flag IRQA(B)1.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "641",
       "sha": "eab2b132d1c5888db7d1a7eb94c91c1bcec23e9c74d9fe8bd5a41301c5c7df5b"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "In the table, the row beginning 1 1 has X in both of the last two columns and gives Control Register B.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "522",
