   ],
   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The B section peripheral data lines can be programmed as inputs or outputs in a manner similar to PA0-PA7, with three-state capability.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "469-474",
       "sha": "2eadd30336ca5972144934f3c8535c70fd4217f25d3bb39b2abf563a0b4b9301"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "Data Direction Register B is stored; the text says the B lines are programmed as inputs or outputs similarly to PA0-PA7.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "469-472",
       "sha": "8cc56f91cfd9ccf4b843e1f0c48e3571e6990690981e6bf47bf617c70e5bfab5"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "In write strobe with CB1 restore, CB2 goes low on the first low-to-high E transition following an MPU write.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "676-678",
       "sha": "c1a17a59cbd37635e83b7fc16fe5fd860b6177fcf048e9d130016974bcf06eb2"
      }
     ]
    },
    {
     "n": "4",
     "on": "write",
     "of": "doc",
     "text": "In write strobe with E restore, CB2 goes low on the first low-to-high E transition following an MPU write.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "684-686",
       "sha": "a9cb383d9b22c237fbc8f99411c6f2ea2f1ca004ffda1851ff64404b63d7f202"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "3",
     "text": "A write of port B drives CB2 low inside the write itself, not at an E transition.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "697-701",
       "sha": "10db37936b6ecdd59ea2cefd7af16de85ad1253181352dd3aaba7831e14f0755"
      }
     ]
    },
    {
     "n": "102",
     "on": "write",
     "of": "mame",
     "vs": "differs",
     "row": "4",
     "text": "A write of port B drives CB2 low and, with bit 3 = 1, high again inside the write itself.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "697-705",
       "sha": "499ed3e6cedb3f3c2f2e3f100df9ce599cf76e3b229bd013f111f31513c6462b"
      },
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "1111",
       "sha": "3f837785173d07d47bdc7b205195d6002061c75d9d6e33f9630c0618ee9f006b"
      }
     ]
    },
    {
     "n": "103",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "A write of Output Register B stores the byte in m_out_b and calls send_to_out_b_func.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
