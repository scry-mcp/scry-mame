   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "Each peripheral data line can be programmed to act as an input or an output.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "444-446",
       "sha": "28c016b4f8fc9b96f7d7094e2bb88e65cc01e8ed741889d4b5c4653e9a2baff4"
      }
     ]
    },
    {
     "n": "2",
     "on": "write",
     "of": "doc",
     "text": "A 1 in a Data Direction Register bit makes its line an output and a 0 makes it an input; the register bit is stored.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "446-450",
       "sha": "7d508856556aa802f03fde2270f1da11bffdc6c68ebf14556482bf90a4301a8f"
      }
     ]
    },
    {
     "n": "3",
     "on": "write",
     "of": "doc",
     "text": "The data in Output Register A appears on the lines programmed as outputs; a 1 written into it makes the line high, a 0 low.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "455-459",
       "sha": "fcd8cd5924eb27f17784f018efc08934f414230ae7c42495f96f6189dbc1663b"
      }
     ]
    },
    {
     "n": "101",
     "on": "write",
     "of": "mame",
     "vs": "extra",
     "text": "With no output handler set, MAME only remembers that a value is pending and logs a warning if the next one overwrites it.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "619-625",
       "sha": "70a4f7a24022f6d77dca49c87dfa647827fef2aeb532c9bdd6ca1dd7c33e67e4"
      }
     ]
    }
   ],
