   "rows": [
    {
     "n": "1",
     "on": "is",
     "of": "doc",
     "text": "The control registers let the MPU control the four peripheral control lines CA1, CA2, CB1 and CB2, enable the interrupt lines and monitor the interrupt flags.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "543-547",
       "sha": "51d744b24b90badbd10d9afa3e554844342c8473b024c2a6e16b60d9048dd8e3"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "Bits 0 through 5 of the two control registers may be written or read by the MPU.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "547-548",
       "sha": "3d5a842933a1fa643efed8833e2cca8e583a6a88bf0dea4126f7ecad15b4ec18"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "Bits 6 and 7 of the two control registers are modified by external interrupts occurring on CA1, CA2, CB1 or CB2.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "549-551",
       "sha": "cdba12bcd7413b54c478252c426c44d8c0121484338ccdd4d0b5ec375138a153"
      }
     ]
    },
    {
     "n": "4",
     "on": "read",
     "of": "doc",
     "text": "The table row 0 1 X X lists Control Register A.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "519",
       "sha": "aa2b925d089d2e5a337a633e6485080be82f60007ab8c5ce0b54fb8ce70251ef"
      }
     ]
    },
    {
     "n": "5",
     "on": "is",
     "of": "doc",
     "text": "The format of the control words is shown in Figure 18.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "551-552",
       "sha": "e057b183b82cac52fde8a88a7fcdc51bfcc33cc5018c6b4a1523821fa0c438fa"
      }
     ]
    },
    {
     "n": "101",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A read first polls CA1 and CA2 through the input handlers, so a pending edge sets its flag before the value returns.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "487-498",
       "sha": "cd2bc08319da88777d29a3c24620f13c630a8bef6c42b65a3e903e946997e182"
      },
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "500-509",
       "sha": "de702237c322cd792ea7636f697150487354e0926419ea0c69f8d416d24d8c15"
      }
     ]
    }
   ],
   "closed": [
