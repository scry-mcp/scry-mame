    }
   ],
   "rows": [
    {
     "n": "1",
     "on": "when",
     "of": "doc",
     "text": "High by the next active CB1 transition, as specified by bit 1.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "680-681",
       "sha": "4a5ba7064a578f479b3fa7f86455c1ddf6d547c2e5e06a87ddbdcad6e0f91011"
      }
     ]
    },
    {
     "n": "2",
     "on": "read",
     "of": "doc",
     "text": "PB0-PB7 data is read properly from lines programmed as outputs even if the voltages are below 2.0 V for a high or above 0.8 V for a low.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "476-478",
       "sha": "9710fafcb288b08d1849b5f9b8c56628cef72350e20a46c466cbeeccfdcf5b5a"
      }
     ]
    },
    {
     "n": "3",
     "on": "read",
     "of": "doc",
     "text": "The row 1 0 X 1 gives Peripheral Register B and the row 1 0 X 0 gives Data Direction Register B.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "520-521",
       "sha": "97f65036655cfa693bc753a3510ebc82786ae9830c2ad508fce060e6d416e026"
      }
     ]
    },
    {
     "n": "4",
     "on": "when",
     "of": "doc",
     "text": "When CA2 (CB2) is an input, IRQA(B) is automatically cleared by an MPU read of Output Register A(B).",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "653-656",
       "sha": "8364ab86fafb6c60425361940758da79c4ddec7580b82c0a43e541308a5c7f3c"
      }
     ]
    },
    {
     "n": "5",
     "on": "when",
     "of": "doc",
     "text": "CRB bit 7 must first be cleared by a read of data.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "681-683",
       "sha": "84253740bdafc93b06d6703453d3377a155e034d7f7e0246395a2f3e29384127"
      }
     ]
    },
    {
     "n": "6",
     "on": "is",
     "of": "doc",
     "text": "The table has two rows beginning 1 0, ending X 1 and X 0, for Peripheral Register B and Data Direction Register B.",
     "quotes": [
      {
       "ref": "datasheet:MC6821.raw.txt",
       "lines": "520-521",
       "sha": "97f65036655cfa693bc753a3510ebc82786ae9830c2ad508fce060e6d416e026"
      }
     ]
    },
    {
     "n": "101",
     "on": "when",
     "of": "mame",
     "vs": "differs",
     "row": "1",
     "text": "MAME returns CB2 high inside the port B read when flag B1 is set, as the comment in cb1_w says.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "450-451",
       "sha": "ef8152fab58c0e2b60b234a52674edd6d13bb3c1487084fcc01759df0850f2b7"
      },
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "1040-1043",
       "sha": "776c6db2a76132bf3d71cb09a29063eaf88be458d26f537a5d96475262ed690e"
      }
     ]
    },
    {
     "n": "102",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "A debugger read, with side effects disabled, clears no flag and moves no CB2 level.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "443-454",
       "sha": "82c9924f4313e0ce4b54c08bef5a18d728f5da6f740bd8b10574ed2522d47c5a"
      },
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "455-461",
       "sha": "4c31df8f4b5955de45ab719776dd07b249b9dbad76c4f37da6311de25a348b84"
      }
     ]
    },
    {
     "n": "103",
     "on": "read",
     "of": "mame",
     "vs": "extra",
     "text": "With no input handler and no pushed value, MAME reads 0x00 on the input pins, and logs an error once if any pin is an input.",
     "quotes": [
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "264-275",
       "sha": "4dc096071cb6d0c4e4c59d53108c485a777c2a55d275eb1f2267d5720772589d"
      },
      {
       "ref": "mame:src/devices/machine/6821pia.cpp",
       "lines": "276-285",
       "sha": "de9839f9fd79ec8c7406a0852419ace040438cc92b4c18abeb05c6bd9134b3fe"
      }
     ]
    }
   ],
