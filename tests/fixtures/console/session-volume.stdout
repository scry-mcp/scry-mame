BLOCK kind=%s tag=%s size=%d bytewidth=%d endian=%s \"\n                        .. \"start=%s offset=%d hex=%s\", kind, tag, blk.size, blk.bytewidth,\n                        tostring(blk.endianness), start and string.format(\"%x\", start) or \"-\",\n                        offset, table.concat(t)))\n  end\nend\n", "=mcp") if f == nil then print("MAME_MCP_LUA_END#63", false, e) else local ok, err = pcall(f) print("MAME_MCP_LUA_END#63", ok, err) end
