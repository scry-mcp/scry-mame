<?xml version="1.0"?>
<!DOCTYPE target SYSTEM "gdb-target.dtd">
<target version="1.0">
<architecture>m68k</architecture>
  <feature name="org.gnu.gdb.m68k.core">
    <reg name="d0" bitsize="32" type="int"/>
    <reg name="d1" bitsize="32" type="int"/>
    <reg name="d2" bitsize="32" type="int"/>
    <reg name="d3" bitsize="32" type="int"/>
    <reg name="d4" bitsize="32" type="int"/>
    <reg name="d5" bitsize="32" type="int"/>
    <reg name="d6" bitsize="32" type="int"/>
    <reg name="d7" bitsize="32" type="int"/>
    <reg name="a0" bitsize="32" type="int"/>
    <reg name="a1" bitsize="32" type="int"/>
    <reg name="a2" bitsize="32" type="int"/>
    <reg name="a3" bitsize="32" type="int"/>
    <reg name="a4" bitsize="32" type="int"/>
    <reg name="a5" bitsize="32" type="int"/>
    <reg name="fp" bitsize="32" type="int"/>
    <reg name="sp" bitsize="32" type="int"/>
    <reg name="ps" bitsize="16" type="int"/>
    <reg name="pc" bitsize="32" type="code_ptr"/>
  </feature>
  <feature name="mame./subcpu">
    <reg name="CURPC" bitsize="32" type="int" group="/subcpu"/>
    <reg name="PC" bitsize="32" type="int" group="/subcpu"/>
    <reg name="IR" bitsize="16" type="int" group="/subcpu"/>
    <reg name="SR" bitsize="16" type="int" group="/subcpu"/>
    <reg name="D0" bitsize="32" type="int" group="/subcpu"/>
    <reg name="D1" bitsize="32" type="int" group="/subcpu"/>
    <reg name="D2" bitsize="32" type="int" group="/subcpu"/>
    <reg name="D3" bitsize="32" type="int" group="/subcpu"/>
    <reg name="D4" bitsize="32" type="int" group="/subcpu"/>
    <reg name="D5" bitsize="32" type="int" group="/subcpu"/>
    <reg name="D6" bitsize="32" type="int" group="/subcpu"/>
    <reg name="D7" bitsize="32" type="int" group="/subcpu"/>
    <reg name="A0" bitsize="32" type="int" group="/subcpu"/>
    <reg name="A1" bitsize="32" type="int" group="/subcpu"/>
    <reg name="A2" bitsize="32" type="int" group="/subcpu"/>
    <reg name="A3" bitsize="32" type="int" group="/subcpu"/>
    <reg name="A4" bitsize="32" type="int" group="/subcpu"/>
    <reg name="A5" bitsize="32" type="int" group="/subcpu"/>
    <reg name="A6" bitsize="32" type="int" group="/subcpu"/>
    <reg name="USP" bitsize="32" type="int" group="/subcpu"/>
    <reg name="SP" bitsize="32" type="int" group="/subcpu"/>
  </feature>
</target>
